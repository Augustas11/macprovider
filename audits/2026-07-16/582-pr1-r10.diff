index 00000000..c273bb09
--- /dev/null
+++ b/phase4-coordinator/internal/ws/trust_revalidation.go
@@ -0,0 +1,108 @@
+package ws
+
+import (
+	"context"
+	"time"
+)
+
+// trustRevalidationInterval bounds the staleness of active-session hardware-trust
+// enforcement (issue #582 FIX A). Admission (LatestVerified) and the
+// registration-time re-check (FIX B) close the connect/register races, but a
+// trust root that is revoked or lapses past expires_at MID-SESSION leaves an
+// already-established session serving until it happens to reconnect. This loop
+// re-checks live trust for every active provider session on each tick and evicts
+// any whose trust root is no longer active, so the worst-case window between a
+// trust root going inactive and the session being dropped is bounded by this
+// interval. 30s aligns with the canary sweep's 30s ceiling and keeps the
+// bounded-staleness guarantee tight without materially loading the pool
+// (one EXISTS read per active provider per tick).
+const trustRevalidationInterval = 30 * time.Second
+
+// trustRevalidationSweepDeadlineCap bounds how long a single batched sweep read
+// may run regardless of the tick interval. The sweep issues ONE DB round-trip
+// per tick under a sweep-wide deadline of min(trustRevalidationInterval, this
+// cap); a stalled read fails the whole tick OPEN (skip, no evictions) well
+// before the next tick fires, so a slow database can never wedge the loop.
+const trustRevalidationSweepDeadlineCap = 20 * time.Second
+
+// trustRegistrationRecheckTimeout bounds the advisory-locked registration-time
+// hardware-trust re-check (issue #582 FIX 2/FIX 3). It caps the whole re-check
+// tx — including the advisory-lock acquire, which SET LOCAL lock_timeout also
+// caps at 2s inside the store — so a revoke/approve transaction holding the
+// provider's advisory lock can never hang registration. On timeout the re-check
+// fails OPEN (registration proceeds; the bounded sweep is the backstop). Kept
+// slightly above the store's 2s lock_timeout so the lock acquire fails with a
+// clean DB error before this outer deadline fires.
+const trustRegistrationRecheckTimeout = 3 * time.Second
+
+// runTrustRevalidationLoop is the periodic goroutine backing issue #582 FIX A.
+// It is started only when the hardware-trust checker is wired (i.e. the
+// admission trust join is enabled). Modeled on runSELivenessLoop / runCanaryLoop.
+func (s *Server) runTrustRevalidationLoop() {
+	ticker := time.NewTicker(trustRevalidationInterval)
+	defer ticker.Stop()
+	for range ticker.C {
+		s.runTrustRevalidationSweep()
+	}
+}
+
+// runTrustRevalidationSweep re-checks live hardware trust for every active
+// provider session in ONE batched DB round-trip and evicts any whose trust root
+// is no longer active (issue #582 FIX A / FIX 1). It snapshots the active
+// sessions, collects their distinct provider_ids, classifies the whole set with
+// a single ProvidersWithoutActiveTrust read under a sweep-wide deadline, then
+// evicts exactly the returned untrusted subset. Batching replaces the earlier
+// serial per-provider loop, whose last check at ~100 providers with slow reads
+// ran tens of seconds behind and let one stalled read delay later evictions.
+//
+// Fail-open: on a transient DB error the whole tick is logged and SKIPPED — a
+// query blip must never mass-evict the pool. Sessions are evicted ONLY for
+// providers the batch definitively reports as having no active trust root.
+func (s *Server) runTrustRevalidationSweep() {
+	if s.providerTrust == nil {
+		return
+	}
+	// Snapshot active sessions → distinct provider_ids. Only providers with a
+	// live session can be serving; skip the rest so a disconnected-but-still-
+	// tracked entry costs no DB read.
+	var providerIDs []string
+	seen := make(map[string]struct{})
+	for _, provider := range s.pool.Snapshot() {
+		if _, ok := s.sessionFor(provider.ProviderID, provider.AssignedID); !ok {
+			continue
+		}
+		if _, dup := seen[provider.ProviderID]; dup {
+			continue
+		}
+		seen[provider.ProviderID] = struct{}{}
+		providerIDs = append(providerIDs, provider.ProviderID)
+	}
+	if len(providerIDs) == 0 {
+		return
+	}
+	// Single batched read under one sweep-wide deadline.
+	deadline := trustRevalidationInterval
+	if deadline > trustRevalidationSweepDeadlineCap {
+		deadline = trustRevalidationSweepDeadlineCap
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), deadline)
+	untrusted, err := s.providerTrust.ProvidersWithoutActiveTrust(ctx, providerIDs)
+	cancel()
+	if err != nil {
+		// Fail open: skip this tick entirely; the next sweep retries.
+		s.log.Warn().
+			Err(err).
+			Int("active_providers", len(providerIDs)).
+			Msg("hardware trust revalidation batch check failed; skipping evictions this tick")
+		return
+	}
+	for _, providerID := range untrusted {
+		s.log.Warn().
+			Str("event", "hardware_trust_session_revalidation_evict").
+			Str("provider_id", providerID).
+			Str("reason", "no_active_trust_root").
+			Msg("evicting active provider session: hardware trust root no longer active")
+		// Reuse the existing drain → mark-draining → CloseBanned eviction path.
+		s.disconnectProviderForTrustRevocation(providerID, "trust_revalidation")
+	}
+}
diff --git a/phase4-coordinator/internal/ws/trust_revalidation_test.go b/phase4-coordinator/internal/ws/trust_revalidation_test.go
new file mode 100644
index 00000000..2cb0461d
--- /dev/null
+++ b/phase4-coordinator/internal/ws/trust_revalidation_test.go
@@ -0,0 +1,164 @@
+package ws
+
+import (
+	"context"
+	"errors"
+	"net"
+	"testing"
+
+	"github.com/augstar/macprovider-coordinator/internal/config"
+	"github.com/augstar/macprovider-coordinator/internal/pool"
+	"github.com/rs/zerolog"
+)
+
+// stubTrustChecker records the provider_ids passed to the batched sweep read and
+// returns a configured untrusted subset (or an error). untrusted, when set,
+// echoes only the provider_ids present in both it and the sweep's input, so a
+// test can assert "these specific providers were reported untrusted".
+type stubTrustChecker struct {
+	untrusted map[string]struct{}
+	err       error
+	calls     int
+	gotIDs    []string
+	// active backs ProviderTrustActiveLocked (registration re-check), unused by
+	// the sweep tests.
+	active bool
+}
+
+func (s *stubTrustChecker) ProvidersWithoutActiveTrust(_ context.Context, providerIDs []string) ([]string, error) {
+	s.calls++
+	s.gotIDs = append([]string(nil), providerIDs...)
+	if s.err != nil {
+		return nil, s.err
+	}
+	var out []string
+	for _, id := range providerIDs {
+		if _, bad := s.untrusted[id]; bad {
+			out = append(out, id)
+		}
+	}
+	return out, nil
+}
+
+func (s *stubTrustChecker) ProviderTrustActiveLocked(context.Context, string) (bool, error) {
+	return s.active, s.err
+}
+
+// TestTrustRevalidationSweepEvictsInactiveTrust asserts the batched bounded sweep
+// (issue #582 FIX A / FIX 1) drains an active session whose hardware trust root
+// is no longer active (revoked or expired), keeps a session whose trust is still
+// active, and fails OPEN (no eviction) on a transient DB error — all in a single
+// batched read per tick.
+func TestTrustRevalidationSweepEvictsInactiveTrust(t *testing.T) {
+	tests := []struct {
+		name        string
+		untrustsAll bool
+		err         error
+		wantDrained bool
+	}{
+		{name: "inactive trust evicts", untrustsAll: true, wantDrained: true},
+		{name: "active trust keeps session", untrustsAll: false, wantDrained: false},
+		{name: "db error fails open", err: errors.New("db blip"), wantDrained: false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s, provider, _ := newEncryptedRelayHarness(t)
+			checker := &stubTrustChecker{err: tc.err}
+			if tc.untrustsAll {
+				checker.untrusted = map[string]struct{}{provider.ProviderID: {}}
+			}
+			s.providerTrust = checker
+
+			s.runTrustRevalidationSweep()
+
+			if checker.calls != 1 {
+				t.Fatalf("ProvidersWithoutActiveTrust calls = %d, want 1 (single batched read)", checker.calls)
+			}
+			if len(checker.gotIDs) != 1 || checker.gotIDs[0] != provider.ProviderID {
+				t.Fatalf("batched read provider_ids = %v, want [%s]", checker.gotIDs, provider.ProviderID)
+			}
+			resolved, ok := s.pool.Resolve(provider.ProviderID, provider.AssignedID)
+			if !ok {
+				t.Fatal("provider missing from pool after sweep")
+			}
+			drained := resolved.State == pool.StateDraining
+			if drained != tc.wantDrained {
+				t.Fatalf("provider state = %q, wantDrained = %v", resolved.State, tc.wantDrained)
+			}
+		})
+	}
+}
+
+// TestTrustRevalidationSweepSkipsSessionlessProviders confirms a provider with
+// no live session is never sent to the batched trust read (avoids needless DB
+// work on stale pool entries), and with no active sessions the sweep issues no
+// read at all.
+func TestTrustRevalidationSweepSkipsSessionlessProviders(t *testing.T) {
+	s, provider, _ := newEncryptedRelayHarness(t)
+	s.sessions.Delete(sessionKey(provider.ProviderID, provider.AssignedID))
+	checker := &stubTrustChecker{untrusted: map[string]struct{}{provider.ProviderID: {}}}
+	s.providerTrust = checker
+
+	s.runTrustRevalidationSweep()
+
+	if checker.calls != 0 {
+		t.Fatalf("ProvidersWithoutActiveTrust calls = %d, want 0 (no live session)", checker.calls)
+	}
+}
+
+// TestRegisterProviderSessionCentralizedTrustRecheck exercises the centralized
+// registration-time hardware-trust re-check (issue #582 FIX 2/FIX 3) that now
+// lives inside registerProviderSession, so BOTH the V1 and V2 admission paths
+// share it. An inactive trust root refuses registration with
+// RegisterRefusalHardwareTrustInactive (no session); a lock-timeout/DB error
+// fails OPEN (session registered, relying on the bounded sweep as backstop).
+func TestRegisterProviderSessionCentralizedTrustRecheck(t *testing.T) {
+	newEntry := func() *pool.Provider {
+		return &pool.Provider{
+			ProviderID:     "p1",
+			AssignedID:     "s1",
+			ModelID:        "model-a",
+			Tier:           pool.TierProvisional,
+			InferencePath:  pool.InferencePathWSTunneled,
+			State:          pool.StateReady,
+			SlotsFree:      1,
+			SlotsTotal:     1,
+			MaxConcurrency: 1,
+		}
+	}
+
+	t.Run("inactive trust refuses registration", func(t *testing.T) {
+		serverConn, providerConn := net.Pipe()
+		defer providerConn.Close()
+		defer serverConn.Close()
+
+		s := NewServer(config.Default(), pool.NewRegistry(nil), zerolog.Nop())
+		s.providerTrust = &stubTrustChecker{active: false}
+
+		session, refusal := s.registerProviderSession(serverConn, newEntry())
+		if session != nil {
+			session.close()
+			t.Fatal("registration admitted despite inactive hardware trust root")
+		}
+		if refusal != pool.RegisterRefusalHardwareTrustInactive {
+			t.Fatalf("refusal = %q, want %q", refusal, pool.RegisterRefusalHardwareTrustInactive)
+		}
+	})
+
+	t.Run("recheck error fails open", func(t *testing.T) {
+		serverConn, providerConn := net.Pipe()
+		defer providerConn.Close()
+		defer serverConn.Close()
+
+		s := NewServer(config.Default(), pool.NewRegistry(nil), zerolog.Nop())
+		// active=false but err set: the fail-open branch must win, so a lock
+		// timeout / DB blip never blocks registration.
+		s.providerTrust = &stubTrustChecker{active: false, err: errors.New("lock timeout")}
+
+		session, refusal := s.registerProviderSession(serverConn, newEntry())
+		if session == nil {
+			t.Fatalf("registration refused on re-check error (refusal=%q); want fail-open admit", refusal)
+		}
+		session.close()
+	})
+}
