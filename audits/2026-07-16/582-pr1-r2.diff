+func TestHardwareTrustApproveRequestCreatesPendingRow(t *testing.T) {
+	now := time.Date(2026, 7, 16, 12, 0, 0, 0, time.UTC)
+	store := &fakeHardwareTrustAdminStore{
+		requestProvID: "mac",
+		requestHash:   "hash-abc",
