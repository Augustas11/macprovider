+func (s *PGStore) ApproveHardwareTrustApproval(ctx context.Context, pendingID, approvedBy string) (providerID, hardwareIdentityHash, chipNormalized string, unifiedMemoryGB int, expiresAt *time.Time, reason, incidentID string, err error) {
+	if s == nil || s.hardwareTrustApproveDB == nil {
+		err = errors.New("hardware trust approve postgres store is nil")
+		return
+	}
+	var requestedUntil sql.NullTime
+	var incident sql.NullString
+	err = s.hardwareTrustApproveDB.QueryRowContext(ctx, `
+SELECT provider_id, hardware_identity_hash, chip_normalized, unified_memory_gb, requested_until, reason, incident_id
+  FROM approve_hardware_trust_approval($1::uuid, $2)`,
+		pendingID, approvedBy,
