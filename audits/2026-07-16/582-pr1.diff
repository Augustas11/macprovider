+// WaitingTrustJob is a hardware-verification job parked in status
+// waiting_trust, awaiting an operator trust approval (issue #582).
+type WaitingTrustJob struct {
+	JobID                int64
+	ProviderID           string
+	Chip                 string
+	ChipNormalized       string
+	UnifiedMemoryGB      int
+	HardwareIdentityHash string
+	DecisionReason       string
+	SubmittedAt          time.Time
+}
+
+func (s *PGStore) RequestHardwareTrustApproval(ctx context.Context, pendingID, providerID, hardwareIdentityHash, chipNormalized string, unifiedMemoryGB int, requestedBy string, expiresAt *time.Time, reason, incidentID string) error {
+	if s == nil || s.hardwareTrustRequestDB == nil {
+		return errors.New("hardware trust request postgres store is nil")
+	}
+	var expires interface{}
+	if expiresAt != nil {
+		expires = expiresAt.UTC()
+	}
+	var out string
+	err := s.hardwareTrustRequestDB.QueryRowContext(ctx, `
+SELECT request_hardware_trust_approval($1::uuid, $2, $3, $4, $5, $6, $7, $8, NULLIF($9, ''))::text`,
+		pendingID, providerID, hardwareIdentityHash, chipNormalized, unifiedMemoryGB, requestedBy, expires, reason, incidentID,
+	).Scan(&out)
+	if err != nil {
+		return err
+	}
+	if out != pendingID {
+		return fmt.Errorf("hardware_trust request returned pending_id %q, want %q", out, pendingID)
+	}
+	return nil
+}
+
+func (s *PGStore) ApproveHardwareTrustApproval(ctx context.Context, pendingID, approvedBy string) (providerID, hardwareIdentityHash, chipNormalized string, unifiedMemoryGB int, expiresAt *time.Time, reason, incidentID string, err error) {
+	if s == nil || s.hardwareTrustApproveDB == nil {
+		err = errors.New("hardware trust approve postgres store is nil")
+		return
+	}
+	var requestedUntil sql.NullTime
+	var incident sql.NullString
+	err = s.hardwareTrustApproveDB.QueryRowContext(ctx, `
+SELECT provider_id, hardware_identity_hash, chip_normalized, unified_memory_gb, requested_until, reason, incident_id
+  FROM approve_hardware_trust_approval($1::uuid, $2)`,
+		pendingID, approvedBy,
+	).Scan(&providerID, &hardwareIdentityHash, &chipNormalized, &unifiedMemoryGB, &requestedUntil, &reason, &incident)
+	if err != nil {
+		return
+	}
+	if requestedUntil.Valid {
+		until := requestedUntil.Time.UTC()
+		expiresAt = &until
+	}
+	if incident.Valid {
+		incidentID = incident.String
+	}
+	return
+}
+
+func (s *PGStore) ListWaitingTrustJobs(ctx context.Context) ([]WaitingTrustJob, error) {
+	if s == nil || s.db == nil {
+		return nil, errors.New("onboarding postgres store is nil")
+	}
+	rows, err := s.db.QueryContext(ctx, `
+SELECT id, provider_id, chip, chip_normalized, unified_memory_gb,
+       COALESCE(evidence #>> '{hardware,hardware_identity_hash}', ''), decision_reason, submitted_at
+  FROM hardware_verification_jobs
+ WHERE status = 'waiting_trust'
+ ORDER BY submitted_at ASC, id ASC`)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var jobs []WaitingTrustJob
+	for rows.Next() {
+		var job WaitingTrustJob
+		if err := rows.Scan(
+			&job.JobID,
+			&job.ProviderID,
+			&job.Chip,
+			&job.ChipNormalized,
+			&job.UnifiedMemoryGB,
+			&job.HardwareIdentityHash,
+			&job.DecisionReason,
+			&job.SubmittedAt,
+		); err != nil {
+			return nil, err
+		}
+		job.SubmittedAt = job.SubmittedAt.UTC()
+		jobs = append(jobs, job)
+	}
+	return jobs, rows.Err()
+}
