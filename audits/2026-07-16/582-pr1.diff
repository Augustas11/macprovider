+REVOKE ALL ON FUNCTION approve_hardware_trust_approval(UUID, TEXT) FROM PUBLIC;
+REVOKE ALL ON FUNCTION request_hardware_trust_approval(UUID, TEXT, TEXT, TEXT, INT, TEXT, TIMESTAMPTZ, TEXT, TEXT) FROM PUBLIC;
