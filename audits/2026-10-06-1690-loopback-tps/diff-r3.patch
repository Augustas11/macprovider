+final class LoopbackCancelAction: @unchecked Sendable {
+    private let lock = NSLock()
+    private var action: (() -> Void)?
+    private var fired = false
+
+    func install(_ action: @escaping () -> Void) {
+        lock.lock()
+        guard !fired else {
+            lock.unlock()
+            action()
+            return
+        }
+        self.action = action
+        lock.unlock()
+    }
