diff -ruN cmpbase/Sources/macprovider-cli/LabProf.swift prof-phase3/Sources/macprovider-cli/LabProf.swift
--- Sources/macprovider-cli/LabProf.swift	1970-01-01 08:00:00
+++ Sources/macprovider-cli/LabProf.swift
@@ -0,0 +1,41 @@
+import Foundation
+
+/// Lab-only phase timer (never committed). MACPROVIDER_LAB_PROF=1 enables it.
+enum LabProf {
+    static let enabled = ProcessInfo.processInfo.environment["MACPROVIDER_LAB_PROF"] == "1"
+    nonisolated(unsafe) static var sums: [String: (Double, Int)] = [:]
+    nonisolated(unsafe) static var lastReport = Date()
+    static let lock = NSLock()
+    @inline(__always) static func now() -> UInt64 { DispatchTime.now().uptimeNanoseconds }
+    nonisolated(unsafe) static var lastRound: UInt64 = 0
+    static func round(_ t: UInt64) {
+        guard enabled else { return }
+        let prev = lastRound; lastRound = t
+        if prev != 0, t &- prev < 200_000_000 { add("r0.round.interval", prev, t) }
+    }
+    static func event(_ key: String, _ start: UInt64, _ end: UInt64 = now()) {
+        guard enabled else { return }
+        let ms = Double(end &- start) / 1e6
+        let t = Double(end) / 1e9
+        FileHandle.standardError.write(("[labev] t=\(String(format: "%.3f", t)) \(key)=\(String(format: "%.3f", ms))ms\n").data(using: .utf8)!)
+    }
+    static func timed<T>(_ key: String, _ body: () async throws -> T) async rethrows -> T {
+        let s = now(); defer { event(key, s) }
+        return try await body()
+    }
+    static func add(_ key: String, _ start: UInt64, _ end: UInt64 = now()) {
+        guard enabled else { return }
+        lock.lock(); defer { lock.unlock() }
+        let ms = Double(end &- start) / 1e6
+        let cur = sums[key] ?? (0, 0)
+        sums[key] = (cur.0 + ms, cur.1 + 1)
+        if Date().timeIntervalSince(lastReport) > 20 {
+            lastReport = Date()
+            let line = sums.keys.sorted().map { k in
+                let v = sums[k]!; return "\(k)=\(String(format: "%.3f", v.0 / Double(v.1)))ms/n\(v.1)"
+            }.joined(separator: " ")
+            FileHandle.standardError.write(("[labprof] " + line + "\n").data(using: .utf8)!)
+            sums = [:]
+        }
+    }
+}
