    def release_identity(self, release: Release) -> RuntimeIdentity:
        advertised_version = release.provider_advertised_version
        if release.catalog is None and self.config_update is not None:
            advertised_version = self.config_update.next_version
        return RuntimeIdentity(release.tag, release.tag, advertised_version)

    def local_coordinator_ready(self, release: Release, require_pool: bool) -> bool:
        return self.local_coordinator_identity_ready(self.release_identity(release), require_pool)

    def local_gateway_ready(self, release: Release) -> bool:
        return self.local_gateway_identity_ready(self.release_identity(release))

    def assert_effective_tier2_catalog_path(
        self,
        expected_require_hash_verified: str | None = None,
    ) -> None:
        expected = str(self._current_tier2_catalog_path())
        actual = self.effective_coordinator_scalar("tier2", "catalog_path")
        if actual != expected:
            raise UpdateError("effective tier2.catalog_path is not the release-bound current catalog path")
        actual_enforcement = self.effective_coordinator_scalar("tier2", "require_hash_verified")
        if actual_enforcement not in ("false", "true"):
            raise UpdateError("effective tier2.require_hash_verified must be explicitly false or true")
        if (
            expected_require_hash_verified is not None
            and actual_enforcement != expected_require_hash_verified
        ):
            raise UpdateError(
                "effective tier2.require_hash_verified must be "
                f"{expected_require_hash_verified}"
            )
        if expected_require_hash_verified == "true":
            runtime = self.coordinator_runtime_state or self.coordinator_runtime()
            if (
                self.effective_coordinator_scalar("tier2", "model_hash_legacy_until")
                is not None
                or "MODEL_HASH_LEGACY_UNTIL" in runtime.environment
            ):
                raise UpdateError(
                    "hash-enforced proof refuses the model hash algorithm legacy bridge"
                )

    def _service_properties(self, unit: str, properties: tuple[str, ...]) -> dict[str, str]:
        result = self.run_command(
            ["systemctl", "show", *(f"--property={name}" for name in properties), unit],
            check=False,
            timeout=10,
        )
        parsed: dict[str, str] = {}
        for line in result.stdout.splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                parsed[key] = value
        if result.returncode != 0:
            raise UpdateError(f"could not inspect {unit} runtime properties")
        return parsed

    def _prove_live_service_binary(
        self,
        unit: str,
        binary: Path,
        expected_sha256: str,
        expected_version: str,
        min_start_after_wall_ns: int | None,
    ) -> dict[str, object]:
        min_start_after_monotonic_us: int | None = None
        if min_start_after_wall_ns is not None:
            wall_now_ns = time.time_ns()
            monotonic_now_ns = time.monotonic_ns()
            min_start_after_monotonic_us = max(
                0,
                (min_start_after_wall_ns - wall_now_ns + monotonic_now_ns + 999) // 1000,
            )
        properties = self._service_properties(
            unit,
            ("MainPID", "ExecMainStartTimestampMonotonic"),
        )
        try:
            pid = int(properties.get("MainPID", "0"))
        except ValueError as exc:
            raise UpdateError(f"{unit} MainPID is invalid") from exc
        if pid <= 0:
            raise UpdateError(f"{unit} has no live main process")
        try:
            proc_started_monotonic_us = int(properties.get("ExecMainStartTimestampMonotonic", "0"))
        except ValueError as exc:
            raise UpdateError(f"{unit} ExecMainStartTimestampMonotonic is invalid") from exc
        if proc_started_monotonic_us <= 0:
            raise UpdateError(f"{unit} has no valid monotonic start timestamp")
        if (
            min_start_after_monotonic_us is not None
            and proc_started_monotonic_us <= min_start_after_monotonic_us
        ):
            raise UpdateError(f"{unit} did not start after effective config/catalog publication")
        proc_exe = Path("/proc") / str(pid) / "exe"
        installed = self._trusted_regular_file(binary, f"installed {binary.name} binary")
        try:
            live = proc_exe.stat()
        except OSError as exc:
            raise UpdateError(f"cannot inspect live {unit} executable") from exc
        if (live.st_dev, live.st_ino) != (installed.st_dev, installed.st_ino):
            raise UpdateError(f"live {unit} executable inode does not match installed signed binary")
        if sha256_file(proc_exe) != expected_sha256:
            raise UpdateError(f"live {unit} executable hash does not match signed release")
        result = self.run_command([str(binary), "--version"], check=False, timeout=10)
        if result.returncode != 0 or result.stdout.strip() != expected_version:
            raise UpdateError(f"installed {binary.name} version does not match signed release")
        return {
            "unit": unit,
            "pid": pid,
            "inode": live.st_ino,
            "sha256": expected_sha256,
            "version": expected_version,
            "process_started_monotonic_us": proc_started_monotonic_us,
        }

    def verify_live_runtime_binding(
        self,
        release: Release,
        expected_require_hash_verified: str | None = None,
    ) -> None:
        if release.catalog is not None:
            self.assert_effective_tier2_catalog_path(expected_require_hash_verified)
        identity = self.release_identity(release)
        if not self.local_coordinator_identity_ready(identity, False):
            raise UpdateError("live coordinator version does not match signed release")
        if not self.local_gateway_identity_ready(identity):
            raise UpdateError("live gateway version does not match signed release")
        runtime = self.coordinator_runtime()
        gateway_config = self.gateway_config_path()
        effective_config_paths = [runtime.base_config]
        if runtime.overlay_config is not None:
            effective_config_paths.append(runtime.overlay_config)
        publication_paths = [
            *effective_config_paths,
            gateway_config,
        ]
        if release.catalog is not None:
            publication_paths.append(self.install_root / "autotune" / "current")
        try:
            min_start_after_ns = max(path.lstat().st_mtime_ns for path in publication_paths)
        except OSError as exc:
            raise UpdateError("cannot inspect effective config/catalog publication time") from exc
        coordinator = self._prove_live_service_binary(
            "macprovider-coordinator.service",
            self.install_root / "coordinator",
            release.coordinator.sha256,
            release.tag,
            min_start_after_ns,
        )
        gateway = self._prove_live_service_binary(
            "macprovider-gateway.service",
            self.install_root / "gateway",
            release.gateway.sha256,
            release.tag,
            min_start_after_ns,
        )
        audit_fields: dict[str, object] = {
            "coordinator_pid": coordinator["pid"],
            "gateway_pid": gateway["pid"],
            "coordinator_inode": coordinator["inode"],
            "gateway_inode": gateway["inode"],
            "release_lane": release.release_lane,
        }
        if release.catalog is not None:
            audit_fields.update(
                {
                    "tier2_catalog_path": str(self._current_tier2_catalog_path()),
                    "tier2_catalog_sha256": release.catalog.files["tier2-catalog.json"],
                }
            )
        self.audit(
            "live_runtime_binding",
            "success",
            **audit_fields,
        )

