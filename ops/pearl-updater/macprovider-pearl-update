def _trusted_file_stat(
    path: Path,
    description: str,
    *,
    trusted_uid: int,
    private: bool = False,
) -> os.stat_result:
    try:
        file_stat = path.lstat()
    except OSError as exc:
        raise UpdateError(f"cannot inspect {description} {path}: {exc}") from exc
    if not stat.S_ISREG(file_stat.st_mode):
        raise UpdateError(f"{description} is not a regular file: {path}")
    if file_stat.st_uid != trusted_uid:
        raise UpdateError(
            f"{description} owner uid is {file_stat.st_uid}, expected {trusted_uid}: {path}"
        )
    if file_stat.st_nlink != 1:
        raise UpdateError(f"{description} must have exactly one link: {path}")
    if stat.S_IMODE(file_stat.st_mode) & 0o022:
        raise UpdateError(f"{description} must not be writable by group or other: {path}")
    if private and stat.S_IMODE(file_stat.st_mode) & 0o077:
        raise UpdateError(f"{description} must not be accessible by group or other: {path}")
    return file_stat


def _trusted_directory(
    path: Path,
    description: str,
    *,
    trusted_uid: int,
    mode: int | None = 0o700,
) -> None:
    try:
        directory_stat = path.lstat()
    except OSError as exc:
        raise UpdateError(f"cannot inspect {description} {path}: {exc}") from exc
    if not stat.S_ISDIR(directory_stat.st_mode):
        raise UpdateError(f"{description} is not a directory: {path}")
    if directory_stat.st_uid != trusted_uid:
        raise UpdateError(
            f"{description} owner uid is {directory_stat.st_uid}, expected {trusted_uid}: {path}"
        )
    actual_mode = stat.S_IMODE(directory_stat.st_mode)
    if mode is not None and actual_mode != mode:
        raise UpdateError(f"{description} mode must be {mode:04o}: {path}")
    if mode is None and actual_mode & 0o022:
        raise UpdateError(f"{description} must not be writable by group or other: {path}")


def _open_trusted_read(
    path: Path,
    description: str,
    *,
    trusted_uid: int,
    private: bool = False,
) -> Any:
    before = _trusted_file_stat(path, description, trusted_uid=trusted_uid, private=private)
    if not hasattr(os, "O_NOFOLLOW"):
        raise UpdateError("this platform cannot safely open trusted updater inputs")
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise UpdateError(f"cannot open {description} {path}: {exc}") from exc
    try:
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
            raise UpdateError(f"{description} changed while opening: {path}")
        if not stat.S_ISREG(after.st_mode) or after.st_nlink != 1:
            raise UpdateError(f"{description} changed to an unsafe file: {path}")
        return os.fdopen(descriptor, "r", encoding="utf-8")
    except Exception:
        os.close(descriptor)
        raise


def _read_trusted_text(
    path: Path,
    description: str,
    *,
    trusted_uid: int,
    private: bool = False,
    limit: int = 1024 * 1024,
) -> str:
    with _open_trusted_read(
        path,
        description,
        trusted_uid=trusted_uid,
        private=private,
    ) as handle:
        payload = handle.read(limit + 1)
    if len(payload) > limit:
        raise UpdateError(f"{description} exceeds the updater safety limit: {path}")
    return payload


def _path_entry_exists(path: Path) -> bool:
    try:
        path.lstat()
        return True
    except FileNotFoundError:
        return False
    except OSError as exc:
        raise UpdateError(f"cannot inspect path {path}: {exc}") from exc


def _fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _secure_atomic_write(
    path: Path,
    payload: bytes,
    *,
    mode: int = 0o600,
    uid: int | None = None,
    gid: int | None = None,
) -> None:
    if not path.parent.is_dir():
        raise UpdateError(f"secure write parent directory is unavailable: {path.parent}")
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}-{time.time_ns()}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    if not hasattr(os, "O_NOFOLLOW"):
        raise UpdateError("this platform cannot safely create updater state")
    descriptor = os.open(temporary, flags | os.O_NOFOLLOW, mode)
    try:
        with os.fdopen(descriptor, "wb", closefd=False) as handle:
            handle.write(payload)
            handle.flush()
            if uid is not None or gid is not None:
                os.fchown(descriptor, -1 if uid is None else uid, -1 if gid is None else gid)
            os.fchmod(descriptor, mode)
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        _fsync_directory(path.parent)
    finally:
        os.close(descriptor)
        temporary.unlink(missing_ok=True)


def bool_value(value: str, key: str) -> bool:
    if value == "1":
        return True
    if value == "0":
        return False
    raise UpdateError(f"{key} must be 0 or 1")


def bounded_int(value: str, key: str, minimum: int, maximum: int) -> int:
    if not value.isascii() or not value.isdigit():
        raise UpdateError(f"{key} must be an integer")
    parsed = int(value)
    if parsed < minimum or parsed > maximum:
        raise UpdateError(f"{key} must be between {minimum} and {maximum}")
    return parsed


def load_config(path: Path, *, trusted_uid: int | None = None) -> Config:
    values: dict[str, str] = {}
    if _path_entry_exists(path):
        if trusted_uid is None:
            text = path.read_text(encoding="utf-8")
        else:
            text = _read_trusted_text(
                path,
                "updater configuration",
                trusted_uid=trusted_uid,
                private=True,
            )
        for number, raw in enumerate(text.splitlines(), 1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                raise UpdateError(f"{path}:{number}: expected KEY=VALUE")
            key, value = line.split("=", 1)
            key, value = key.strip(), value.strip()
            if not re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
                raise UpdateError(f"{path}:{number}: invalid key")
            if key in values:
                raise UpdateError(f"{path}:{number}: duplicate key {key}")
            values[key] = value
    known = {
        "PEARL_UPDATER_ENABLED",
        "PEARL_UPDATER_MINIMUM_VERSION",
        "PEARL_UPDATER_ALLOW_PROVIDER_DRAIN",
        "PEARL_UPDATER_DOWNLOAD_ATTEMPTS",
        "PEARL_UPDATER_RETRY_BACKOFF_S",
        "PEARL_UPDATER_REQUEST_TIMEOUT_S",
        "PEARL_UPDATER_DOWNLOAD_TIMEOUT_S",
        "PEARL_UPDATER_GATEWAY_DRAIN_TIMEOUT_S",
        "PEARL_UPDATER_GATEWAY_DRAIN_STEADY_S",
        "PEARL_UPDATER_PROVIDER_RECOVERY_TIMEOUT_S",
        "PEARL_UPDATER_SERVICE_HEALTH_TIMEOUT_S",
        "PEARL_UPDATER_CANARY_TIMEOUT_S",
        "PEARL_UPDATER_REVOKED_VERSIONS_FILE",
        "PEARL_UPDATER_DEADMAN_HEARTBEAT_ID",
        "PEARL_UPDATER_DEADMAN_API_TOKEN_FILE",
        "PEARL_UPDATER_CATALOG_CANARY_PROVIDER_ID",
        "PEARL_UPDATER_CATALOG_CANARY_AUTH_TOKEN_FILE",
        "PEARL_UPDATER_CATALOG_CANARY_SSH_TARGET",
        "PEARL_UPDATER_CATALOG_CANARY_SSH_KEY_FILE",
        "PEARL_UPDATER_CATALOG_CANARY_KNOWN_HOSTS_FILE",
        "PEARL_UPDATER_CATALOG_CANARY_INSTALL_DIR",
        "PEARL_UPDATER_PROVIDER_ADMISSION_POLICY",
        "PEARL_UPDATER_MINIMUM_POOL_READY_AFTER_ROLLOUT",
        "PEARL_UPDATER_MINIMUM_BRIDGE_REMAINING_S",
    }
    unknown = sorted(set(values) - known)
    if unknown:
        raise UpdateError(f"unknown updater configuration key: {unknown[0]}")
    return Config(
        enabled=bool_value(values.get("PEARL_UPDATER_ENABLED", "0"), "PEARL_UPDATER_ENABLED"),
        minimum_version=SemVer.parse(values.get("PEARL_UPDATER_MINIMUM_VERSION", "1.8.26")),
