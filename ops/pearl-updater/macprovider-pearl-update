def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def parse_checksums(path: Path) -> dict[str, str]:
    result: dict[str, str] = {}
    for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        fields = raw.split()
        if len(fields) != 2 or not SHA256_RE.fullmatch(fields[0]) or not ASSET_RE.fullmatch(fields[1]):
            raise UpdateError(f"checksums.txt:{number}: invalid entry")
        if fields[1] in result:
            raise UpdateError(f"checksums.txt:{number}: duplicate asset {fields[1]}")
        result[fields[1]] = fields[0]
    return result


def validate_elf_amd64(path: Path) -> None:
    with path.open("rb") as handle:
        header = handle.read(64)
    if len(header) < 20 or header[:4] != b"\x7fELF":
        raise UpdateError(f"{path.name}: not an ELF binary")
    if header[4] != 2 or header[5] != 1:
        raise UpdateError(f"{path.name}: expected 64-bit little-endian ELF")
    machine = struct.unpack("<H", header[18:20])[0]
    if machine != 62:
        raise UpdateError(f"{path.name}: expected linux/amd64 ELF, machine={machine}")


class FileLock:
    def __init__(self, path: Path, *, required_uid: int = 0):
        self.path = path
        self.required_uid = required_uid
        self.handle: Any = None

    def __enter__(self) -> "FileLock":
        self.path.parent.mkdir(parents=True, exist_ok=True)
        flags = os.O_CREAT | os.O_RDWR | os.O_CLOEXEC
        if not hasattr(os, "O_NOFOLLOW"):
            raise UpdateError("this platform cannot safely open the updater lock without following symlinks")
        try:
            descriptor = os.open(self.path, flags | os.O_NOFOLLOW, 0o600)
        except OSError as exc:
            if exc.errno in (errno.ELOOP, errno.EMLINK):
                raise UpdateError(f"refusing symlinked updater lock: {self.path}") from exc
            raise UpdateError(f"cannot open updater lock {self.path}: {exc}") from exc
        try:
            lock_stat = os.fstat(descriptor)
            if not stat.S_ISREG(lock_stat.st_mode):
                raise UpdateError(f"updater lock is not a regular file: {self.path}")
            if lock_stat.st_uid != self.required_uid:
                raise UpdateError(
                    f"updater lock owner uid is {lock_stat.st_uid}, expected {self.required_uid}: {self.path}"
                )
            if lock_stat.st_nlink != 1:
                raise UpdateError(f"updater lock must have exactly one link: {self.path}")
            os.fchmod(descriptor, 0o600)
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            os.close(descriptor)
            raise LockBusy("another Pearl updater invocation holds the lock") from exc
        except Exception:
            os.close(descriptor)
            raise
        self.handle = os.fdopen(descriptor, "r+", encoding="utf-8")
        self.handle.seek(0)
        self.handle.truncate(0)
        self.handle.write(f"{os.getpid()}\n")
        self.handle.flush()
        os.fsync(self.handle.fileno())
        return self

    def __exit__(self, *_: object) -> None:
        if self.handle:
            fcntl.flock(self.handle.fileno(), fcntl.LOCK_UN)
            self.handle.close()


class Updater:
    def __init__(
