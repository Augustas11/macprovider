    def run_command(
        self,
        argv: list[str],
        *,
        check: bool = True,
        timeout: int,
        env: dict[str, str] | None = None,
        input_text: str | None = None,
    ) -> subprocess.CompletedProcess[str]:
        try:
            return subprocess.run(
                argv,
                check=check,
                text=True,
                capture_output=True,
                timeout=timeout,
                env=env,
                input=input_text,
            )
        except subprocess.TimeoutExpired as exc:
            raise CommandTimeout(f"command timed out after {timeout}s: {argv[0]}") from exc

    def run_candidate_command(
        self,
        argv: list[str],
        *,
        timeout: int,
        cwd: Path,
        environment: dict[str, str] | None = None,
    ) -> subprocess.CompletedProcess[str]:
        minimal_environment = {
            "HOME": "/nonexistent",
            "LANG": "C",
            "LC_ALL": "C",
            "PATH": "/usr/bin:/bin",
            "TMPDIR": "/tmp",
        }
        if environment:
            minimal_environment.update(environment)
        command = list(argv)
        run_kwargs: dict[str, Any] = {
            "check": False,
            "text": True,
            "capture_output": True,
            "timeout": timeout,
            "env": minimal_environment,
            "cwd": cwd,
            "close_fds": True,
            "start_new_session": True,
        }
        if self.isolate_candidate_network:
            unshare = shutil.which("unshare")
            chroot = shutil.which("chroot")
            setpriv = shutil.which("setpriv")
            if not unshare or not chroot or not setpriv:
                raise UpdateError("candidate isolation requires unshare, setpriv, and chroot")
            try:
                sandbox_root = cwd.resolve(strict=True)
                translated: list[str] = []
                for argument in command:
                    candidate_path = Path(argument)
                    if candidate_path.is_absolute():
                        resolved = candidate_path.resolve(strict=True)
                        try:
                            relative = resolved.relative_to(sandbox_root)
                        except ValueError as exc:
                            raise UpdateError("candidate command attempted to access a path outside its sandbox") from exc
                        translated.append("/" + relative.as_posix())
                    else:
                        translated.append(argument)
            except OSError as exc:
                raise UpdateError(f"candidate sandbox path cannot be resolved: {exc}") from exc
            command = [
                unshare,
                "--mount",
                "--pid",
                "--net",
                "--ipc",
                "--uts",
                "--fork",
                "--kill-child",
                setpriv,
                "--no-new-privs",
                "--",
                chroot,
                f"--userspec={self.candidate_uid}:{self.candidate_gid}",
                f"--groups={self.candidate_gid}",
                str(sandbox_root),
                *translated,
            ]
            run_kwargs["cwd"] = "/"
        else:
            if self.candidate_uid != os.geteuid() or self.candidate_gid != os.getegid():
                run_kwargs.update(
                    user=self.candidate_uid,
                    group=self.candidate_gid,
                    extra_groups=(),
                )
            run_kwargs["umask"] = 0o077
        try:
            if self.isolate_candidate_network:
                def limit_candidate_output() -> None:
                    resource.setrlimit(
                        resource.RLIMIT_FSIZE,
                        (MAX_CANDIDATE_OUTPUT_BYTES, MAX_CANDIDATE_OUTPUT_BYTES),
                    )

                run_kwargs.pop("capture_output", None)
                with tempfile.TemporaryFile(mode="w+", encoding="utf-8") as stdout, tempfile.TemporaryFile(
                    mode="w+", encoding="utf-8"
                ) as stderr:
                    result = subprocess.run(
                        command,
                        **run_kwargs,
                        stdout=stdout,
                        stderr=stderr,
                        preexec_fn=limit_candidate_output,
                    )
                    stdout.seek(0)
                    stderr.seek(0)
                    return subprocess.CompletedProcess(
                        result.args,
                        result.returncode,
                        stdout.read(MAX_CANDIDATE_OUTPUT_BYTES + 1),
                        stderr.read(MAX_CANDIDATE_OUTPUT_BYTES + 1),
                    )
            return subprocess.run(command, **run_kwargs)
        except subprocess.TimeoutExpired as exc:
            raise CommandTimeout(f"candidate command timed out after {timeout}s: {argv[0]}") from exc

    def _ensure_private_directory(self, path: Path, description: str) -> None:
        if not _path_entry_exists(path):
            _trusted_directory(
                path.parent,
                f"{description} parent",
                trusted_uid=self.trusted_uid,
                mode=None,
            )
            path.mkdir(mode=0o700)
        _trusted_directory(path, description, trusted_uid=self.trusted_uid, mode=0o700)

    @property
    def journal_path(self) -> Path:
        return self.state_root / "active-transaction.json"

    @property
    def tier2_enforcement_journal_path(self) -> Path:
        return self.state_root / "tier2-enforcement-transaction.json"

    def _journal_transition(self, phase: str, **updates: object) -> None:
        if self.journal is None:
            return
        self.journal.update(updates)
        self.journal["phase"] = phase
        self.journal["updated_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        self._ensure_private_directory(self.state_root, "updater state directory")
        if _path_entry_exists(self.journal_path):
            self._trusted_regular_file(self.journal_path, "updater phase journal", private=True)
        payload = json.dumps(self.journal, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n"
        _secure_atomic_write(self.journal_path, payload)

    def _start_journal(self, release: Release, previous: SemVer) -> None:
        previous_advertised = (
            self.config_update.previous_version if self.config_update is not None else str(previous)
        )
        release_record: dict[str, object] = {
            "tag": release.tag,
            "version": str(release.version),
            "commit": release.commit,
            "provider_advertised_version": self.release_identity(release).advertised_version,
            "coordinator_sha256": release.coordinator.sha256,
            "gateway_sha256": release.gateway.sha256,
            "provider_admission_rollout": dataclasses.asdict(release.provider_admission_rollout),
            "release_lane": release.release_lane,
        }
        if release.catalog is not None:
            release_record.update(
                {
                    "catalog_release_id": release.catalog.release_id,
                    "catalog_policy_version": release.catalog.policy_version,
                    "catalog_files": dict(release.catalog.files),
                }
            )
        self.journal = {
            "schema_version": JOURNAL_SCHEMA_VERSION,
            "phase": "prepared",
            "release": release_record,
            "previous_version": str(previous),
            "previous_advertised_version": previous_advertised,
            "buyer_canary_mode": self.config.buyer_canary_mode,
            "transaction_id": secrets.token_hex(32),
            "boot_id": self._boot_id(),
            "transaction": None,
            "rollback_armed": False,
            "rollback_in_progress": False,
            "rollback_completed_steps": [],
            "live_mutation_started": False,
            "success_persisted": False,
            "previous_services": {},
            "previous_auxiliary_units": {},
            "previous_versions": {},
            "previous_pool_ready": None,
            "previous_protected_providers": [],
            "previous_protected_fleet": [],
            "database_paths": [],
            "database_config_hashes": {},
            "canary_timer_was_active": None,
            "canary_service_was_active": None,
            "deadman_previous_paused": None,
            "deadman_restore_required": False,
        }
        self._journal_transition("prepared")

    def _load_journal(self) -> dict[str, Any] | None:
        if not _path_entry_exists(self.journal_path):
            return None
        raw = _read_trusted_text(
            self.journal_path,
            "updater phase journal",
            trusted_uid=self.trusted_uid,
            private=True,
        )
        try:
            payload = json.loads(raw)
        except ValueError as exc:
            raise UpdateError("updater phase journal is invalid JSON") from exc
        if not isinstance(payload, dict) or payload.get("schema_version") != JOURNAL_SCHEMA_VERSION:
            raise UpdateError("updater phase journal schema is unsupported")
        return payload

    def _clear_journal(self) -> None:
        self.journal_path.unlink(missing_ok=True)
        if _path_entry_exists(self.state_root):
            _fsync_directory(self.state_root)
        self.journal = None

    def audit(self, event: str, outcome: str, **fields: object) -> None:
        record = {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "event": event,
            "outcome": outcome,
            **fields,
        }
        self._ensure_private_directory(self.audit_path.parent, "updater audit directory")
        flags = os.O_WRONLY | os.O_APPEND | os.O_CLOEXEC
        if not hasattr(os, "O_NOFOLLOW"):
            raise UpdateError("this platform cannot safely open the updater audit log")
        if _path_entry_exists(self.audit_path):
            before = _trusted_file_stat(
                self.audit_path,
                "updater audit log",
                trusted_uid=self.trusted_uid,
                private=True,
            )
            descriptor = os.open(self.audit_path, flags | os.O_NOFOLLOW)
            after = os.fstat(descriptor)
            if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
                os.close(descriptor)
                raise UpdateError("updater audit log changed while opening")
        else:
            descriptor = os.open(
                self.audit_path,
                flags | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                0o600,
            )
        with os.fdopen(descriptor, "a", encoding="utf-8") as handle:
            handle.write(json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        _fsync_directory(self.audit_path.parent)
        with contextlib.suppress(Exception):
            self.run_command(
                ["logger", "-t", "macprovider-pearl-updater", json.dumps(record, sort_keys=True)],
                timeout=5,
            )

    def download(self, url: str, destination: Path) -> None:
        request = urllib.request.Request(url, headers={"User-Agent": "macprovider-pearl-updater/1"})
        last_error: Exception | None = None
        for attempt in range(1, self.config.download_attempts + 1):
            deadline = time.monotonic() + self.config.download_timeout_s
            try:
                with urllib.request.urlopen(request, timeout=self.config.request_timeout_s) as response:
                    expected_header = response.headers.get("Content-Length")
                    expected: int | None = None
                    if expected_header is not None:
                        try:
                            expected = int(expected_header)
                        except ValueError as exc:
                            raise UpdateError(f"invalid Content-Length for {destination.name}") from exc
                        if expected < 0 or expected > MAX_DOWNLOAD_BYTES:
                            raise UpdateError(f"download size rejected for {destination.name}: {expected}")
                    written = 0
                    with destination.open("wb") as output:
                        while True:
                            if time.monotonic() >= deadline:
                                raise UpdateError(f"download deadline exceeded for {destination.name}")
                            block = response.read(1024 * 1024)
                            if not block:
                                break
                            written += len(block)
                            if written > MAX_DOWNLOAD_BYTES:
                                raise UpdateError(f"download size limit exceeded for {destination.name}")
                            output.write(block)
                if expected is not None and written != expected:
                    raise UpdateError(f"partial download for {destination.name}")
                return
            except urllib.error.HTTPError as exc:
                if exc.code == 404:
                    destination.unlink(missing_ok=True)
                    raise AssetNotFound(f"release asset not found: {url}") from exc
                last_error = exc
                destination.unlink(missing_ok=True)
                if attempt < self.config.download_attempts:
                    self.sleep(self.config.retry_backoff_s * attempt)
            except (OSError, urllib.error.URLError, http.client.HTTPException, UpdateError) as exc:
                last_error = exc
                destination.unlink(missing_ok=True)
                if attempt < self.config.download_attempts:
                    self.sleep(self.config.retry_backoff_s * attempt)
        raise UpdateError(f"download failed for {url}: {last_error}")

    def verify_signature(self, payload: Path, signature: Path) -> None:
        key_payload = _read_trusted_text(
            self.public_key,
            "pinned release public key",
            trusted_uid=self.trusted_uid,
            limit=64 * 1024,
        ).encode("utf-8")
        key_snapshot = payload.parent / f".release-key-{os.getpid()}-{time.time_ns()}.pem"
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW
        descriptor = os.open(key_snapshot, flags, 0o600)
        try:
            with os.fdopen(descriptor, "wb", closefd=False) as handle:
                handle.write(key_payload)
                handle.flush()
                os.fsync(handle.fileno())
            result = self.run_command(
                ["openssl", "dgst", "-sha256", "-verify", str(key_snapshot), "-signature", str(signature), str(payload)],
                check=False,
                timeout=10,
            )
            if result.returncode != 0:
                raise UpdateError(f"signature verification failed for {payload.name}")
        finally:
            os.close(descriptor)
            key_snapshot.unlink(missing_ok=True)

    def release_tags(self) -> list[str]:
        url = f"https://api.github.com/repos/{PINNED_REPOSITORY}/releases?per_page=30"
        with tempfile.TemporaryDirectory(prefix="pearl-release-list-") as tmp:
            path = Path(tmp) / "releases.json"
            self.download(url, path)
            try:
                rows = json.loads(path.read_text(encoding="utf-8"))
            except (ValueError, OSError) as exc:
                raise UpdateError("GitHub release list is invalid JSON") from exc
        tags = []
        if not isinstance(rows, list):
            raise UpdateError("GitHub release list is not an array")
        for row in rows:
            if isinstance(row, dict) and not row.get("draft") and not row.get("prerelease"):
                tag = row.get("tag_name")
                if isinstance(tag, str) and SEMVER_RE.fullmatch(tag):
                    tags.append(tag)
        return sorted(set(tags), key=SemVer.parse, reverse=True)

    def acquire_release(self, work: Path, source_dir: Path | None, requested_tag: str | None) -> Release:
        if source_dir is not None:
            for asset in (*CONTROL_ASSETS, *RUNTIME_ASSETS, *CATALOG_ASSETS):
                source = source_dir / asset
                if asset in (*CONTROL_ASSETS, *RUNTIME_ASSETS) and not source.is_file():
                    raise UpdateError(f"test source missing asset: {asset}")
                if source.is_file():
                    shutil.copyfile(source, work / asset)
            return self.verify_release(work, requested_tag)

        tags = [requested_tag] if requested_tag else self.release_tags()
        for tag in tags:
            if tag is None or not SEMVER_RE.fullmatch(tag):
                raise UpdateError(f"invalid requested release tag: {tag}")
            candidate = work / tag
            candidate.mkdir(mode=0o700)
            base = f"https://github.com/{PINNED_REPOSITORY}/releases/download/{tag}"
            try:
                self.download(f"{base}/pearl-release.json", candidate / "pearl-release.json")
            except AssetNotFound:
                self.audit("release_skipped", "missing_signed_pearl_metadata", candidate=tag)
                if requested_tag:
                    raise
                shutil.rmtree(candidate)
                continue
            for asset in CONTROL_ASSETS[1:]:
                self.download(f"{base}/{asset}", candidate / asset)
            for asset in RUNTIME_ASSETS:
                self.download(f"{base}/{asset}", candidate / asset)
            try:
                metadata = json.loads((candidate / "pearl-release.json").read_text(encoding="utf-8"))
            except (ValueError, OSError) as exc:
                raise UpdateError("release metadata is invalid JSON") from exc
            if isinstance(metadata, dict) and isinstance(metadata.get("catalog"), dict):
                for asset in CATALOG_ASSETS:
                    self.download(f"{base}/{asset}", candidate / asset)
            release = self.verify_release(candidate, tag)
            if requested_tag is None and release.release_lane == RELEASE_LANE_RUNTIME:
                self.audit("release_skipped", "runtime_only_requires_explicit_tag", candidate=tag)
                shutil.rmtree(candidate)
                continue
            return release
        self.audit("release_selection", "no_eligible_release")
        raise NoEligibleRelease("no signed Pearl runtime release with the required artifact set was found")

    def verify_release(self, directory: Path, expected_tag: str | None) -> Release:
        checksums_path = directory / "checksums.txt"
        metadata_path = directory / "pearl-release.json"
        self.verify_signature(checksums_path, directory / "checksums.txt.sig")
        self.verify_signature(metadata_path, directory / "pearl-release.json.sig")
        checksums = parse_checksums(checksums_path)
        for name in (
            "pearl-release.json",
            "pearl-release.json.sig",
            *RUNTIME_ASSETS,
        ):
            if name not in checksums:
                raise UpdateError(f"signed checksums omit required Pearl runtime asset: {name}")
            if sha256_file(directory / name) != checksums[name]:
                raise UpdateError(f"checksum mismatch for {name}")
        try:
            metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
        except (ValueError, OSError) as exc:
            raise UpdateError("release metadata is invalid JSON") from exc
        release = self.parse_metadata(metadata, directory)
        operator_artifacts = metadata.get("operator_artifacts")
        coordinator_cli = operator_artifacts.get("coordinator_cli") if isinstance(operator_artifacts, dict) else None
        if not isinstance(coordinator_cli, dict):
            raise UpdateError("release metadata coordinator CLI artifact is missing")
        coordinator_cli_sha = coordinator_cli.get("sha256")
        if coordinator_cli.get("asset") != COORDINATOR_CLI_ASSET:
            raise UpdateError("release metadata coordinator CLI asset mismatch")
        if not isinstance(coordinator_cli_sha, str) or not SHA256_RE.fullmatch(coordinator_cli_sha):
            raise UpdateError("release metadata coordinator CLI checksum invalid")
        if coordinator_cli_sha != checksums[COORDINATOR_CLI_ASSET]:
            raise UpdateError("metadata/checksums disagreement for coordinator-cli-linux-amd64")
        if release.catalog is not None:
            for name in CATALOG_ASSETS:
                if name not in checksums:
                    raise UpdateError(f"signed checksums omit required catalog/feed asset: {name}")
                if sha256_file(directory / name) != checksums[name]:
                    raise UpdateError(f"checksum mismatch for {name}")
        if expected_tag and release.tag != expected_tag:
            raise UpdateError(f"signed metadata tag {release.tag} does not match selected tag {expected_tag}")
        for component in (release.coordinator, release.gateway):
            if component.sha256 != checksums[component.asset]:
                raise UpdateError(f"metadata/checksums disagreement for {component.asset}")
            path = directory / component.asset
            validate_elf_amd64(path)
            self.audit(
                "release_component_verified",
                "static_success",
                candidate=release.tag,
                asset=component.asset,
                sha256=component.sha256,
            )
        validate_elf_amd64(directory / COORDINATOR_CLI_ASSET)
        self.audit(
            "release_component_verified",
            "static_success",
            candidate=release.tag,
            asset=COORDINATOR_CLI_ASSET,
            sha256=coordinator_cli_sha,
        )
        if release.catalog is not None:
            self.verify_catalog_release(release)
        self.audit(
            "release_control_set_verified",
            "success",
            candidate=release.tag,
            commit=release.commit,
            provider_advertised_version=release.provider_advertised_version,
            release_lane=release.release_lane,
        )
        return release

    def verify_catalog_release(self, release: Release) -> None:
        if release.catalog is None:
            raise UpdateError("Pearl runtime release is not catalog-bound")
        catalog = release.catalog
        manifest_path = release.directory / "release.json"
        try:
            manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        except (ValueError, OSError) as exc:
            raise UpdateError("catalog release manifest is invalid JSON") from exc
        if not isinstance(manifest, dict) or manifest.get("schema_version") != "macprovider.autotune-release.v1":
            raise UpdateError("catalog release manifest schema is invalid")
        if manifest.get("release_id") != catalog.release_id or manifest.get("policy_version") != catalog.policy_version:
            raise UpdateError("catalog metadata/release identity mismatch")
        feeds = manifest.get("feeds")
        if not isinstance(feeds, dict) or set(feeds) != {"autotune-candidates.json", "demand-rank.json", "rate-card.json", "tier2-catalog.json"}:
            raise UpdateError("catalog release manifest feed set is invalid")
        try:
            trusted_keys = json.loads((release.directory / "trusted-keys.json").read_text(encoding="utf-8"))
        except (ValueError, OSError) as exc:
            raise UpdateError("catalog trusted keys are invalid JSON") from exc
        keys = trusted_keys.get("keys") if isinstance(trusted_keys, dict) else None
        if not isinstance(trusted_keys, dict) or trusted_keys.get("schema_version") != "macprovider.autotune-keys.v1" or not isinstance(keys, dict):
            raise UpdateError("catalog trusted keys schema is invalid")
        for name in CATALOG_ASSETS:
            path = release.directory / name
            self._trusted_regular_file(path, f"verified catalog asset {name}")
            if sha256_file(path) != catalog.files[name]:
                raise UpdateError(f"catalog metadata checksum mismatch for {name}")
        for feed_name in ("autotune-candidates.json", "demand-rank.json", "rate-card.json"):
            row = feeds[feed_name]
            feed_path = release.directory / feed_name
            if not isinstance(row, dict) or row.get("sha256") != sha256_file(feed_path) or row.get("bytes") != feed_path.stat().st_size:
                raise UpdateError(f"catalog release manifest binding mismatch for {feed_name}")
            if row.get("signer_key_id") not in keys:
                raise UpdateError(f"catalog release feed identity mismatch for {feed_name}")
            try:
                feed = json.loads(feed_path.read_text(encoding="utf-8"))
                signature = json.loads((release.directory / f"{feed_name}.sig").read_text(encoding="utf-8"))
            except (ValueError, OSError) as exc:
                raise UpdateError(f"catalog feed/signature JSON is invalid for {feed_name}") from exc
            if not isinstance(feed, dict):
                raise UpdateError(f"catalog feed version mismatch for {feed_name}")
            feed_version = feed.get("version")
            if not isinstance(feed_version, str) or not feed_version:
                raise UpdateError(f"catalog feed version mismatch for {feed_name}")
            expected_version = feed_version
            if feed_name != "rate-card.json":
                expected_version = catalog.release_id
            if row.get("version") != expected_version or feed_version != expected_version:
                raise UpdateError(f"catalog feed version mismatch for {feed_name}")
            if not isinstance(signature, dict) or signature.get("alg") != "ed25519" or signature.get("key_id") != row.get("signer_key_id"):
                raise UpdateError(f"catalog signature identity mismatch for {feed_name}")
        tier2_row = feeds["tier2-catalog.json"]
        tier2_path = release.directory / "tier2-catalog.json"
        if (
            not isinstance(tier2_row, dict)
            or tier2_row.get("sha256") != sha256_file(tier2_path)
            or tier2_row.get("bytes") != tier2_path.stat().st_size
        ):
            raise UpdateError("catalog release manifest binding mismatch for tier2-catalog.json")
        try:
            tier2_catalog = json.loads(tier2_path.read_text(encoding="utf-8"))
        except (ValueError, OSError) as exc:
            raise UpdateError("tier2 catalog JSON is invalid") from exc
        if not isinstance(tier2_catalog, dict) or tier2_row.get("version") != tier2_catalog.get("catalog_id"):
            raise UpdateError("catalog release feed identity mismatch for tier2-catalog.json")
        self._trusted_regular_file(self.catalog_verifier, "catalog release verifier")
        self._trusted_regular_file(self.tier2_coordinator_config, "Tier-2 coordinator trust config")
        result = self.run_command(
            [
                "python3",
                str(self.catalog_verifier),
                "verify-directory",
                "--directory",
                str(release.directory),
                "--tier2-coordinator-config",
                str(self.tier2_coordinator_config),
            ],
            check=False,
            timeout=30,
        )
        if result.returncode != 0:
            raise UpdateError("catalog inner Ed25519 verification failed")
        self.audit(
            "release_catalog_verified",
            "success",
            candidate=release.tag,
            catalog_release_id=catalog.release_id,
            catalog_policy_version=catalog.policy_version,
        )

    def verify_candidate_versions(self, release: Release) -> None:
        self._assert_candidate_validation_directory(release.directory)
        for component in (release.coordinator, release.gateway):
            path = release.directory / component.asset
            self._assert_candidate_validation_file(path, executable=True)
            result = self.run_candidate_command(
                [str(path), "--version"],
                timeout=10,
                cwd=release.directory,
            )
            if result.returncode != 0 or result.stdout.strip() != component.embedded_version:
                raise UpdateError(f"embedded version validation failed for {component.asset}; output suppressed")
            self.audit(
                "release_component_verified",
                "success",
                candidate=release.tag,
                asset=component.asset,
                sha256=component.sha256,
                embedded_version=component.embedded_version,
            )

    def _assert_candidate_validation_directory(self, path: Path) -> None:
        try:
            entry = path.lstat()
        except OSError as exc:
            raise UpdateError(f"cannot inspect candidate validation directory {path}: {exc}") from exc
        if not stat.S_ISDIR(entry.st_mode):
            raise UpdateError(f"candidate validation directory is not a directory: {path}")
        if entry.st_uid != self.trusted_uid or entry.st_gid != self.candidate_gid:
            raise UpdateError(
                f"candidate validation directory ownership must be {self.trusted_uid}:{self.candidate_gid}: {path}"
            )
        if stat.S_IMODE(entry.st_mode) != 0o750:
            raise UpdateError(f"candidate validation directory mode must be 0750: {path}")

    def _assert_candidate_validation_file(self, path: Path, *, executable: bool) -> None:
        entry = self._trusted_regular_file(path, "candidate validation file")
        expected_mode = 0o550 if executable else 0o640
        if entry.st_gid != self.candidate_gid or stat.S_IMODE(entry.st_mode) != expected_mode:
            raise UpdateError(
                f"candidate validation file ownership/mode must be "
                f"{self.trusted_uid}:{self.candidate_gid} {expected_mode:04o}: {path}"
            )

    def stage_candidate_validation(self, release: Release, work_root: Path) -> Release:
        try:
            work_resolved = work_root.resolve(strict=True)
            release_resolved = release.directory.resolve(strict=True)
        except OSError as exc:
            raise UpdateError(f"candidate staging path cannot be resolved: {exc}") from exc
        if release_resolved != work_resolved and release_resolved.parent != work_resolved:
            raise UpdateError("verified release directory is outside the updater work root")
        for directory in (work_root,):
            entry = directory.lstat()
            if not stat.S_ISDIR(entry.st_mode) or entry.st_uid != self.trusted_uid:
                raise UpdateError(f"candidate staging root is not a trusted directory: {directory}")
            os.chown(directory, self.trusted_uid, self.candidate_gid, follow_symlinks=False)
            os.chmod(directory, 0o750, follow_symlinks=False)
        validation = work_root / f"candidate-validation-{os.getpid()}-{time.time_ns()}"
        validation.mkdir(mode=0o700)
        os.chown(validation, self.trusted_uid, self.candidate_gid, follow_symlinks=False)
        os.chmod(validation, 0o750, follow_symlinks=False)
        for component in (release.coordinator, release.gateway):
            source = release.directory / component.asset
            self._trusted_regular_file(source, f"verified {component.asset}")
            if sha256_file(source) != component.sha256:
                raise UpdateError(f"verified candidate changed before staging: {component.asset}")
            destination = validation / component.asset
            self.atomic_replace(
                source,
                destination,
                uid=self.trusted_uid,
                gid=self.candidate_gid,
                mode=0o550,
            )
            self._assert_candidate_validation_file(destination, executable=True)
            if sha256_file(destination) != component.sha256:
                raise UpdateError(f"candidate staging checksum mismatch: {component.asset}")
        if release.catalog is not None:
            for name in CATALOG_ASSETS:
                source = release.directory / name
                self._trusted_regular_file(source, f"verified catalog asset {name}")
                if sha256_file(source) != release.catalog.files[name]:
                    raise UpdateError(f"verified catalog asset changed before staging: {name}")
                destination = validation / name
                self.atomic_replace(
                    source,
                    destination,
                    uid=self.trusted_uid,
                    gid=self.candidate_gid,
                    mode=0o640,
                )
                self._assert_candidate_validation_file(destination, executable=False)
        _fsync_directory(validation)
        self._assert_candidate_validation_directory(validation)
        return dataclasses.replace(release, directory=validation)

    def stage_candidate_config(self, directory: Path, name: str, payload: str) -> Path:
        self._assert_candidate_validation_directory(directory)
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", name):
            raise UpdateError(f"invalid candidate validation config name: {name}")
        destination = directory / name
        _secure_atomic_write(
            destination,
            payload.encode("utf-8"),
            mode=0o640,
            uid=self.trusted_uid,
            gid=self.candidate_gid,
        )
        self._assert_candidate_validation_file(destination, executable=False)
        return destination

    def parse_metadata(self, metadata: object, directory: Path) -> Release:
        if not isinstance(metadata, dict) or metadata.get("schema_version") != 1:
            raise UpdateError("unsupported Pearl release metadata schema")
        if metadata.get("repository") != PINNED_REPOSITORY or metadata.get("architecture") != "linux-amd64":
            raise UpdateError("release metadata repository/architecture mismatch")
        tag = metadata.get("tag")
        commit = metadata.get("commit")
        channel = metadata.get("channel", "production")
        if not isinstance(tag, str) or not SEMVER_RE.fullmatch(tag):
            raise UpdateError("release metadata tag is invalid")
        version = SemVer.parse(tag)
        if metadata.get("release_version") != str(version):
            raise UpdateError("release metadata version/tag mismatch")
        if not isinstance(commit, str) or not COMMIT_RE.fullmatch(commit):
            raise UpdateError("release metadata commit is invalid")
        release_lane = metadata.get("release_lane", RELEASE_LANE_RUNTIME_WITH_CATALOG)
        if release_lane not in (RELEASE_LANE_RUNTIME, RELEASE_LANE_RUNTIME_WITH_CATALOG):
            raise UpdateError("release metadata lane is invalid")
        advertised_raw = metadata.get("provider_advertised_version")
        if release_lane == RELEASE_LANE_RUNTIME:
            if advertised_raw is not None:
                raise UpdateError("runtime-only Pearl release metadata must not carry provider advertised version")
            advertised = str(version)
        else:
            if not isinstance(advertised_raw, str):
                raise UpdateError("release metadata advertised version is missing")
            SemVer.parse(advertised_raw)
            advertised = advertised_raw
        if channel == "private_acceptance":
            if not self.config.allow_private_acceptance:
                raise UpdateError(
                    "private acceptance release metadata requires "
                    "PEARL_UPDATER_ALLOW_PRIVATE_ACCEPTANCE=1"
                )
        elif channel not in ("production",):
            raise UpdateError("release metadata channel is invalid")
        elif release_lane != RELEASE_LANE_RUNTIME and advertised != str(version):
            raise UpdateError("release metadata advertised version must match the release version")
        components = metadata.get("components")
        if not isinstance(components, dict):
            raise UpdateError("release metadata components are missing")

        def component(name: str, required_asset: str) -> Component:
            row = components.get(name)
            if not isinstance(row, dict) or row.get("asset") != required_asset:
                raise UpdateError(f"release metadata {name} asset mismatch")
            digest, embedded = row.get("sha256"), row.get("embedded_version")
            if not isinstance(digest, str) or not SHA256_RE.fullmatch(digest):
                raise UpdateError(f"release metadata {name} checksum invalid")
            if embedded not in (tag, str(version)):
                raise UpdateError(f"release metadata {name} embedded version invalid")
            return Component(required_asset, digest, str(embedded))

        catalog_release: CatalogRelease | None = None
        catalog = metadata.get("catalog")
        if release_lane == RELEASE_LANE_RUNTIME:
            if catalog not in (None, {}):
                raise UpdateError("runtime-only Pearl release metadata must not bind catalog/feed assets")
        else:
            if not isinstance(catalog, dict):
                raise UpdateError("release metadata catalog is missing")
            release_id = catalog.get("release_id")
            policy_version = catalog.get("policy_version")
            files = catalog.get("files")
            if (
                not isinstance(release_id, str)
                or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", release_id)
                or not isinstance(policy_version, str)
                or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", policy_version)
                or not isinstance(files, dict)
                or set(files) != set(CATALOG_ASSETS)
            ):
                raise UpdateError("release metadata catalog identity/files are invalid")
            catalog_files: dict[str, str] = {}
            for name in CATALOG_ASSETS:
                digest = files.get(name)
                if not isinstance(digest, str) or not SHA256_RE.fullmatch(digest):
                    raise UpdateError(f"release metadata catalog checksum invalid for {name}")
                catalog_files[name] = digest
            catalog_release = CatalogRelease(release_id, policy_version, catalog_files)

        rollout = metadata.get("provider_admission_rollout")
        rollout_shape_valid = (
            isinstance(rollout, dict)
            and set(rollout) == {"mode", "enforce_provider_admission", "bridge_duration_s"}
            and type(rollout.get("bridge_duration_s")) is int
        )
        bridge_rollout = (
            rollout_shape_valid
            and rollout.get("mode") == "bridge_required"
            and rollout.get("enforce_provider_admission") is False
            and 3600 <= rollout["bridge_duration_s"] <= 24 * 60 * 60
        )
        strict_rollout = (
            rollout_shape_valid
            and rollout.get("mode") == "strict_post_migration"
            and rollout.get("enforce_provider_admission") is True
            and rollout.get("bridge_duration_s") == 0
        )
        if not bridge_rollout and not strict_rollout:
            raise UpdateError("release metadata provider-admission rollout policy is invalid")
        if release_lane == RELEASE_LANE_RUNTIME and not strict_rollout:
            raise UpdateError("runtime-only Pearl release metadata must not bind provider admission bridge policy")

        return Release(
            tag,
            version,
            commit,
            advertised,
            component("coordinator", COORDINATOR_ASSET),
            component("gateway", GATEWAY_ASSET),
            catalog_release,
            ProviderAdmissionRollout(
                rollout["mode"],
                rollout["enforce_provider_admission"],
                rollout["bridge_duration_s"],
            ),
            directory,
            release_lane,
        )

    def revoked_versions(self) -> set[SemVer]:
        result: set[SemVer] = set()
        if not _path_entry_exists(self.config.revoked_versions_file):
            raise UpdateError(f"required revoked versions policy is missing: {self.config.revoked_versions_file}")
        if not self.config.revoked_versions_file.is_absolute():
            raise UpdateError("revoked versions file must be absolute")
        text = _read_trusted_text(
            self.config.revoked_versions_file,
            "revoked versions policy",
            trusted_uid=self.trusted_uid,
            private=True,
        )
        for number, raw in enumerate(text.splitlines(), 1):
            value = raw.split("#", 1)[0].strip()
            if value:
                try:
                    result.add(SemVer.parse(value))
                except UpdateError as exc:
                    raise UpdateError(f"{self.config.revoked_versions_file}:{number}: {exc}") from exc
        return result

    def installed_release(self) -> InstalledRelease:
        state = self.state_root / "current-release.json"
        durable: dict[str, Any] | None = None
        if _path_entry_exists(state):
            try:
                payload = json.loads(
                    _read_trusted_text(
                        state,
                        "installed release state",
                        trusted_uid=self.trusted_uid,
                        private=True,
                    )
                )
                if not isinstance(payload, dict):
                    raise TypeError("state is not an object")
                SemVer.parse(str(payload["version"]))
                durable = payload
            except (KeyError, TypeError, ValueError, OSError, UpdateError) as exc:
                raise UpdateError(f"installed release state is invalid: {state}") from exc
        binaries: dict[str, SemVer] = {}
        legacy: dict[str, bool] = {}
        hashes: dict[str, str] = {}
        for name in ("coordinator", "gateway"):
            binary = self.install_root / name
            self._trusted_regular_file(binary, f"installed {name} binary")
            result = self.run_command([str(binary), "--version"], check=False, timeout=10)
            value = result.stdout.strip()
            if result.returncode != 0:
                raise UpdateError(f"installed {name} does not report a semantic version")
            if SEMVER_RE.fullmatch(value):
                binaries[name] = SemVer.parse(value)
                legacy[name] = False
            else:
                match = LEGACY_GIT_DESCRIBE_RE.fullmatch(value)
                if match is None:
                    raise UpdateError(f"installed {name} does not report a semantic version")
                binaries[name] = SemVer(*(int(part) for part in match.groups()[:3]))
                legacy[name] = True
            hashes[name] = sha256_file(binary)
        if durable is not None and any(legacy.values()):
            raise UpdateError("durable release state cannot coexist with legacy git-describe binaries")
        return InstalledRelease(
            binaries["coordinator"],
            binaries["gateway"],
            hashes["coordinator"],
            hashes["gateway"],
            durable,
            legacy["coordinator"],
            legacy["gateway"],
        )

    def eligibility(self, release: Release) -> tuple[SemVer, str]:
        installed = self.installed_release()
        current = installed.downgrade_floor
        if release.version in self.revoked_versions():
            self.audit("release_eligibility", "rejected_revoked", candidate=release.tag, current=str(current))
            raise UpdateError(f"release {release.tag} is revoked")
        if release.version < self.config.minimum_version:
            self.audit("release_eligibility", "rejected_below_minimum", candidate=release.tag, current=str(current))
            raise UpdateError(f"release {release.tag} is below the minimum allowed version")
        if release.version < current:
            self.audit("release_eligibility", "rejected_downgrade", candidate=release.tag, current=str(current))
            raise UpdateError(f"downgrade rejected: installed={current} candidate={release.version}")
        if installed.requires_legacy_bootstrap:
            if release.version == current:
                raise UpdateError(
                    f"legacy bootstrap requires a signed release newer than the installed base: installed={current} candidate={release.version}"
                )
            self.audit(
                "release_eligibility",
                "legacy_bootstrap",
                candidate=release.tag,
                current=str(current),
                coordinator=str(installed.coordinator),
                gateway=str(installed.gateway),
            )
            return current, "upgrade"
        if release.version == current:
            if installed.is_coherent_with(release) and self.installed_catalog_is_coherent(release):
                self.audit("release_eligibility", "already_current", candidate=release.tag, current=str(current))
                return current, "already_current"
            self.audit(
                "release_eligibility",
                "repair_pair",
                candidate=release.tag,
                current=str(current),
                coordinator=str(installed.coordinator),
                gateway=str(installed.gateway),
                durable_version=str(installed.durable.get("version")) if installed.durable else "missing",
                coordinator_sha256=installed.coordinator_sha256,
                gateway_sha256=installed.gateway_sha256,
            )
            return current, "repair_pair"
        self.audit("release_eligibility", "upgrade", candidate=release.tag, current=str(current))
        return current, "upgrade"

    def assess_candidate(self, release: Release) -> tuple[SemVer, str]:
        current, decision = self.eligibility(release)
        if release.catalog is not None:
            self._preflight_legacy_tier2_cutover()
        if release.catalog is not None and _path_entry_exists(self._legacy_tier2_catalog_path()):
            if decision != "repair_pair" or release.version != current:
                raise UpdateError("legacy Tier-2 cutover requires same-version repair_pair before upgrade")
        self.verify_candidate_versions(release)
        return current, decision

    def installed_catalog_is_coherent(self, release: Release) -> bool:
        if release.catalog is None:
            return True
        catalog_root = self.install_root / "autotune"
        releases = catalog_root / "releases"
        current = catalog_root / "current"
        try:
            self._assert_catalog_directory(catalog_root, "installed catalog root")
            self._assert_catalog_directory(releases, "installed catalog releases directory")
            if not stat.S_ISLNK(current.lstat().st_mode):
                return False
            expected_target = f"releases/{self._catalog_release_directory_name(release)}"
            if os.readlink(current) != expected_target:
                return False
            installed = catalog_root / expected_target
            self._assert_catalog_directory(installed, "installed catalog release")
            for name in CATALOG_ASSETS:
                self._assert_catalog_asset(installed / name, f"installed catalog asset {name}")
                if sha256_file(installed / name) != release.catalog.files[name]:
                    return False
            legacy_tier2 = self.install_root / "tier2-catalog.json"
            if _path_entry_exists(legacy_tier2):
                return False
            return True
        except (OSError, UpdateError):
            return False

    def _trusted_regular_file(self, path: Path, description: str, *, private: bool = False) -> os.stat_result:
        return _trusted_file_stat(
            path,
            description,
            trusted_uid=self.trusted_uid,
            private=private,
        )

    def _trusted_config_file(self, path: Path) -> None:
        self._trusted_regular_file(path, "coordinator config")

    def _assert_catalog_directory(self, path: Path, description: str) -> None:
        _trusted_directory(path, description, trusted_uid=self.trusted_uid, mode=0o750)
        if path.lstat().st_gid != self.catalog_gid:
            raise UpdateError(
                f"{description} group gid must be {self.catalog_gid}: {path}"
            )

    def _assert_catalog_asset(self, path: Path, description: str) -> None:
        entry = self._trusted_regular_file(path, description)
        if entry.st_gid != self.catalog_gid or stat.S_IMODE(entry.st_mode) != 0o640:
            raise UpdateError(
                f"{description} ownership/mode must be "
                f"{self.trusted_uid}:{self.catalog_gid} 0640: {path}"
            )

    def _repair_catalog_directory(self, path: Path, description: str) -> None:
        if not _path_entry_exists(path):
            path.mkdir(mode=0o700)
        _trusted_directory(path, description, trusted_uid=self.trusted_uid, mode=None)
        os.chown(path, self.trusted_uid, self.catalog_gid, follow_symlinks=False)
        os.chmod(path, 0o750, follow_symlinks=False)
        self._assert_catalog_directory(path, description)

    def validate_recovery_inputs(self, config_path: Path) -> None:
        if not config_path.is_absolute():
            raise UpdateError("updater configuration path must be absolute")
        self._trusted_regular_file(config_path, "updater configuration", private=True)
        _trusted_directory(
            self.state_root.parent,
            "updater state parent directory",
            trusted_uid=self.trusted_uid,
            mode=None,
        )
        if _path_entry_exists(self.state_root):
            _trusted_directory(
                self.state_root,
                "updater state directory",
                trusted_uid=self.trusted_uid,
                mode=0o700,
            )
        if _path_entry_exists(self.audit_path.parent):
            _trusted_directory(
                self.audit_path.parent,
                "updater audit directory",
                trusted_uid=self.trusted_uid,
                mode=0o700,
            )
        if _path_entry_exists(self.audit_path):
            self._trusted_regular_file(self.audit_path, "updater audit log", private=True)

    def validate_independent_alert_configuration(self) -> None:
        parent = INDEPENDENT_ALERT_ENV_PATH.parent
        try:
            parent_stat = parent.lstat()
        except OSError as exc:
            raise UpdateError(f"cannot inspect independent-alert config directory {parent}: {exc}") from exc
        if (
            not stat.S_ISDIR(parent_stat.st_mode)
            or parent_stat.st_uid != self.trusted_uid
            or parent_stat.st_gid != self.independent_alert_gid
            or stat.S_IMODE(parent_stat.st_mode) != 0o750
        ):
            raise UpdateError("independent-alert config directory must have exact trusted ownership and mode 0750")
        if INDEPENDENT_ALERT_ENV_PATH == Path("/etc/macprovider/monitor.env"):
            etc_stat = Path("/etc").lstat()
            if (
                not stat.S_ISDIR(etc_stat.st_mode)
                or etc_stat.st_uid != self.trusted_uid
                or stat.S_IMODE(etc_stat.st_mode) & 0o022
            ):
                raise UpdateError("independent-alert config ancestor /etc is unsafe")
        try:
            env_stat = INDEPENDENT_ALERT_ENV_PATH.lstat()
        except OSError as exc:
            raise UpdateError(
                f"cannot inspect independent-alert config {INDEPENDENT_ALERT_ENV_PATH}: {exc}"
            ) from exc
        if (
            not stat.S_ISREG(env_stat.st_mode)
            or env_stat.st_uid != self.trusted_uid
            or env_stat.st_gid != self.independent_alert_gid
            or env_stat.st_nlink != 1
            or stat.S_IMODE(env_stat.st_mode) != 0o640
        ):
            raise UpdateError("independent-alert config must have exact trusted ownership and mode 0640")
        text = _read_trusted_text(
            INDEPENDENT_ALERT_ENV_PATH,
            "independent-alert configuration",
            trusted_uid=self.trusted_uid,
            limit=64 * 1024,
        )
        values: dict[str, str] = {}
        for number, source in enumerate(text.splitlines(), 1):
            line = source.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                raise UpdateError(f"{INDEPENDENT_ALERT_ENV_PATH}:{number}: expected KEY=VALUE")
            key, value = (part.strip() for part in line.split("=", 1))
            if not re.fullmatch(r"[A-Z][A-Z0-9_]*", key) or key in values:
                raise UpdateError(f"{INDEPENDENT_ALERT_ENV_PATH}:{number}: invalid or duplicate key")
            values[key] = value
        for key in ("ALERT_EMAIL", "GMAIL_USER", "GMAIL_APP_PASSWORD"):
            if not values.get(key):
                raise UpdateError(f"independent Gmail alert is not configured: {key} is empty")

    def validate_policy_inputs(self, config_path: Path) -> None:
        self.validate_recovery_inputs(config_path)
        self.validate_provider_admission_policy_config()
        for path, description in (
            (self.public_key, "pinned release public key"),
            (self.config.revoked_versions_file, "revoked versions policy"),
            (self.config.deadman_api_token_file, "dead-man API token"),
        ):
            if not path.is_absolute():
                raise UpdateError(f"{description} path must be absolute")
        self._trusted_regular_file(self.public_key, "pinned release public key")
        self._trusted_regular_file(
            self.config.revoked_versions_file,
            "revoked versions policy",
            private=True,
        )
        self._trusted_regular_file(
            self.config.deadman_api_token_file,
            "dead-man API token",
            private=True,
        )
        self.validate_independent_alert_configuration()

    def validate_provider_admission_policy_config(self) -> None:
        policy = self.config.provider_admission_policy
        if policy not in ("bridge_required", "strict_post_migration"):
            raise UpdateError(
                "PEARL_UPDATER_PROVIDER_ADMISSION_POLICY must explicitly be bridge_required or strict_post_migration"
            )
        if self.config.minimum_pool_ready_after_rollout <= 0:
            raise UpdateError("PEARL_UPDATER_MINIMUM_POOL_READY_AFTER_ROLLOUT must be configured above zero")
        if policy == "bridge_required":
            if self.config.minimum_pool_ready_after_rollout < 2:
                raise UpdateError("bridge_required rollout needs a fleet floor of at least two ready providers")
            minimum_safe_window = (
                self.config.provider_recovery_timeout_s
                + self.config.service_health_timeout_s
            )
            if self.config.minimum_bridge_remaining_s <= minimum_safe_window:
                raise UpdateError(
                    "PEARL_UPDATER_MINIMUM_BRIDGE_REMAINING_S must exceed the provider recovery and service-health windows"
                )
        elif self.config.minimum_bridge_remaining_s != 0:
            raise UpdateError(
                "strict_post_migration must set PEARL_UPDATER_MINIMUM_BRIDGE_REMAINING_S=0"
            )

    def coordinator_runtime(self) -> CoordinatorRuntime:
        result = self.run_command(
            ["systemctl", "show", "--property=MainPID", "--value", "macprovider-coordinator.service"],
            check=False,
            timeout=10,
        )
        value = result.stdout.strip()
        if result.returncode != 0 or not value.isascii() or not value.isdigit() or int(value) <= 0:
            raise UpdateError("could not identify the running coordinator process")
        proc = Path("/proc") / value

        def proc_bytes(name: str) -> bytes:
            try:
                with (proc / name).open("rb") as handle:
                    payload = handle.read(1024 * 1024 + 1)
            except OSError as exc:
                raise UpdateError(f"could not read coordinator {name}: {exc}") from exc
            if len(payload) > 1024 * 1024:
                raise UpdateError(f"coordinator {name} exceeds the updater safety limit")
            return payload

        argv = [os.fsdecode(item) for item in proc_bytes("cmdline").split(b"\0") if item]
        if not argv or Path(argv[0]) != self.install_root / "coordinator":
            raise UpdateError("running coordinator executable does not match the pinned Pearl install path")

        def flag_value(name: str, *, required: bool) -> str | None:
            values: list[str] = []
            for index, argument in enumerate(argv[1:]):
                if argument == name:
                    absolute_index = index + 1
                    if absolute_index + 1 >= len(argv):
                        raise UpdateError(f"running coordinator has an incomplete {name} flag")
                    values.append(argv[absolute_index + 1])
                elif argument.startswith(name + "="):
                    values.append(argument.split("=", 1)[1])
            if len(values) > 1:
                raise UpdateError(f"running coordinator has duplicate {name} flags")
            if required and not values:
                raise UpdateError(f"running coordinator omits required {name}")
            return values[0] if values else None

        base = Path(str(flag_value("--config", required=True)))
        expected_base = self.install_root / "coordinator.yaml"
        if base != expected_base:
            raise UpdateError(f"running coordinator config is {base}, expected {expected_base}")
        overlay_value = flag_value("--config-overlay", required=False)
        overlay = Path(overlay_value) if overlay_value else None
        for path in (base, overlay):
            if path is not None:
                if not path.is_absolute():
                    raise UpdateError(f"coordinator config path must be absolute: {path}")
                self._trusted_config_file(path)

        environment: dict[str, str] = {}
        for item in proc_bytes("environ").split(b"\0"):
            if not item or b"=" not in item:
                continue
            key, raw_value = item.split(b"=", 1)
            environment[os.fsdecode(key)] = os.fsdecode(raw_value)
        referenced: set[str] = set()
        for path in (base, overlay):
            if path is None:
                continue
            text = _read_trusted_text(
                path,
                "coordinator config",
                trusted_uid=self.trusted_uid,
            )
            referenced.update(re.findall(r"\benv:([A-Z][A-Z0-9_]*)\b", text))
        missing = sorted(name for name in referenced if not environment.get(name))
        if missing:
            raise UpdateError(f"running coordinator environment omits required config variable: {missing[0]}")
        minimal_environment = {name: environment[name] for name in sorted(referenced)}
        return CoordinatorRuntime(base, overlay, minimal_environment)

    def gateway_config_path(self) -> Path:
        result = self.run_command(
            ["systemctl", "show", "--property=MainPID", "--value", "macprovider-gateway.service"],
            check=False,
            timeout=10,
        )
        value = result.stdout.strip()
        if result.returncode != 0 or not value.isascii() or not value.isdigit() or int(value) <= 0:
            raise UpdateError("could not identify the running gateway process")
        try:
            payload = (Path("/proc") / value / "cmdline").read_bytes()
        except OSError as exc:
            raise UpdateError(f"could not read gateway cmdline: {exc}") from exc
        if len(payload) > 1024 * 1024:
            raise UpdateError("gateway cmdline exceeds the updater safety limit")
        argv = [os.fsdecode(item) for item in payload.split(b"\0") if item]
        if not argv or Path(argv[0]) != self.install_root / "gateway":
            raise UpdateError("running gateway executable does not match the pinned Pearl install path")
        values: list[str] = []
        for index, argument in enumerate(argv[1:]):
            if argument == "--config":
                absolute_index = index + 1
                if absolute_index + 1 >= len(argv):
                    raise UpdateError("running gateway has an incomplete --config flag")
                values.append(argv[absolute_index + 1])
            elif argument.startswith("--config="):
                values.append(argument.split("=", 1)[1])
        if len(values) != 1:
            raise UpdateError("running gateway must have exactly one --config flag")
        path = Path(values[0])
        expected = self.install_root / "gateway.yaml"
        if path != expected:
            raise UpdateError(f"running gateway config is {path}, expected {expected}")
        self._trusted_config_file(path)
        return path

    def stats_mirror_runtime(self) -> tuple[tuple[Path, ...], Path]:
        requested = ("FragmentPath", "DropInPaths", "NeedDaemonReload")
        result = self.run_command(
            [
                "systemctl",
                "show",
                *(f"--property={name}" for name in requested),
                "stats-billing-mirror.service",
            ],
            check=False,
            timeout=10,
        )
        properties: dict[str, str] = {}
        for line in result.stdout.splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                properties[key] = value
        if result.returncode != 0:
            raise UpdateError("could not identify the loaded stats billing mirror unit")
        fragment = Path(properties.get("FragmentPath", ""))
        expected = SYSTEMD_ROOT / "stats-billing-mirror.service"
        if fragment != expected:
            raise UpdateError(f"loaded stats billing mirror unit is {fragment}, expected {expected}")
        gate_dropin = SYSTEMD_ROOT / "stats-billing-mirror.service.d" / TRANSACTION_GATE_DROPIN_NAME
        if properties.get("DropInPaths") != str(gate_dropin):
            raise UpdateError("stats billing mirror service has unverified systemd drop-ins")
        if properties.get("NeedDaemonReload") != "no":
            raise UpdateError("systemd must reload the verified stats billing mirror service before rollout")
        self._trusted_regular_file(fragment, "stats billing mirror unit")
        if _read_trusted_text(
            gate_dropin,
            "stats billing mirror transaction-gate drop-in",
            trusted_uid=self.trusted_uid,
        ) != TRANSACTION_GATE_DROPIN_TEXT:
            raise UpdateError("stats billing mirror transaction-gate drop-in content is invalid")
        text = _read_trusted_text(fragment, "stats billing mirror unit", trusted_uid=self.trusted_uid)
        commands = [line.split("=", 1)[1] for line in text.splitlines() if line.startswith("ExecStart=")]
        if len(commands) != 1:
            raise UpdateError("stats billing mirror unit must have exactly one ExecStart")
        try:
            argv = shlex.split(commands[0], posix=True)
        except ValueError as exc:
            raise UpdateError("stats billing mirror ExecStart cannot be parsed safely") from exc
        if not argv or argv[0] != "/opt/macprovider-stats/stats-billing-mirror":
            raise UpdateError("stats billing mirror executable does not match the pinned Pearl path")
        sqlite_values: list[str] = []
        for index, argument in enumerate(argv[1:]):
            if argument == "--sqlite":
                absolute_index = index + 1
                if absolute_index + 1 >= len(argv):
                    raise UpdateError("stats billing mirror has an incomplete --sqlite flag")
                sqlite_values.append(argv[absolute_index + 1])
            elif argument.startswith("--sqlite="):
                sqlite_values.append(argument.split("=", 1)[1])
        if len(sqlite_values) != 1:
            raise UpdateError("stats billing mirror must have exactly one --sqlite flag")
        return (fragment, gate_dropin), self._database_path(sqlite_values[0], "stats billing mirror --sqlite")

    @staticmethod
    def _yaml_section_scalar(text: str, path: Path, section: str, field: str, *, required: bool) -> str | None:
        section_re = re.compile(rf"^{re.escape(section)}:\s*(?:#.*)?$")
        field_re = re.compile(
            rf"^ +{re.escape(field)}: *(?:\"([^\"]*)\"|'([^']*)'|([^#\s]+)) *(?:#.*)?$"
        )
        section_count = 0
        in_section = False
        values: list[str] = []
        for raw in text.splitlines():
            if "\t" in raw:
                raise UpdateError(f"tabs are not allowed in updater-parsed YAML: {path}")
            if raw and not raw.startswith((" ", "#")):
                in_section = section_re.fullmatch(raw) is not None
                if in_section:
                    section_count += 1
                continue
            if in_section:
                match = field_re.fullmatch(raw)
                if match:
                    values.append(next(value for value in match.groups() if value is not None))
        if section_count > 1 or len(values) > 1:
            raise UpdateError(f"ambiguous {section}.{field} in {path}")
        if not values:
            if required:
                raise UpdateError(f"effective config omits {section}.{field}: {path}")
            return None
        return values[0]

    def effective_coordinator_scalar(self, section: str, field: str) -> str | None:
        runtime = self.coordinator_runtime_state or self.coordinator_runtime()
        value: str | None = None
        for path in (runtime.base_config, runtime.overlay_config):
            if path is None:
                continue
            text = _read_trusted_text(path, "coordinator config", trusted_uid=self.trusted_uid)
            candidate = self._yaml_section_scalar(text, path, section, field, required=False)
            if candidate is not None:
                value = candidate
        return value

    @staticmethod
    def _database_path(value: str, description: str) -> Path:
        if not re.fullmatch(r"/[A-Za-z0-9._/-]+", value):
            raise UpdateError(f"{description} must be an absolute path using safe characters")
        path = Path(value)
        if path != Path(os.path.normpath(value)) or ".." in path.parts:
            raise UpdateError(f"{description} must be a normalized absolute path")
        return path

    def capture_database_paths(self) -> None:
        if self.gateway_db is not None:
            paths = (
                self.databases
                if self.databases and self.databases[0] == self.gateway_db
                else (self.gateway_db, *self.databases)
            )
            config_hashes = dict(self.runtime_config_hashes)
        else:
            runtime = self.coordinator_runtime_state or self.coordinator_runtime()
            coordinator_paths = [runtime.base_config]
            if runtime.overlay_config is not None:
                coordinator_paths.append(runtime.overlay_config)
            effective: dict[tuple[str, str], str] = {}
            for config_path in coordinator_paths:
                text = _read_trusted_text(config_path, "coordinator config", trusted_uid=self.trusted_uid)
                for key in (("storage", "db_path"), ("malibu_emission", "sqlite_payout_db_path")):
                    value = self._yaml_section_scalar(text, config_path, *key, required=False)
                    if value is not None:
                        effective[key] = value
            storage = effective.get(("storage", "db_path"))
            if storage is None:
                raise UpdateError("effective coordinator config omits storage.db_path")
            gateway_config = self.gateway_config_path()
            gateway_text = _read_trusted_text(gateway_config, "gateway config", trusted_uid=self.trusted_uid)
            gateway = self._yaml_section_scalar(gateway_text, gateway_config, "storage", "db_path", required=True)
            assert gateway is not None
            stats_unit_inputs, stats_database = self.stats_mirror_runtime()
            gateway_database = self._database_path(gateway, "gateway storage.db_path")
            coordinator_database = self._database_path(storage, "coordinator storage.db_path")
            if gateway_database == coordinator_database:
                raise UpdateError("gateway and coordinator database paths must be distinct")
            if stats_database == gateway_database:
                raise UpdateError("stats billing mirror cannot read the gateway database")
            resolved = [gateway_database, coordinator_database]
            if stats_database != coordinator_database:
                resolved.append(stats_database)
            payout = effective.get(("malibu_emission", "sqlite_payout_db_path"))
            if payout:
                resolved.append(self._database_path(payout, "coordinator malibu_emission.sqlite_payout_db_path"))
            paths = tuple(resolved)
            config_hashes = {
                path: sha256_file(path) for path in (*coordinator_paths, gateway_config, *stats_unit_inputs)
            }
        if any(not path.is_absolute() for path in paths) or len(set(paths)) != len(paths):
            raise UpdateError("effective database paths must be distinct absolute paths")
        self.gateway_db = paths[0]
        self.databases = tuple(paths)
        self.runtime_config_hashes = config_hashes
        self._journal_transition(
            "database_paths_captured",
            database_paths=[str(path) for path in paths],
            database_config_hashes={str(path): digest for path, digest in config_hashes.items()},
        )

    @staticmethod
    def _advertised_field(text: str, path: Path) -> tuple[int, re.Match[str], list[str]] | None:
        lines = text.splitlines(keepends=True)
        section_count = 0
        in_section = False
        matches: list[tuple[int, re.Match[str]]] = []
        section_re = re.compile(r"^coordinator_advertised_version:\s*(?:#.*)?(?:\r?\n)?$")
        field_re = re.compile(
            r"^( +latest_binary_version: *)(?:\"([^\"]*)\"|'([^']*)'|([^#\s]+))( *(?:#.*)?)(\r?\n)?$"
        )
        for index, line in enumerate(lines):
            if line and not line.startswith((" ", "\t", "\r", "\n")):
                in_section = section_re.fullmatch(line) is not None
                if in_section:
                    section_count += 1
                continue
            if in_section:
                match = field_re.fullmatch(line)
                if match:
                    matches.append((index, match))
        if section_count > 1 or len(matches) > 1:
            raise UpdateError(f"ambiguous coordinator advertised-version field in {path}")
        if not matches:
            return None
        index, match = matches[0]
        return index, match, lines

    @staticmethod
    def _set_yaml_section_scalars(
        text: str,
        path: Path,
        section: str,
        values: dict[str, str | None],
    ) -> str:
        """Replace or remove direct scalar children in one top-level YAML section."""
        lines = text.splitlines(keepends=True)
        section_re = re.compile(rf"^{re.escape(section)}:\s*(?:#.*)?(?:\r?\n)?$")
        starts = [index for index, line in enumerate(lines) if section_re.fullmatch(line)]
        if len(starts) > 1:
            raise UpdateError(f"ambiguous {section} section in {path}")
        if not starts:
            if lines and not lines[-1].endswith(("\n", "\r")):
                lines[-1] += "\n"
            if lines and lines[-1].strip():
                lines.append("\n")
            lines.append(f"{section}:\n")
            lines.extend(
                f"  {key}: {value}\n"
                for key, value in values.items()
                if value is not None
            )
            return "".join(lines)

        start = starts[0]
        end = len(lines)
        top_level_key = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\s*:")
        for index in range(start + 1, len(lines)):
            if top_level_key.match(lines[index]):
                end = index
                break
        found: dict[str, int] = {}
        field_re = re.compile(r"^([ ]+)([A-Za-z_][A-Za-z0-9_-]*)\s*:")
        for index in range(start + 1, end):
            match = field_re.match(lines[index])
            if match is None or len(match.group(1)) != 2 or match.group(2) not in values:
                continue
            key = match.group(2)
            if key in found:
                raise UpdateError(f"ambiguous {section}.{key} field in {path}")
            found[key] = index
        for key, index in found.items():
            if values[key] is None:
                lines[index] = ""
            else:
                newline = "\r\n" if lines[index].endswith("\r\n") else "\n"
                lines[index] = f"  {key}: {values[key]}{newline}"
        missing = [key for key, value in values.items() if key not in found and value is not None]
        if missing:
            lines[start + 1:start + 1] = [f"  {key}: {values[key]}\n" for key in missing]
        return "".join(lines)

    def prepare_config_update(self, release: Release) -> ConfigUpdate:
        self._assert_candidate_validation_directory(release.directory)
        runtime = self.coordinator_runtime()
        self.coordinator_runtime_state = runtime
        config_paths = [runtime.base_config]
        if runtime.overlay_config is not None:
            config_paths.append(runtime.overlay_config)
        located: list[tuple[Path, int, re.Match[str], list[str]]] = []
        tier2_catalog_owners: list[tuple[Path, str]] = []
        effective_require_hash_verified: str | None = None
        effective_model_hash_legacy_until: str | None = None
        config_texts: dict[Path, str] = {}
        config_hashes: dict[Path, str] = {}
        for path in config_paths:
            text = _read_trusted_text(
                path,
                "coordinator config",
                trusted_uid=self.trusted_uid,
            )
            config_texts[path] = text
            config_hashes[path] = sha256_file(path)
            field = self._advertised_field(text, path)
            if field is not None:
                located.append((path, *field))
            tier2_catalog_path = self._yaml_section_scalar(
                text,
                path,
                "tier2",
                "catalog_path",
                required=False,
            )
            if tier2_catalog_path is not None:
                tier2_catalog_owners.append((path, tier2_catalog_path))
            require_hash_verified = self._yaml_section_scalar(
                text,
                path,
                "tier2",
                "require_hash_verified",
                required=False,
            )
            if require_hash_verified is not None:
                effective_require_hash_verified = require_hash_verified
            model_hash_legacy_until = self._yaml_section_scalar(
                text,
                path,
                "tier2",
                "model_hash_legacy_until",
                required=False,
            )
            if model_hash_legacy_until is not None:
                effective_model_hash_legacy_until = model_hash_legacy_until
        if not located:
            raise UpdateError("effective coordinator configuration has no advertised binary version field")
        if release.catalog is not None and not tier2_catalog_owners:
            raise UpdateError("effective coordinator configuration has no tier2.catalog_path field")
        if effective_require_hash_verified not in ("false", "true"):
            raise UpdateError("effective tier2.require_hash_verified must be explicitly false or true")
        if effective_require_hash_verified == "true" and (
            effective_model_hash_legacy_until is not None
            or runtime.environment.get("MODEL_HASH_LEGACY_UNTIL")
        ):
            raise UpdateError("enforced hash verification cannot retain the model hash algorithm legacy bridge")
        target, index, match, lines = located[-1]
        previous = next(value for value in match.groups()[1:4] if value is not None)
        payloads = dict(config_texts)
        bridge_deadline: str | None = None
        next_version = previous
        if release.catalog is not None:
            lines[index] = f'{match.group(1)}"{release.provider_advertised_version}"{match.group(5)}{match.group(6) or ""}'
            next_version = release.provider_advertised_version
            if self.config.provider_admission_policy != release.provider_admission_rollout.mode:
                raise UpdateError("signed provider-admission rollout policy does not match updater policy")
            rollout = release.provider_admission_rollout
            if rollout.mode == "bridge_required":
                bridge_budget = rollout.bridge_duration_s
                required_budget = (
                    self.config.provider_recovery_timeout_s
                    + self.config.service_health_timeout_s
                    + self.config.minimum_bridge_remaining_s
                )
                if bridge_budget <= required_budget:
                    raise UpdateError("signed provider-admission bridge duration is below the recovery safety budget")
                bridge_deadline = (
                    datetime.datetime.now(datetime.timezone.utc)
                    + datetime.timedelta(seconds=bridge_budget)
                ).replace(microsecond=0).isoformat().replace("+00:00", "Z")
            payloads[target] = self._set_yaml_section_scalars(
                "".join(lines),
                target,
                "autotune",
                {
                    "enforce_provider_admission": "true" if rollout.enforce_provider_admission else "false",
                    "provider_admission_bridge_deadline": (
                        json.dumps(bridge_deadline) if bridge_deadline is not None else None
                    ),
                },
            )
        catalog_target: Path | None = None
        previous_catalog_path: str | None = None
        next_catalog_path: str | None = None
        if release.catalog is not None:
            catalog_target, previous_catalog_path = tier2_catalog_owners[-1]
            next_catalog_path = str(self._current_tier2_catalog_path())
            payloads[catalog_target] = self._set_yaml_section_scalars(
                payloads[catalog_target],
                catalog_target,
                "tier2",
                {
                    "catalog_path": next_catalog_path,
                },
            )
        staged_configs: dict[Path, Path] = {}
        for config_index, path in enumerate(config_paths):
            payload = payloads[path]
            staged_path = self.stage_candidate_config(
                release.directory,
                f"coordinator-validation-{config_index}.yaml",
                payload,
            )
            staged_configs[path] = staged_path
        staged = staged_configs[target]
        staged_catalog_path: str | None = None
        staged_require_hash_verified: str | None = None
        for path in config_paths:
            staged_text = staged_configs[path].read_text(encoding="utf-8")
            candidate_catalog_path = self._yaml_section_scalar(
                staged_text,
                staged_configs[path],
                "tier2",
                "catalog_path",
                required=False,
            )
            if candidate_catalog_path is not None:
                staged_catalog_path = candidate_catalog_path
            candidate_require_hash = self._yaml_section_scalar(
                staged_text,
                staged_configs[path],
                "tier2",
                "require_hash_verified",
                required=False,
            )
            if candidate_require_hash is not None:
                staged_require_hash_verified = candidate_require_hash
        if release.catalog is not None and staged_catalog_path != next_catalog_path:
            raise UpdateError("staged effective tier2.catalog_path is not the release-bound current catalog path")
        if staged_require_hash_verified != effective_require_hash_verified:
            raise UpdateError("staged effective tier2.require_hash_verified must preserve the live enforcement state")

        validation_base = staged_configs[runtime.base_config]
        validation_argv = [
            str(release.directory / release.coordinator.asset),
            "--config",
            str(validation_base),
        ]
        if runtime.overlay_config is not None:
            validation_overlay = staged_configs[runtime.overlay_config]
            validation_argv.extend(["--config-overlay", str(validation_overlay)])
        validation_argv.append("--validate-config")
        result = self.run_candidate_command(
            validation_argv,
            timeout=30,
            cwd=release.directory,
            environment=runtime.environment,
        )
        if result.returncode != 0 or result.stdout.strip() != "config: ok":
            raise UpdateError("candidate rejected the staged coordinator config; output suppressed")
        for path, expected_hash in config_hashes.items():
            if sha256_file(path) != expected_hash:
                raise UpdateError(f"coordinator config changed during candidate validation: {path}")
        update = ConfigUpdate(
            target=target,
            staged=staged,
            original_sha256=config_hashes[target],
            previous_version=previous,
            next_version=next_version,
            catalog_target=catalog_target,
            catalog_staged=staged_configs[catalog_target] if catalog_target is not None else None,
            catalog_original_sha256=config_hashes[catalog_target] if catalog_target is not None else None,
            previous_catalog_path=previous_catalog_path,
            next_catalog_path=next_catalog_path,
        )
        self.config_update = update
        self.audit(
            "coordinator_config_verified",
            "success",
            candidate=release.tag,
            target=str(target),
            previous_version=previous,
            next_version=next_version,
            catalog_target=str(catalog_target) if catalog_target is not None else "",
            previous_catalog_path=previous_catalog_path or "",
            next_catalog_path=next_catalog_path or "",
            provider_admission_policy=(
                release.provider_admission_rollout.mode if release.catalog is not None else "preserved"
            ),
            provider_admission_bridge_deadline=bridge_deadline,
            release_lane=release.release_lane,
        )
        return update

    @staticmethod
    def _systemd_seconds(value: str) -> int:
        match = re.fullmatch(r"([0-9]+)(us|ms|s|min|h)", value)
        if not match:
            raise UpdateError(f"unsupported systemd duration: {value!r}")
        amount = int(match.group(1))
        unit = match.group(2)
        if unit == "us":
            return amount // 1_000_000
        if unit == "ms":
            return amount // 1_000
        if unit == "s":
            return amount
        if unit == "min":
            return amount * 60
        return amount * 3600

    def verify_canary_authority(self) -> None:
        unit_paths: dict[str, Path] = {}
        if set(CANARY_AUTHORITY_FILE_MODES) != set(CANARY_AUTHORITY_FILES):
            raise UpdateError("canary rollout authority mode manifest is incomplete")
        for path, expected in CANARY_AUTHORITY_FILES.items():
            info = self._trusted_regular_file(path, "canary rollout-authority file")
            expected_mode = CANARY_AUTHORITY_FILE_MODES[path]
            if stat.S_IMODE(info.st_mode) != expected_mode:
                raise UpdateError(
                    f"canary rollout authority requires mode {expected_mode:04o} for {path}"
                )
            actual = sha256_file(path)
            if actual != expected:
                raise UpdateError(
                    f"canary rollout authority {CANARY_AUTHORITY_VERSION} hash mismatch for {path}"
                )
            if path.name in ("canary-buyer.service", "canary-buyer.timer"):
                unit_paths[path.name] = path
        if set(unit_paths) != {"canary-buyer.service", "canary-buyer.timer"}:
            raise UpdateError("canary rollout authority omits a required systemd unit")

        for path, description in CANARY_AUTHORITY_PRIVATE_FILES.items():
            info = self._trusted_regular_file(path, description, private=True)
            if stat.S_IMODE(info.st_mode) != 0o600:
                raise UpdateError(f"{description} must be an exact root-owned 0600 file")
            if info.st_size <= 0 or info.st_size > 64 * 1024:
                raise UpdateError(f"{description} has an invalid size")
        for path, description in (
            (CANARY_BUYER_TOKEN, "canary buyer token"),
            (CANARY_OPERATOR_TOKEN, "canary operator token"),
        ):
            token = _read_trusted_text(
                path,
                description,
                trusted_uid=self.trusted_uid,
                private=True,
                limit=64 * 1024,
            ).strip()
            if not token or any(character.isspace() for character in token):
                raise UpdateError(f"{description} is empty or contains whitespace")
        heartbeat_url = _read_trusted_text(
            CANARY_HEARTBEAT_URL,
            "canary heartbeat URL",
            trusted_uid=self.trusted_uid,
            private=True,
            limit=64 * 1024,
        )
        if heartbeat_url.endswith("\r\n"):
            heartbeat_url = heartbeat_url[:-2]
        elif heartbeat_url.endswith(("\r", "\n")):
            heartbeat_url = heartbeat_url[:-1]
        try:
            heartbeat = urllib.parse.urlsplit(heartbeat_url)
            heartbeat_port = heartbeat.port
        except ValueError as exc:
            raise UpdateError("canary heartbeat URL is invalid") from exc
        if (
            not heartbeat_url
            or any(character.isspace() for character in heartbeat_url)
            or heartbeat.scheme != "https"
            or not heartbeat.hostname
            or heartbeat.username is not None
            or heartbeat.password is not None
            or heartbeat.fragment
            or heartbeat_port is not None and not 1 <= heartbeat_port <= 65535
        ):
            raise UpdateError("canary heartbeat URL must be one HTTPS URL without userinfo or fragment")
        self._canary_expected_fleet()

        loaded: dict[str, dict[str, str]] = {}
        for unit, unit_path in unit_paths.items():
            requested = ["FragmentPath", "DropInPaths", "NeedDaemonReload"]
            if unit.endswith(".service"):
                requested.append("TimeoutStartUSec")
            result = self.run_command(
                ["systemctl", "show", *(f"--property={name}" for name in requested), unit],
                check=False,
                timeout=10,
            )
            properties: dict[str, str] = {}
            for line in result.stdout.splitlines():
                if "=" in line:
                    key, value = line.split("=", 1)
                    properties[key] = value
            if result.returncode != 0 or properties.get("FragmentPath") != str(unit_path):
                raise UpdateError(f"systemd is not using the verified {unit} fragment")
            expected_dropins = ""
            if unit == "canary-buyer.service":
                gate_dropin = SYSTEMD_ROOT / "canary-buyer.service.d" / TRANSACTION_GATE_DROPIN_NAME
                if _read_trusted_text(
                    gate_dropin,
                    "canary transaction-gate drop-in",
                    trusted_uid=self.trusted_uid,
                ) != TRANSACTION_GATE_DROPIN_TEXT:
                    raise UpdateError("canary transaction-gate drop-in content is invalid")
                expected_dropins = str(gate_dropin)
            if properties.get("DropInPaths", "") != expected_dropins:
                raise UpdateError(f"{unit} has unverified systemd drop-ins")
            if properties.get("NeedDaemonReload") != "no":
                raise UpdateError(f"systemd must reload the verified {unit} before rollout")
            loaded[unit] = properties
        unit_budget = self._systemd_seconds(loaded["canary-buyer.service"].get("TimeoutStartUSec", ""))
        if unit_budget != CANARY_UNIT_BUDGET_S:
            raise UpdateError(
                f"verified canary-buyer.service budget is {unit_budget}s, expected {CANARY_UNIT_BUDGET_S}s"
            )
        if self.config.canary_timeout_s <= unit_budget:
            raise UpdateError("updater canary timeout must exceed the verified canary unit budget")
        self.audit(
            "canary_rollout_authority_verified",
            "success",
            authority=CANARY_AUTHORITY_VERSION,
            authority_commit=CANARY_AUTHORITY_COMMIT,
            unit_budget_s=unit_budget,
            updater_timeout_s=self.config.canary_timeout_s,
        )

    def _canary_expected_fleet(self) -> list[dict[str, str]]:
        try:
            document = json.loads(
                _read_trusted_text(
                    CANARY_EXPECTED_FLEET,
                    "canary expected fleet",
                    trusted_uid=self.trusted_uid,
                    private=True,
                    limit=64 * 1024,
                )
            )
            providers = document["providers"]
            normalized = [
                {
                    "provider_id": row["provider_id"],
                    "model_id": row["model_id"],
                }
                for row in providers
            ]
        except (OSError, ValueError, KeyError, TypeError) as exc:
            raise UpdateError("canary expected fleet is invalid") from exc
        provider_ids = [row["provider_id"] for row in normalized]
        model_ids = [row["model_id"] for row in normalized]
        if (
            not isinstance(document, dict)
            or document.get("schema_version") != 1
            or not isinstance(providers, list)
            or len(providers) < 1
            or len(providers) > CANARY_MAX_EXPECTED_PROVIDERS
            or any(not isinstance(row, dict) for row in providers)
            or any(not isinstance(value, str) or not value for value in provider_ids + model_ids)
            or len(set(provider_ids)) != len(provider_ids)
        ):
            raise UpdateError(
                "canary expected fleet must bind unique protected providers to non-empty models"
            )
        return normalized

    @staticmethod
    def _normalize_protected_fleet_rows(rows: object, description: str) -> list[dict[str, str]]:
        if not isinstance(rows, list):
            raise UpdateError(f"{description} is invalid")
        normalized: list[dict[str, str]] = []
        for row in rows:
            if not isinstance(row, dict):
                raise UpdateError(f"{description} is invalid")
            provider_id = row.get("provider_id")
            model_id = row.get("model_id")
            if (
                not isinstance(provider_id, str)
                or not provider_id
                or len(provider_id) > 256
                or not isinstance(model_id, str)
                or not model_id
            ):
                raise UpdateError(f"{description} is invalid")
            normalized.append({"provider_id": provider_id, "model_id": model_id})
        provider_ids = [row["provider_id"] for row in normalized]
        if len(provider_ids) != len(set(provider_ids)):
            raise UpdateError(f"{description} contains duplicate provider identities")
        return sorted(normalized, key=lambda row: row["provider_id"])

    def _previous_protected_fleet(self) -> list[dict[str, str]]:
        if self.previous_protected_fleet:
            return [dict(row) for row in self.previous_protected_fleet]
        if not self.previous_protected_providers:
            return []
        raise UpdateError("phase journal protected provider model baseline is unavailable")

    def _rollback_authorization_fleet(self, previous_version: str) -> list[dict[str, str]]:
        protected_fleet = self._previous_protected_fleet()
        if not protected_fleet:
            return self._canary_expected_fleet()
        poolz = self.get_authorized_json(
            "http://127.0.0.1:8444/poolz",
            self.coordinator_operator_token(),
        )
        rows = poolz.get("pool")
        if not isinstance(rows, list):
            raise UpdateError("legacy rollback authorization pool snapshot omitted provider rows")
        expected_ids = {row["provider_id"] for row in protected_fleet}
        current: dict[str, dict[str, Any]] = {}
        for row in rows:
            if not isinstance(row, dict):
                raise UpdateError("legacy rollback authorization pool snapshot contains an invalid row")
            provider_id = row.get("provider_id")
            if not isinstance(provider_id, str) or not provider_id:
                raise UpdateError("legacy rollback authorization pool snapshot contains an invalid provider identity")
            if provider_id in current:
                raise UpdateError("legacy rollback authorization pool snapshot contains duplicate provider identities")
            current[provider_id] = row
        fleet: list[dict[str, str]] = []
        for expected in protected_fleet:
            provider_id = expected["provider_id"]
            row = current.get(provider_id)
            model_id = row.get("model_id") if isinstance(row, dict) else None
            binary_version = row.get("binary_version") if isinstance(row, dict) else None
            if (
                row is None
                or row.get("state") != "ready"
                or row.get("routing_eligible") is not True
                or model_id != expected["model_id"]
                or str(SemVer.parse(str(binary_version or ""))) != previous_version
            ):
                raise UpdateError(
                    "legacy rollback authorization requires the captured protected providers to be ready on the restored version"
                )
            fleet.append(dict(expected))
        ready_rows = sum(
            1
            for provider_id, row in current.items()
            if provider_id in expected_ids
            and row.get("state") == "ready"
            and row.get("routing_eligible") is True
        )
        if self.previous_pool_ready is not None and ready_rows < self.previous_pool_ready:
            raise UpdateError("legacy rollback authorization capacity is below the protected rollout baseline")
        return fleet

    def _legacy_rollback_control_directory(self) -> Path:
        directory = self.canary_rollback_authorization.parent
        if not _path_entry_exists(directory):
            try:
                directory.mkdir(mode=0o755)
                os.chown(directory, self.trusted_uid, -1, follow_symlinks=False)
                os.chmod(directory, 0o755)
                _fsync_directory(directory.parent)
            except OSError as exc:
                raise UpdateError(
                    f"cannot create legacy rollback authorization directory {directory}: {exc}"
                ) from exc
        _trusted_directory(
            directory,
            "legacy rollback authorization directory",
            trusted_uid=self.trusted_uid,
            mode=0o755,
        )
        return directory

    def _remove_legacy_rollback_authorization(self) -> None:
        path = self.canary_rollback_authorization
        if not _path_entry_exists(path):
            return
        directory = self._legacy_rollback_control_directory()
        info = self._trusted_regular_file(path, "legacy rollback authorization")
        if stat.S_IMODE(info.st_mode) != 0o644 or info.st_size < 2 or info.st_size > 4096:
            raise UpdateError("legacy rollback authorization must be an exact root-owned 0644 control file")
        path.unlink()
        _fsync_directory(directory)
        self.audit("legacy_rollback_authorization", "removed")

    def _write_legacy_rollback_authorization(self, previous_version: str) -> None:
        if self.journal is None:
            raise UpdateError("legacy rollback authorization requires an active phase journal")
        rollback_in_progress = self.journal.get("rollback_in_progress") is True
        pre_mutation_restore = (
            self.journal.get("rollback_armed") is False
            and self.journal.get("live_mutation_started") is False
            and self.journal.get("success_persisted") is False
            and set(self.previous_services) == {
                "macprovider-coordinator.service",
                "macprovider-gateway.service",
            }
            and all(self.previous_services.values())
        )
        if rollback_in_progress and self.journal.get("success_persisted") is not False:
            raise UpdateError("legacy rollback authorization conflicts with persisted rollout success")
        if not rollback_in_progress and not pre_mutation_restore:
            raise UpdateError("legacy rollback authorization is outside an active restoration")
        transaction_id = self.journal.get("transaction_id")
        if not isinstance(transaction_id, str) or not SHA256_RE.fullmatch(transaction_id):
            raise UpdateError("legacy rollback authorization transaction identifier is invalid")
        try:
            normalized_version = str(SemVer.parse(previous_version))
            journal_version = str(SemVer.parse(str(self.journal.get("previous_advertised_version", ""))))
        except UpdateError as exc:
            raise UpdateError("legacy rollback authorization version is invalid") from exc
        if normalized_version != journal_version:
            raise UpdateError("legacy rollback authorization version mismatches the phase journal")
        fleet = self._rollback_authorization_fleet(normalized_version)
        baseline_fleet = self._previous_protected_fleet()
        if baseline_fleet and fleet != baseline_fleet:
            raise UpdateError("legacy rollback authorization fleet mismatches the protected rollout baseline")
        directory = self._legacy_rollback_control_directory()
        self._remove_legacy_rollback_authorization()
        validity_s = min(max(self.config.canary_timeout_s + 60, 180), 14 * 60)
        expires_at = (
            datetime.datetime.now(datetime.timezone.utc)
            + datetime.timedelta(seconds=validity_s)
        ).isoformat(timespec="seconds").replace("+00:00", "Z")
        document = {
            "schema_version": 1,
            "kind": "legacy_rollback",
            "authority": CANARY_AUTHORITY_VERSION,
            "transaction_id": transaction_id,
            "expires_at": expires_at,
            "providers": [
                {**row, "binary_version": normalized_version}
                for row in fleet
            ],
        }
        _secure_atomic_write(
            self.canary_rollback_authorization,
            json.dumps(document, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n",
            mode=0o644,
            uid=self.trusted_uid,
            gid=directory.lstat().st_gid,
        )
        self.audit(
            "legacy_rollback_authorization",
            "created",
            transaction_id=transaction_id,
            binary_version=normalized_version,
            provider_count=len(fleet),
            expires_at=expires_at,
        )

    def verify_canary_rollout_readiness(self) -> None:
        gate = self._trusted_regular_file(CANARY_ENABLE_GATE, "canary reviewed enable gate")
        _trusted_directory(
            CANARY_ENABLE_GATE.parent,
            "canary control directory",
            trusted_uid=self.trusted_uid,
            mode=0o755,
        )
        if stat.S_IMODE(gate.st_mode) != 0o644 or gate.st_size != 0:
            raise UpdateError("canary reviewed enable gate must be an empty root-owned 0644 file")
        if _path_entry_exists(CANARY_DISABLE_SENTINEL):
            raise UpdateError("canary emergency-disable sentinel blocks rollout")
        if _path_entry_exists(self.canary_rollback_authorization):
            raise UpdateError("stale legacy rollback authorization blocks rollout")
        self.audit(
            "canary_rollout_readiness_verified",
            "success",
            authority=CANARY_AUTHORITY_VERSION,
        )

    def verify_disabled_buyer_canary_posture(self) -> None:
        for gate, description in (
            (CANARY_ENABLE_GATE, "canary reviewed enable gate"),
            (CANARY_LEGACY_ENABLE_GATE, "legacy canary enable gate"),
        ):
            if _path_entry_exists(gate):
                raise UpdateError(f"{description} must be absent in disabled buyer-canary mode")
        state_root = CANARY_DISABLE_SENTINEL.parent
        try:
            state_root_info = state_root.lstat()
        except OSError as exc:
            raise UpdateError(
                f"cannot inspect canary state directory {state_root}: {exc}"
            ) from exc
        if stat.S_ISLNK(state_root_info.st_mode):
            expected_link = os.path.relpath(
                CANARY_DISABLE_STATE_DIRECTORY,
                start=state_root.parent,
            )
            try:
                actual_link = os.readlink(state_root)
            except OSError as exc:
                raise UpdateError(
                    f"cannot inspect canary state-directory link {state_root}: {exc}"
                ) from exc
            if (
                state_root_info.st_uid != self.trusted_uid
                or state_root_info.st_nlink != 1
                or actual_link != expected_link
            ):
                raise UpdateError(
                    "canary state-directory link must be the root-owned systemd StateDirectory link"
                )
            _trusted_directory(
                CANARY_DISABLE_STATE_DIRECTORY,
                "canary private state directory",
                trusted_uid=self.trusted_uid,
                mode=0o755,
            )
        else:
            _trusted_directory(
                state_root,
                "canary state directory",
                trusted_uid=self.trusted_uid,
                mode=0o755,
            )
        sentinel = self._trusted_regular_file(
            CANARY_DISABLE_SENTINEL,
            "canary emergency-disable sentinel",
        )
        if stat.S_IMODE(sentinel.st_mode) != 0o644 or sentinel.st_size != 0:
            raise UpdateError(
                "canary emergency-disable sentinel must be an empty root-owned 0644 file"
            )
        if _path_entry_exists(self.canary_rollback_authorization):
            raise UpdateError("stale legacy rollback authorization blocks rollout")
        expected = (
            ("is-enabled", "canary-buyer.timer", 1, "disabled"),
            ("is-active", "canary-buyer.timer", 3, "inactive"),
            ("is-active", "canary-buyer.service", 3, "inactive"),
        )
        for action, unit, returncode, output in expected:
            result = self.run_command(
                ["systemctl", action, unit],
                check=False,
                timeout=10,
            )
            if result.returncode != returncode or result.stdout.strip() != output:
                raise UpdateError(
                    f"disabled buyer-canary mode requires {unit} {output}; "
                    f"systemctl {action} returned {result.stdout.strip()!r}"
                )
        self.audit(
            "buyer_canary_rollout_posture",
            "disabled",
            mode=BUYER_CANARY_MODE_DISABLED,
            timer_enabled=False,
            timer_active=False,
            service_active=False,
        )

    def verify_buyer_canary_rollout_posture(self) -> None:
        if self.config.buyer_canary_mode == BUYER_CANARY_MODE_REQUIRED:
            self.verify_canary_authority()
            self.verify_canary_rollout_readiness()
            return
        if self.config.buyer_canary_mode == BUYER_CANARY_MODE_DISABLED:
            self.verify_disabled_buyer_canary_posture()
            return
        raise UpdateError("unsupported buyer canary mode")

    def _deadman_api_token(self) -> str:
        path = self.config.deadman_api_token_file
        token = _read_trusted_text(
            path,
            "dead-man API token",
            trusted_uid=self.trusted_uid,
            private=True,
            limit=4096,
        )
        if len(token) > 4096:
            raise UpdateError("dead-man API token exceeds the safety limit")
        token = token.strip()
        if not token or any(character.isspace() for character in token):
            raise UpdateError("dead-man API token is empty or contains whitespace")
        return token

    def validate_deadman_configuration(self) -> str:
        if not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", self.config.deadman_heartbeat_id):
            raise UpdateError("PEARL_UPDATER_DEADMAN_HEARTBEAT_ID is missing or invalid")
        if not self.config.deadman_api_token_file.is_absolute():
            raise UpdateError("PEARL_UPDATER_DEADMAN_API_TOKEN_FILE must be absolute")
        return self._deadman_api_token()

    @staticmethod
    def _deadman_get_state(payload: object) -> bool:
        try:
            attributes = payload["data"]["attributes"]  # type: ignore[index]
            status_value = attributes["status"]
            paused_at = attributes["paused_at"]
        except (KeyError, TypeError) as exc:
            raise UpdateError("dead-man GET response omitted status/paused_at") from exc
        if status_value not in ("paused", "pending", "up", "down"):
            raise UpdateError("dead-man GET response returned an unsupported status")
        if status_value == "paused":
            if not isinstance(paused_at, str) or not paused_at.strip():
                raise UpdateError("dead-man paused status omitted paused_at")
            return True
        if paused_at is not None:
            raise UpdateError("dead-man active status returned a non-null paused_at")
        return False

    def deadman_request(self, method: str, paused: bool | None = None) -> bool:
        token = self.validate_deadman_configuration()
        url = (
            "https://uptime.betterstack.com/api/v2/heartbeats/"
            + self.config.deadman_heartbeat_id
        )
        body: bytes | None = None
        headers = {
            "Accept": "application/json",
            "Authorization": "Bearer " + token,
            "User-Agent": "macprovider-pearl-updater/1",
        }
        if method == "PATCH":
            if paused is None:
                raise UpdateError("dead-man PATCH requires a paused state")
            body = json.dumps({"paused": paused}, separators=(",", ":")).encode("utf-8")
            headers["Content-Type"] = "application/json"
        elif method != "GET" or paused is not None:
            raise UpdateError("unsupported dead-man API request")
        request = urllib.request.Request(url, data=body, headers=headers, method=method)
        try:
            with urllib.request.urlopen(request, timeout=self.config.request_timeout_s) as response:
                if response.status < 200 or response.status >= 300:
                    raise UpdateError(f"dead-man API returned HTTP {response.status}")
                payload_bytes = response.read(1024 * 1024 + 1)
        except (OSError, urllib.error.URLError, http.client.HTTPException) as exc:
            raise UpdateError(f"dead-man API {method} failed") from exc
        if len(payload_bytes) > 1024 * 1024:
            raise UpdateError("dead-man API response exceeds the safety limit")
        try:
            payload = json.loads(payload_bytes)
        except ValueError as exc:
            raise UpdateError("dead-man API response is invalid JSON") from exc
        if method == "GET":
            return self._deadman_get_state(payload)
        try:
            attributes = payload["data"]["attributes"]
            attributes["paused_at"]
        except (KeyError, TypeError) as exc:
            raise UpdateError("dead-man PATCH response omitted paused_at") from exc
        observed = self.deadman_request("GET")
        if observed is not paused:
            raise UpdateError("dead-man API did not apply the requested paused state")
        return observed

    def enter_deadman_maintenance(self) -> None:
        previous = self.deadman_request("GET")
        self.deadman_previous_paused = previous
        self._journal_transition(
            "deadman_state_captured",
            deadman_previous_paused=previous,
            deadman_restore_required=False,
        )
        if previous:
            self.audit("deadman_maintenance", "already_paused")
            return
        self.deadman_restore_required = True
        self._journal_transition(
            "deadman_pause_pending",
            deadman_restore_required=True,
        )
        try:
            self.deadman_request("PATCH", True)
        except Exception as exc:
            restore_error: Exception | None = None
            try:
                self.deadman_request("PATCH", False)
                self.deadman_restore_required = False
            except Exception as restore_exc:
                restore_error = restore_exc
            if restore_error:
                raise UpdateError(
                    f"could not enter dead-man maintenance: {exc}; restoring active monitoring also failed: {restore_error}"
                ) from exc
            raise
        self.audit("deadman_maintenance", "paused")
        self._journal_transition("deadman_paused")

    def restore_deadman_monitoring(self) -> None:
        if not self.deadman_restore_required:
            return
        if self.deadman_previous_paused is not False:
            raise UpdateError("dead-man prior state is unavailable for restoration")
        self._journal_transition("deadman_restore_pending")
        self.deadman_request("PATCH", False)
        self.deadman_restore_required = False
        self._journal_transition("deadman_restored", deadman_restore_required=False)
        self.audit("deadman_maintenance", "restored_active")

    def get_json(self, url: str) -> dict[str, Any]:
        request = urllib.request.Request(url, headers={"User-Agent": "macprovider-pearl-updater/1"})
        with urllib.request.urlopen(request, timeout=self.config.request_timeout_s) as response:
            if response.status != 200:
                raise UpdateError(f"health request returned HTTP {response.status}: {url}")
            data = response.read(1024 * 1024 + 1)
        if len(data) > 1024 * 1024:
            raise UpdateError(f"health response too large: {url}")
        try:
            payload = json.loads(data)
        except ValueError as exc:
            raise UpdateError(f"health response is invalid JSON: {url}") from exc
        if not isinstance(payload, dict):
            raise UpdateError(f"health response is not an object: {url}")
        return payload

    def get_authorized_json(
        self,
        url: str,
        token: str,
        *,
        timeout_s: float | None = None,
    ) -> dict[str, Any]:
        request = urllib.request.Request(
            url,
            headers={
                "Authorization": "Bearer " + token,
                "User-Agent": "macprovider-pearl-updater/1",
            },
        )

        opener = _credential_safe_opener()
        effective_timeout_s = (
            float(self.config.request_timeout_s)
            if timeout_s is None
            else min(float(self.config.request_timeout_s), timeout_s)
        )
        if effective_timeout_s <= 0:
            raise UpdateError("authorized canary request deadline expired")
        with opener.open(request, timeout=effective_timeout_s) as response:
            if response.status != 200 or response.geturl() != url:
                raise UpdateError("authorized canary request did not return an exact HTTP 200")
            data = response.read(1024 * 1024 + 1)
        if len(data) > 1024 * 1024:
            raise UpdateError("authorized canary response exceeds the safety limit")
        try:
            payload = json.loads(data)
        except ValueError as exc:
            raise UpdateError("authorized canary response is invalid JSON") from exc
        if not isinstance(payload, dict):
            raise UpdateError("authorized canary response is not an object")
        return payload

    def _boot_id(self) -> str:
        value = _read_trusted_text(
            self.boot_id_path,
            "kernel boot identifier",
            trusted_uid=self.trusted_uid,
            limit=128,
        ).strip()
        if not re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", value):
            raise UpdateError("kernel boot identifier is invalid")
        return value

    def _permit_path(self, unit: str) -> Path:
        if unit not in GATED_SERVICE_UNITS:
            raise UpdateError(f"unit is not protected by the transaction gate: {unit}")
        return self.gate_state_root / "permits" / f"{unit}.json"

    def issue_start_permit(self, unit: str, *, ttl_s: int = 30) -> Path | None:
        if unit not in GATED_SERVICE_UNITS or self.journal is None:
            return None
        transaction_id = self.journal.get("transaction_id")
        journal_boot_id = self.journal.get("boot_id")
        if not isinstance(transaction_id, str) or not re.fullmatch(r"[0-9a-f]{64}", transaction_id):
            raise UpdateError("phase journal transaction identifier is invalid")
        if journal_boot_id != self._boot_id():
            raise UpdateError("phase journal boot identifier does not match the current boot")
        if ttl_s < 1 or ttl_s > 600:
            raise UpdateError("transaction start permit lifetime is out of bounds")
        self._ensure_private_directory(self.gate_state_root, "updater runtime gate directory")
        permit_directory = self.gate_state_root / "permits"
        self._ensure_private_directory(permit_directory, "updater start-permit directory")
        path = self._permit_path(unit)
        if _path_entry_exists(path):
            self._trusted_regular_file(path, "updater start permit", private=True)
            path.unlink()
            _fsync_directory(permit_directory)
        payload = {
            "schema_version": 1,
            "unit": unit,
            "transaction_id": transaction_id,
            "boot_id": journal_boot_id,
            "expires_at": int(time.time()) + ttl_s,
            "nonce": secrets.token_hex(32),
        }
        try:
            _secure_atomic_write(
                path,
                json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n",
            )
        except Exception as publish_error:
            try:
                if _path_entry_exists(path):
                    self._trusted_regular_file(path, "updater start permit", private=True)
                    path.unlink()
                _fsync_directory(permit_directory)
            except Exception as cleanup_error:
                raise UpdateError(
                    f"start permit publication failed: {publish_error}; "
                    f"published permit cleanup also failed: {cleanup_error}"
                ) from publish_error
            raise
        return path

    def revoke_start_permit(self, path: Path | None) -> None:
        if path is None:
            return
        path.unlink(missing_ok=True)
        if _path_entry_exists(path.parent):
            _fsync_directory(path.parent)

    def service_active(self, unit: str) -> bool:
        result = self.run_command(
            ["systemctl", "is-active", "--quiet", unit],
            check=False,
            timeout=10,
        )
        if result.returncode == 0:
            return True
        if result.returncode == 3:
            return False
        raise UpdateError(f"could not determine systemd active state for {unit}")

    def assert_unit_quiescent(self, unit: str) -> None:
        def state() -> dict[str, str]:
            result = self.run_command(
                [
                    "systemctl",
                    "show",
                    "--property=ActiveState",
                    "--property=SubState",
                    "--property=Job",
                    unit,
                ],
                check=False,
                timeout=10,
            )
            properties: dict[str, str] = {}
            for line in result.stdout.splitlines():
                if "=" in line:
                    key, value = line.split("=", 1)
                    properties[key] = value
            if result.returncode != 0:
                raise UpdateError(f"could not prove {unit} quiescent")
            if properties.get("Job", "") not in ("", "0"):
                raise UpdateError(f"{unit} still has a queued systemd job")
            return properties

        properties = state()
        if properties.get("ActiveState") == "failed":
            reset = self.run_command(
                ["systemctl", "reset-failed", unit],
                check=False,
                timeout=10,
            )
            if reset.returncode != 0:
                raise UpdateError(
                    f"could not normalize {unit} failed state: {reset.stderr.strip()}"
                )
            properties = state()
        if properties.get("ActiveState") != "inactive":
            raise UpdateError(f"{unit} is not inactive")

    def systemctl(self, action: str, unit: str) -> None:
        self._journal_transition(
            f"systemctl_{action}_pending",
            pending_action={"kind": "systemctl", "action": action, "unit": unit},
        )
        permit = self.issue_start_permit(unit) if action == "start" else None
        try:
            result = self.run_command(["systemctl", action, unit], check=False, timeout=420)
        except CommandTimeout as exc:
            if action == "start":
                cleanup = self.run_command(["systemctl", "stop", unit], check=False, timeout=420)
                if cleanup.returncode != 0:
                    raise UpdateError(f"systemctl start {unit} timed out and cancellation failed") from exc
            raise
        finally:
            self.revoke_start_permit(permit)
        if result.returncode != 0:
            with contextlib.suppress(Exception):
                self.audit("service_action", "failed", action=action, unit=unit, reason=result.stderr.strip())
            raise UpdateError(f"systemctl {action} {unit} failed: {result.stderr.strip()}")
        self.audit("service_action", "success", action=action, unit=unit)
        self._journal_transition(
            f"systemctl_{action}_complete",
            pending_action=None,
        )

    def _stop_failed_canary_gate(self, unit: str, failure: str) -> None:
        journal_error: Exception | None = None
        try:
            self._journal_transition(
                "canary_gate_cancel_pending",
                pending_action={"kind": "systemctl", "action": "stop", "unit": unit},
            )
        except Exception as exc:
            journal_error = exc
        try:
            cleanup = self.run_command(
                ["systemctl", "stop", unit],
                check=False,
                timeout=420,
            )
        except Exception as exc:
            raise UpdateError(f"{failure}; canary-buyer cancellation failed: {exc}") from exc
        if cleanup.returncode != 0:
            raise UpdateError(f"{failure}; canary-buyer cancellation failed: {cleanup.stderr.strip()}")
        try:
            self.assert_unit_quiescent(unit)
        except Exception as exc:
            raise UpdateError(f"{failure}; canary-buyer did not become quiescent: {exc}") from exc
        try:
            self._journal_transition("canary_gate_cancelled", pending_action=None)
        except Exception as exc:
            if journal_error is None:
                journal_error = exc
            else:
                journal_error = UpdateError(
                    f"cancellation intent journal failed: {journal_error}; "
                    f"cancellation completion journal failed: {exc}"
                )
        if journal_error is not None:
            raise UpdateError(
                f"{failure}; canary-buyer was quiesced but cancellation journaling failed: {journal_error}"
            ) from journal_error

    def run_canary_gate(self, *, legacy_rollback_version: str | None = None) -> None:
        if self.config.buyer_canary_mode != BUYER_CANARY_MODE_REQUIRED:
            raise UpdateError("buyer canary gate is unavailable outside required mode")
        unit = "canary-buyer.service"
        # The rollout can run for hours. Revalidate both immutable runtime
        # authority and the operator kill switches at the execution choke point,
        # not only during the initial plan/apply preflight.
        if legacy_rollback_version is not None:
            self._remove_legacy_rollback_authorization()
        self.verify_canary_authority()
        self.verify_canary_rollout_readiness()
        permit: Path | None = None
        try:
            if legacy_rollback_version is not None:
                self._write_legacy_rollback_authorization(legacy_rollback_version)
            self._journal_transition(
                "canary_gate_pending",
                pending_action={"kind": "canary_gate", "unit": unit},
            )
            permit = self.issue_start_permit(unit)
            try:
                result = self.run_command(
                    ["systemctl", "start", unit],
                    check=False,
                    timeout=self.config.canary_timeout_s,
                )
            except CommandTimeout as exc:
                failure = "canary-buyer exceeded the updater deadline"
                self._stop_failed_canary_gate(unit, failure)
                raise UpdateError(f"{failure}; its systemd job was cancelled") from exc
            if result.returncode != 0:
                failure = f"canary-buyer final serving gate failed: {result.stderr.strip()}"
                self._stop_failed_canary_gate(unit, failure)
                raise UpdateError(failure)
            try:
                state = self.run_command(
                    [
                        "systemctl",
                        "show",
                        "--property=Result",
                        "--property=ExecMainStatus",
                        unit,
                    ],
                    check=False,
                    timeout=10,
                )
            except Exception as exc:
                failure = "canary-buyer final serving gate status could not be verified"
                self._stop_failed_canary_gate(unit, failure)
                raise UpdateError(failure) from exc
            properties: dict[str, str] = {}
            for line in state.stdout.splitlines():
                if "=" in line:
                    key, value = line.split("=", 1)
                    properties[key] = value
            if (
                state.returncode != 0
                or properties.get("Result") != "success"
                or properties.get("ExecMainStatus") != "0"
            ):
                failure = "canary-buyer final serving gate did not complete successfully"
                self._stop_failed_canary_gate(unit, failure)
                raise UpdateError(failure)
            self.audit(
                "canary_serving_gate",
                "success",
                authority=CANARY_AUTHORITY_VERSION,
            )
            self._journal_transition("canary_gate_complete", pending_action=None)
        finally:
            cleanup_error: Exception | None = None
            try:
                self.revoke_start_permit(permit)
            except Exception as exc:
                cleanup_error = exc
            try:
                self._remove_legacy_rollback_authorization()
            except Exception as exc:
                if cleanup_error is None:
                    cleanup_error = exc
                else:
                    cleanup_error = UpdateError(
                        f"start-permit cleanup failed: {cleanup_error}; authorization cleanup failed: {exc}"
                    )
            if cleanup_error is not None:
                active_error = sys.exc_info()[1]
                if active_error is not None:
                    raise UpdateError(
                        f"{active_error}; canary control cleanup also failed: {cleanup_error}"
                    ) from active_error
                raise cleanup_error

    def _wait_for_deadline(
        self,
        description: str,
        timeout_s: int,
        check: Callable[[float], bool],
    ) -> None:
        deadline = time.monotonic() + timeout_s
        last_error: Exception | None = None
        while time.monotonic() < deadline:
            try:
                if check(deadline):
                    if time.monotonic() > deadline:
                        last_error = UpdateError(f"{description} completed after its deadline")
                        break
                    self.audit("rollout_check", "success", check=description)
                    return
            except Exception as exc:  # health convergence is retried until deadline
                last_error = exc
            remaining_s = deadline - time.monotonic()
            if remaining_s <= 0:
                break
            self.sleep(min(2.0, remaining_s))
        detail = f": {last_error}" if last_error else ""
        with contextlib.suppress(Exception):
            self.audit("rollout_check", "failed", check=description, reason=str(last_error) if last_error else "timeout")
        raise UpdateError(f"timeout waiting for {description}{detail}")

    def wait_for(self, description: str, timeout_s: int, check: Callable[[], bool]) -> None:
        self._wait_for_deadline(description, timeout_s, lambda _deadline: check())

    def wait_for_with_deadline(
        self,
        description: str,
        timeout_s: int,
        check: Callable[[float], bool],
    ) -> None:
        self._wait_for_deadline(description, timeout_s, check)

    @staticmethod
    def remaining_deadline_timeout(
        deadline: float,
        maximum_s: float,
        description: str,
    ) -> float:
        remaining_s = deadline - time.monotonic()
        if remaining_s <= 0:
            raise UpdateError(f"{description} deadline expired")
        return min(maximum_s, remaining_s)

    def gateway_reservations(self) -> int:
        if self.gateway_db is None:
            raise UpdateError("effective gateway database path was not captured")
        result = self.run_command(
            [
                "sqlite3",
                "-bail",
                str(self.gateway_db),
                "SELECT (SELECT COUNT(*) FROM concurrency_reservations WHERE status='active') + "
                "(SELECT COUNT(*) FROM quota_reservations WHERE status='active');",
            ],
            check=False,
            timeout=10,
        )
        value = result.stdout.strip()
        if result.returncode != 0 or not value.isascii() or not value.isdigit():
            raise UpdateError("could not prove gateway in-flight reservation count")
        return int(value)

    def drain_gateway(self) -> None:
        deadline = time.monotonic() + self.config.gateway_drain_timeout_s
        zero_since: float | None = None
        while time.monotonic() < deadline:
            count = self.gateway_reservations()
            if count == 0:
                zero_since = zero_since or time.monotonic()
                if time.monotonic() - zero_since >= self.config.gateway_drain_steady_s:
                    return
            else:
                zero_since = None
            self.sleep(1)
        raise UpdateError("gateway drain timeout; active reservations remain")

    def capture_rollout_state(self) -> None:
        self.capture_database_paths()
        coord = self.get_json("http://127.0.0.1:8444/healthz")
        pool_size = coord.get("pool_size")
        if type(pool_size) is not int or pool_size < 0:
            raise UpdateError("coordinator health omitted a valid pool_size")
        pool_ready = coord.get("pool_ready")
        if type(pool_ready) is not int or pool_ready < 0 or pool_ready > pool_size:
            raise UpdateError("coordinator health omitted a valid pool_ready")
        self.previous_pool_ready = pool_ready
        if pool_size > 0 and not self.config.allow_provider_drain:
            raise UpdateError(
                f"provider drain protection: {pool_size} connected provider(s); set PEARL_UPDATER_ALLOW_PROVIDER_DRAIN=1 only after verifying graceful-drain-capable clients"
            )
        poolz = self.get_authorized_json(
            "http://127.0.0.1:8444/poolz",
            self.coordinator_operator_token(),
        )
        rows = poolz.get("pool")
        if not isinstance(rows, list):
            raise UpdateError("operator pool snapshot omitted provider rows")
        protected: list[dict[str, str]] = []
        for row in rows:
            if not isinstance(row, dict):
                raise UpdateError("operator pool snapshot contains an invalid provider row")
            provider_id = row.get("provider_id")
            model_id = row.get("model_id")
            if (
                row.get("routing_eligible") is True
                and row.get("state") == "ready"
            ):
                if not isinstance(provider_id, str) or not provider_id or len(provider_id) > 256:
                    raise UpdateError("operator pool snapshot contains an invalid provider identity")
                if not isinstance(model_id, str) or not model_id:
                    raise UpdateError("operator pool snapshot contains an invalid protected provider model")
                protected.append({"provider_id": provider_id, "model_id": model_id})
        protected_ids = [row["provider_id"] for row in protected]
        if len(protected_ids) != len(set(protected_ids)):
            raise UpdateError("operator pool snapshot contains duplicate protected provider identities")
        if len(protected) != pool_ready:
            raise UpdateError("operator pool snapshot does not match coordinator ready capacity")
        self.previous_protected_fleet = self._normalize_protected_fleet_rows(
            protected,
            "operator protected provider model baseline",
        )
        self.previous_protected_providers = [
            row["provider_id"] for row in self.previous_protected_fleet
        ]
        self.previous_services = {
            "macprovider-coordinator.service": self.service_active("macprovider-coordinator.service"),
            "macprovider-gateway.service": self.service_active("macprovider-gateway.service"),
        }
        if not all(self.previous_services.values()):
            raise UpdateError("coordinator and gateway must both be active before rollout")
        self.canary_timer_was_active = self.service_active("canary-buyer.timer")
        self.canary_service_was_active = self.service_active("canary-buyer.service")
        self.previous_auxiliary_units = {
            unit: self.service_active(unit) for unit in AUXILIARY_UNITS
        }
        self.previous_versions = self.read_installed_versions()
        self._journal_transition(
            "runtime_state_captured",
            previous_services=dict(self.previous_services),
            canary_timer_was_active=self.canary_timer_was_active,
            canary_service_was_active=self.canary_service_was_active,
            previous_auxiliary_units=dict(self.previous_auxiliary_units),
            previous_versions=dict(self.previous_versions),
            previous_pool_ready=self.previous_pool_ready,
            previous_protected_providers=list(self.previous_protected_providers),
            previous_protected_fleet=list(self.previous_protected_fleet),
        )

    def coordinator_operator_token(self) -> str:
        raw = self.effective_coordinator_scalar("auth", "operator_key")
        if raw is None:
            raise UpdateError("effective coordinator config omits auth.operator_key")
        if raw.startswith("env:"):
            name = raw.removeprefix("env:")
            runtime = self.coordinator_runtime_state or self.coordinator_runtime()
            token = runtime.environment.get(name, "")
        else:
            token = raw
        if not token or len(token) > 4096 or any(character.isspace() for character in token):
            raise UpdateError("effective coordinator operator credential is unavailable")
        return token

    def read_installed_versions(self) -> dict[str, str]:
        versions: dict[str, str] = {}
        for name in ("coordinator", "gateway"):
            result = self.run_command([str(self.install_root / name), "--version"], check=False, timeout=10)
            value = result.stdout.strip()
            if result.returncode != 0 or not value or len(value) > 128:
                raise UpdateError(f"could not capture previous {name} embedded version")
            versions[name] = value
        return versions

    def stop_for_rollout(self) -> None:
        if not self.previous_services:
            self.capture_rollout_state()
        for unit in ("macprovider-archive-rotate.timer", "stats-billing-mirror.timer"):
            self.systemctl("stop", unit)
        for unit in ("macprovider-archive-rotate.service", "stats-billing-mirror.service"):
            self.systemctl("stop", unit)
        for unit in AUXILIARY_UNITS:
            self.assert_unit_quiescent(unit)
        self.systemctl("stop", "canary-buyer.timer")
        self.systemctl("stop", "canary-buyer.service")
        self.assert_unit_quiescent("canary-buyer.timer")
        self.assert_unit_quiescent("canary-buyer.service")
        self.drain_gateway()
        self.systemctl("stop", "macprovider-gateway.service")
        self.assert_unit_quiescent("macprovider-gateway.service")
        if self.gateway_reservations() != 0:
            raise UpdateError("gateway stopped with active reservations")
        self.wait_for(
            "coordinator active requests to drain",
            self.config.gateway_drain_timeout_s,
            lambda: self.get_json("http://127.0.0.1:8444/healthz").get("requests_active") == 0,
        )
        self.systemctl("stop", "macprovider-coordinator.service")
        self.assert_unit_quiescent("macprovider-coordinator.service")
        self._journal_transition("traffic_quiesced")

    def sqlite_backup(self, source: Path, destination: Path) -> None:
        result = self.run_command(["sqlite3", "-bail", str(source), f".backup '{destination}'"], check=False, timeout=300)
        if result.returncode != 0 or not destination.is_file():
            raise UpdateError(f"SQLite snapshot failed for {source}: {result.stderr.strip()}")
        check = self.run_command(["sqlite3", "-bail", str(destination), "PRAGMA integrity_check;"], check=False, timeout=300)
        if check.returncode != 0 or check.stdout.strip() != "ok":
            raise UpdateError(f"SQLite snapshot integrity check failed for {source}")
        destination.chmod(0o600)
        with destination.open("rb") as handle:
            os.fsync(handle.fileno())

    @staticmethod
    def _durable_copy(source: Path, destination: Path) -> None:
        shutil.copyfile(source, destination)
        os.chmod(destination, 0o600)
        with destination.open("rb") as handle:
            os.fsync(handle.fileno())

    @staticmethod
    def _write_json(path: Path, payload: object) -> None:
        _secure_atomic_write(
            path,
            json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n",
        )

    def snapshot(self, release: Release) -> Path:
        if self.config_update is None:
            raise UpdateError("coordinator config update was not prepared")
        for path, expected_hash in self.runtime_config_hashes.items():
            self._trusted_config_file(path)
            if sha256_file(path) != expected_hash:
                raise UpdateError(f"runtime database configuration changed after capture: {path}")
        self._ensure_private_directory(self.state_root, "updater state directory")
        transactions_root = self.state_root / "transactions"
        self._ensure_private_directory(transactions_root, "updater transaction directory")
        tx = transactions_root / f"{time.time_ns()}-{release.tag}"
        tx.mkdir(mode=0o700)
        component_manifest: dict[str, str] = {}
        for name in ("coordinator", "gateway"):
            source = self.install_root / name
            self._trusted_regular_file(source, f"installed {name} binary")
            self._durable_copy(source, tx / name)
            component_manifest[name] = sha256_file(tx / name)
        if sha256_file(self.config_update.target) != self.config_update.original_sha256:
            raise UpdateError("coordinator advertised-version config changed after candidate validation")
        if (
            self.config_update.catalog_target is not None
            and self.config_update.catalog_original_sha256 is not None
            and sha256_file(self.config_update.catalog_target) != self.config_update.catalog_original_sha256
        ):
            raise UpdateError("coordinator Tier-2 catalog config changed after candidate validation")
        config_dir = tx / "configurations"
        config_dir.mkdir(mode=0o700)
        config_manifest = []
        config_paths = [self.install_root / "coordinator.yaml", self.install_root / "gateway.yaml"]
        for path in (self.config_update.target, self.config_update.catalog_target):
            if path is not None and path not in config_paths:
                config_paths.append(path)
        for index, source in enumerate(config_paths):
            self._trusted_config_file(source)
            source_stat = source.stat()
            snapshot_name = f"{index}.config"
            self._durable_copy(source, config_dir / snapshot_name)
            config_manifest.append(
                {
                    "source": str(source),
                    "snapshot": snapshot_name,
                    "uid": source_stat.st_uid,
                    "gid": source_stat.st_gid,
                    "mode": stat.S_IMODE(source_stat.st_mode),
                    "sha256": sha256_file(config_dir / snapshot_name),
                }
            )
        self._write_json(tx / "configuration-manifest.json", config_manifest)
        previous_versions = self.previous_versions or self.read_installed_versions()
        self._write_json(tx / "previous-versions.json", previous_versions)
        self._write_json(
            tx / "previous-runtime.json",
            {
                "coordinator_version": previous_versions["coordinator"],
                "gateway_version": previous_versions["gateway"],
                "advertised_version": self.config_update.previous_version,
            },
        )
        current_state = self.state_root / "current-release.json"
        state_manifest = {"existed": _path_entry_exists(current_state)}
        if state_manifest["existed"]:
            self._trusted_regular_file(current_state, "installed release state", private=True)
            self._durable_copy(current_state, tx / "previous-current-release.json")
            state_manifest["sha256"] = sha256_file(tx / "previous-current-release.json")
        self._write_json(tx / "state-manifest.json", state_manifest)
        catalog_manifest: dict[str, object] = {"owns_catalog": False}
        if release.catalog is not None:
            catalog_root = self.install_root / "autotune"
            current = catalog_root / "current"
            previous = catalog_root / ".previous-target"
            current_target: str | None = None
            if _path_entry_exists(current):
                current_info = current.lstat()
                if not stat.S_ISLNK(current_info.st_mode):
                    raise UpdateError("catalog current pointer is not a symlink")
                current_target = os.readlink(current)
                self._validate_catalog_target(current_target)
            previous_target: str | None = None
            if _path_entry_exists(previous):
                previous_target = _read_trusted_text(
                    previous,
                    "catalog previous pointer",
                    trusted_uid=self.trusted_uid,
                ).strip()
                if previous_target:
                    self._validate_catalog_target(previous_target)
            candidate_directory_name = self._catalog_release_directory_name(release)
            candidate_path = catalog_root / "releases" / candidate_directory_name
            legacy_tier2 = self.install_root / "tier2-catalog.json"
            legacy_tier2_manifest: dict[str, object] = {"existed": _path_entry_exists(legacy_tier2)}
            if legacy_tier2_manifest["existed"]:
                legacy_info = self._trusted_regular_file(legacy_tier2, "legacy Tier-2 catalog")
                self._durable_copy(legacy_tier2, tx / "previous-tier2-catalog.json")
                legacy_tier2_manifest.update(
                    {
                        "sha256": sha256_file(tx / "previous-tier2-catalog.json"),
                        "uid": legacy_info.st_uid,
                        "gid": legacy_info.st_gid,
                        "mode": stat.S_IMODE(legacy_info.st_mode),
                    }
                )
            catalog_manifest = {
                "owns_catalog": True,
                "current_target": current_target,
                "previous_target": previous_target,
                "candidate_existed": _path_entry_exists(candidate_path),
                "candidate_release_id": candidate_directory_name,
                "legacy_tier2": legacy_tier2_manifest,
            }
        self._write_json(tx / "catalog-manifest.json", catalog_manifest)
        db_dir = tx / "databases"
        db_dir.mkdir(mode=0o700)
        manifest = []
        for index, source in enumerate(self.databases):
            entry = source.lstat() if _path_entry_exists(source) else None
            if entry is not None:
                if not stat.S_ISREG(entry.st_mode) or entry.st_nlink != 1:
                    raise UpdateError(f"database snapshot source is not a safe regular file: {source}")
                destination = db_dir / f"{index}.sqlite"
                self.sqlite_backup(source, destination)
                manifest.append(
                    {
                        "source": str(source),
                        "existed": True,
                        "snapshot": destination.name,
                        "uid": entry.st_uid,
                        "gid": entry.st_gid,
                        "mode": stat.S_IMODE(entry.st_mode),
                        "sha256": sha256_file(destination),
                    }
                )
            else:
                manifest.append({"source": str(source), "existed": False})
        self._write_json(tx / "database-manifest.json", manifest)
        self._write_json(tx / "component-manifest.json", component_manifest)
        for directory in (config_dir, db_dir, tx, transactions_root, self.state_root):
            _fsync_directory(directory)
        self.transaction = tx
        self._journal_transition(
            "snapshot_ready",
            transaction=str(tx),
            rollback_armed=False,
            live_mutation_started=False,
        )
        return tx

    def atomic_replace(self, source: Path, destination: Path, *, uid: int, gid: int, mode: int) -> None:
        self._journal_transition(
            "file_replace_pending",
            pending_action={"kind": "file_replace", "destination": str(destination)},
        )
        temporary = destination.with_name(
            f".{destination.name}.pearl-updater-{os.getpid()}-{time.time_ns()}"
        )
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
        if not hasattr(os, "O_NOFOLLOW"):
            raise UpdateError("this platform cannot safely stage updater files")
        descriptor = os.open(temporary, flags | os.O_NOFOLLOW, mode)
        try:
            with source.open("rb") as input_handle, os.fdopen(descriptor, "wb", closefd=False) as output:
                shutil.copyfileobj(input_handle, output)
                output.flush()
                os.fchown(descriptor, uid, gid)
                os.fchmod(descriptor, mode)
                os.fsync(descriptor)
            os.replace(temporary, destination)
            _fsync_directory(destination.parent)
        finally:
            os.close(descriptor)
            temporary.unlink(missing_ok=True)
        self._journal_transition("file_replace_complete", pending_action=None)

    def atomic_install(self, source: Path, destination: Path) -> None:
        self._trusted_regular_file(destination, f"installed {destination.name} binary")
        expected_sha256 = sha256_file(source)
        self.atomic_replace(
            source,
            destination,
            uid=self.trusted_uid,
            gid=self.backend_gid,
            mode=0o750,
        )
        installed = self._trusted_regular_file(destination, f"installed {destination.name} binary")
        if (
            installed.st_gid != self.backend_gid
            or stat.S_IMODE(installed.st_mode) != 0o750
            or sha256_file(destination) != expected_sha256
        ):
            raise UpdateError(
                f"installed {destination.name} ownership, mode, or checksum is invalid"
            )

    @staticmethod
    def _validate_catalog_target(target: str) -> None:
        if not re.fullmatch(r"releases/[A-Za-z0-9][A-Za-z0-9._-]{0,191}", target):
            raise UpdateError(f"unsafe catalog pointer target: {target!r}")

    @staticmethod
    def _catalog_release_content_digest(release: Release) -> str:
        if release.catalog is None:
            raise UpdateError("Pearl runtime release is not catalog-bound")
        digest = hashlib.sha256()
        for name in CATALOG_ASSETS:
            asset_digest = release.catalog.files.get(name, "")
            if not SHA256_RE.fullmatch(asset_digest):
                raise UpdateError(f"catalog release {name} checksum is invalid")
            digest.update(name.encode("utf-8"))
            digest.update(b"\0")
            digest.update(asset_digest.encode("ascii"))
            digest.update(b"\n")
        return digest.hexdigest()

    @staticmethod
    def _catalog_release_directory_name(release: Release) -> str:
        if release.catalog is None:
            raise UpdateError("Pearl runtime release is not catalog-bound")
        manifest_digest = release.catalog.files.get("release.json", "")
        if not SHA256_RE.fullmatch(manifest_digest):
            raise UpdateError("catalog release manifest checksum is invalid")
        content_digest = Updater._catalog_release_content_digest(release)
        return f"{release.catalog.release_id}-{content_digest[:16]}"

    def _current_tier2_catalog_path(self) -> Path:
        return self.install_root / "autotune" / "current" / "tier2-catalog.json"

    def _legacy_tier2_catalog_path(self) -> Path:
        return self.install_root / "tier2-catalog.json"

    def _preflight_legacy_tier2_cutover(self) -> None:
        legacy = self._legacy_tier2_catalog_path()
        legacy_exists = _path_entry_exists(legacy)
        if not legacy_exists:
            return
        self._trusted_regular_file(legacy, "legacy Tier-2 catalog")
        catalog_root = self.install_root / "autotune"
        releases = catalog_root / "releases"
        current_pointer = self.install_root / "autotune" / "current"
        try:
            current_pointer_info = current_pointer.lstat()
        except OSError as exc:
            raise UpdateError("legacy Tier-2 catalog exists without a valid current catalog pointer") from exc
        if not stat.S_ISLNK(current_pointer_info.st_mode):
            raise UpdateError("legacy Tier-2 catalog exists without a valid current catalog pointer")
        current_target = os.readlink(current_pointer)
        self._validate_catalog_target(current_target)
        current_release = catalog_root / current_target
        self._assert_catalog_directory(catalog_root, "installed catalog root")
        self._assert_catalog_directory(releases, "installed catalog releases directory")
        self._assert_catalog_directory(current_release, "installed catalog release")
        current = current_release / "tier2-catalog.json"
        self._assert_catalog_asset(current, "active release-bound Tier-2 catalog")
        if sha256_file(legacy) != sha256_file(current):
            raise UpdateError("legacy Tier-2 catalog does not match the active release-bound catalog")

    def _remove_legacy_tier2_catalog(self) -> None:
        legacy = self._legacy_tier2_catalog_path()
        try:
            entry = legacy.lstat()
        except FileNotFoundError:
            return
        except OSError as exc:
            raise UpdateError(f"cannot inspect legacy Tier-2 catalog {legacy}: {exc}") from exc
        if not stat.S_ISREG(entry.st_mode):
            raise UpdateError(f"legacy Tier-2 catalog is not a regular file: {legacy}")
        self._trusted_regular_file(legacy, "legacy Tier-2 catalog")
        legacy.unlink()
        _fsync_directory(legacy.parent)

    def _replace_catalog_pointer(self, name: str, target: str | None) -> None:
        catalog_root = self.install_root / "autotune"
        destination = catalog_root / name
        if target is None:
            destination.unlink(missing_ok=True)
            _fsync_directory(catalog_root)
            return
        self._validate_catalog_target(target)
        temporary = catalog_root / f".{name}.pearl-updater-{os.getpid()}-{time.time_ns()}"
        temporary.unlink(missing_ok=True)
        os.symlink(target, temporary)
        os.replace(temporary, destination)
        _fsync_directory(catalog_root)

    def install_catalog(self, release: Release) -> None:
        if release.catalog is None:
            raise UpdateError("Pearl runtime release is not catalog-bound")
        self._preflight_legacy_tier2_cutover()
        catalog_root = self.install_root / "autotune"
        releases = catalog_root / "releases"
        for directory in (catalog_root, releases):
            self._repair_catalog_directory(directory, "catalog release directory")
        directory_name = self._catalog_release_directory_name(release)
        destination = releases / directory_name
        if _path_entry_exists(destination):
            _trusted_directory(
                destination,
                "immutable catalog release",
                trusted_uid=self.trusted_uid,
                mode=None,
            )
            installed_assets: list[Path] = []
            for name in CATALOG_ASSETS:
                existing = destination / name
                self._trusted_regular_file(existing, f"installed catalog asset {name}")
                if sha256_file(existing) != release.catalog.files[name]:
                    raise UpdateError(f"catalog release ID {release.catalog.release_id} already exists with different bytes")
                installed_assets.append(existing)
            self._repair_catalog_directory(destination, "immutable catalog release")
            for existing in installed_assets:
                os.chown(
                    existing,
                    self.trusted_uid,
                    self.catalog_gid,
                    follow_symlinks=False,
                )
                os.chmod(existing, 0o640, follow_symlinks=False)
                self._assert_catalog_asset(existing, f"installed catalog asset {existing.name}")
        else:
            stage = releases / f".stage-{directory_name}-{os.getpid()}-{time.time_ns()}"
            stage.mkdir(mode=0o700)
            self._repair_catalog_directory(stage, "catalog release staging directory")
            try:
                for name in CATALOG_ASSETS:
                    self.atomic_replace(
                        release.directory / name,
                        stage / name,
                        uid=self.trusted_uid,
                        gid=self.catalog_gid,
                        mode=0o640,
                    )
                    self._assert_catalog_asset(stage / name, f"staged catalog asset {name}")
                _fsync_directory(stage)
                os.replace(stage, destination)
                _fsync_directory(releases)
                self._assert_catalog_directory(destination, "immutable catalog release")
                for name in CATALOG_ASSETS:
                    self._assert_catalog_asset(destination / name, f"installed catalog asset {name}")
            finally:
                if _path_entry_exists(stage):
                    shutil.rmtree(stage)
        current = catalog_root / "current"
        old_target: str | None = None
        if _path_entry_exists(current):
            if not stat.S_ISLNK(current.lstat().st_mode):
                raise UpdateError("catalog current pointer is not a symlink")
            old_target = os.readlink(current)
            self._validate_catalog_target(old_target)
        previous = catalog_root / ".previous-target"
        previous_payload = ((old_target or "") + "\n").encode("utf-8")
        _secure_atomic_write(
            previous,
            previous_payload,
            mode=0o640,
            uid=self.trusted_uid,
            gid=self.catalog_gid,
        )
        self._replace_catalog_pointer("current", f"releases/{directory_name}")
        self._remove_legacy_tier2_catalog()
        self.audit(
            "release_catalog_installed",
            "success",
            catalog_release_id=release.catalog.release_id,
            previous_target=old_target or "",
        )

    def install_release(self, release: Release) -> None:
        if self.config_update is None:
            raise UpdateError("coordinator config update was not prepared")
        for component_name, component in (
            ("coordinator", release.coordinator),
            ("gateway", release.gateway),
        ):
            candidate = release.directory / component.asset
            self._trusted_regular_file(candidate, f"staged {component_name} binary")
            if sha256_file(candidate) != component.sha256:
                raise UpdateError(f"staged {component_name} binary changed after signature verification")
        self._trusted_config_file(self.config_update.target)
        if sha256_file(self.config_update.target) != self.config_update.original_sha256:
            raise UpdateError("coordinator advertised-version config changed after snapshot")
        if self.config_update.catalog_target is not None:
            self._trusted_config_file(self.config_update.catalog_target)
            if (
                self.config_update.catalog_original_sha256 is not None
                and sha256_file(self.config_update.catalog_target) != self.config_update.catalog_original_sha256
            ):
                raise UpdateError("coordinator Tier-2 catalog config changed after snapshot")
        self.atomic_install(release.directory / release.coordinator.asset, self.install_root / "coordinator")
        self.audit("release_component_installed", "success", candidate=release.tag, component="coordinator")
        self.atomic_install(release.directory / release.gateway.asset, self.install_root / "gateway")
        self.audit("release_component_installed", "success", candidate=release.tag, component="gateway")
        if release.catalog is not None:
            self.install_catalog(release)
        installed_config_targets = []
        for staged, destination in (
            (self.config_update.staged, self.config_update.target),
            (self.config_update.catalog_staged, self.config_update.catalog_target),
        ):
            if staged is None or destination is None or destination in installed_config_targets:
                continue
            target_stat = destination.stat()
            self.atomic_replace(
                staged,
                destination,
                uid=target_stat.st_uid,
                gid=target_stat.st_gid,
                mode=stat.S_IMODE(target_stat.st_mode),
            )
            installed_config_targets.append(destination)
        self.cutover_monotonic_us = time.monotonic_ns() // 1000
        self.audit(
            "coordinator_config_installed",
            "success",
            candidate=release.tag,
            target=str(self.config_update.target),
            catalog_target=(
                str(self.config_update.catalog_target)
                if self.config_update.catalog_target is not None
                else ""
            ),
            advertised_version=self.config_update.next_version,
            tier2_catalog_path=self.config_update.next_catalog_path or "",
        )

    @staticmethod
    def coordinator_identity_ready(health: dict[str, Any], identity: RuntimeIdentity) -> bool:
        if health.get("status") != "ok" or health.get("version") != identity.coordinator_version:
            return False
        if "recommended_binary_version" not in health:
            return LEGACY_GIT_DESCRIBE_RE.fullmatch(identity.coordinator_version) is not None
        return health["recommended_binary_version"] == identity.advertised_version

    def local_coordinator_identity_ready(self, identity: RuntimeIdentity, require_pool: bool) -> bool:
        health = self.get_json("http://127.0.0.1:8444/healthz")
        if not self.coordinator_identity_ready(health, identity):
            return False
        return not require_pool or (
            type(health.get("pool_ready")) is int
            and health["pool_ready"] > 0
            and type(health.get("pool_policy_ready")) is int
            and health["pool_policy_ready"] > 0
        )

    def local_gateway_identity_ready(self, identity: RuntimeIdentity) -> bool:
