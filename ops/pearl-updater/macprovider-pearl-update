        *,
        public_key: Path = PINNED_PUBLIC_KEY,
        install_root: Path = INSTALL_ROOT,
        state_root: Path = STATE_ROOT,
        audit_path: Path = AUDIT_PATH,
        lock_path: Path = LOCK_PATH,
        gateway_db: Path | None = None,
        databases: tuple[Path, ...] = (),
        gate_state_root: Path = GATE_STATE_ROOT,
        boot_id_path: Path = BOOT_ID_PATH,
        trusted_uid: int = 0,
        candidate_uid: int | None = None,
        candidate_gid: int | None = None,
        catalog_gid: int | None = None,
        independent_alert_gid: int | None = None,
        isolate_candidate_network: bool = False,
        catalog_verifier: Path = CATALOG_RELEASE_VERIFIER,
        catalog_canary_proof: Path = CATALOG_CANARY_PROOF,
