#!/usr/bin/env python3
"""Fail closed when a protected Pearl service starts during an active transaction."""

from __future__ import annotations

import json
import fcntl
import os
import re
import stat
import sys
import time
from pathlib import Path


DEFAULT_JOURNAL = Path("/var/lib/macprovider-pearl-updater/active-transaction.json")
DEFAULT_GATE_ROOT = Path("/run/macprovider-pearl-updater")
DEFAULT_BOOT_ID = Path("/proc/sys/kernel/random/boot_id")
DEFAULT_LOCK = Path("/run/lock/macprovider-pearl-updater.lock")
GATED_UNITS = {
    "macprovider-coordinator.service",
    "macprovider-gateway.service",
    "canary-buyer.service",
    "macprovider-archive-rotate.service",
    "stats-billing-mirror.service",
}
TEST_GATED_UNIT = "macprovider-pearl-gate-test.service"


class GateError(RuntimeError):
    pass


def path_entry(path: Path) -> os.stat_result | None:
    try:
        return path.lstat()
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise GateError(f"cannot inspect {path}: {exc}") from exc


def trusted_directory(path: Path, uid: int) -> None:
    entry = path_entry(path)
    if entry is None or not stat.S_ISDIR(entry.st_mode) or entry.st_uid != uid:
        raise GateError(f"transaction gate directory is unavailable or untrusted: {path}")
    if stat.S_IMODE(entry.st_mode) != 0o700:
        raise GateError(f"transaction gate directory mode must be 0700: {path}")


def trusted_json(path: Path, uid: int) -> dict[str, object]:
    before = path_entry(path)
    if before is None or not stat.S_ISREG(before.st_mode):
        raise GateError(f"transaction gate file is unavailable or unsafe: {path}")
    if before.st_uid != uid or before.st_nlink != 1 or stat.S_IMODE(before.st_mode) != 0o600:
        raise GateError(f"transaction gate file must be owner-only with one link: {path}")
    if not hasattr(os, "O_NOFOLLOW"):
        raise GateError("platform cannot safely open transaction gate state")
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
            raise GateError(f"transaction gate file changed while opening: {path}")
        with os.fdopen(descriptor, "r", encoding="utf-8", closefd=False) as handle:
            raw = handle.read(64 * 1024 + 1)
    finally:
        os.close(descriptor)
    if len(raw) > 64 * 1024:
        raise GateError(f"transaction gate file exceeds 64 KiB: {path}")
    try:
        payload = json.loads(raw)
    except ValueError as exc:
        raise GateError(f"transaction gate file is invalid JSON: {path}") from exc
    if not isinstance(payload, dict):
        raise GateError(f"transaction gate file is not an object: {path}")
    return payload


def read_boot_id(path: Path, uid: int) -> str:
    before = path_entry(path)
    if before is None or not stat.S_ISREG(before.st_mode) or before.st_uid != uid:
        raise GateError("kernel boot identifier is unavailable or untrusted")
    if not hasattr(os, "O_NOFOLLOW"):
        raise GateError("platform cannot safely read the kernel boot identifier")
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        after = os.fstat(descriptor)
        if (
            not stat.S_ISREG(after.st_mode)
            or after.st_uid != uid
            or (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino)
        ):
            raise GateError("kernel boot identifier changed while opening")
        with os.fdopen(descriptor, "r", encoding="utf-8", closefd=False) as handle:
            value = handle.read(129)
    finally:
        os.close(descriptor)
    if len(value) > 128:
        raise GateError("kernel boot identifier is overlong")
    value = value.strip()
    if not re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", value):
        raise GateError("kernel boot identifier is invalid")
    return value


def require_active_updater_lock(path: Path, uid: int) -> None:
    before = path_entry(path)
    if (
        before is None
        or not stat.S_ISREG(before.st_mode)
        or before.st_uid != uid
        or before.st_nlink != 1
        or stat.S_IMODE(before.st_mode) != 0o600
    ):
        raise GateError("active updater lock is unavailable or untrusted")
    if not hasattr(os, "O_NOFOLLOW"):
        raise GateError("platform cannot safely inspect the active updater lock")
    descriptor = os.open(path, os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
            raise GateError("active updater lock changed while opening")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        raise GateError("active Pearl transaction has no running updater/reconciler")
    finally:
        os.close(descriptor)


def consume_permit(unit: str, journal: dict[str, object], gate_root: Path, boot_id: str, uid: int) -> None:
    permit_directory = gate_root / "permits"
    trusted_directory(gate_root, uid)
    trusted_directory(permit_directory, uid)
    permit = permit_directory / f"{unit}.json"
    consumed = permit_directory / f".{unit}.consumed-{os.getpid()}-{time.time_ns()}"
    try:
        os.rename(permit, consumed)
    except FileNotFoundError as exc:
        raise GateError(f"active Pearl transaction blocks {unit}: no single-use permit") from exc
    try:
        payload = trusted_json(consumed, uid)
        now = int(time.time())
        expected_transaction = journal.get("transaction_id")
        expected_boot = journal.get("boot_id")
        if payload.get("schema_version") != 1 or payload.get("unit") != unit:
            raise GateError("transaction start permit schema/unit mismatch")
        if payload.get("transaction_id") != expected_transaction:
            raise GateError("transaction start permit belongs to another transaction")
        if payload.get("boot_id") != expected_boot or expected_boot != boot_id:
            raise GateError("transaction start permit belongs to another boot")
        expires_at = payload.get("expires_at")
        if type(expires_at) is not int or expires_at < now or expires_at > now + 600:
            raise GateError("transaction start permit is stale or overlong")
        nonce = payload.get("nonce")
        if not isinstance(nonce, str) or not re.fullmatch(r"[0-9a-f]{64}", nonce):
            raise GateError("transaction start permit nonce is invalid")
    finally:
        consumed.unlink(missing_ok=True)
        descriptor = os.open(permit_directory, os.O_RDONLY | os.O_CLOEXEC)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)


def main(argv: list[str]) -> int:
    testing = os.environ.get("MACPROVIDER_UPDATER_GATE_TESTING") == "1"
    if len(argv) != 1 or (argv[0] not in GATED_UNITS and not (testing and argv[0] == TEST_GATED_UNIT)):
        raise GateError("expected one protected systemd unit name")
    journal = Path(os.environ.get("PEARL_UPDATER_GATE_JOURNAL", str(DEFAULT_JOURNAL)))
    gate_root = Path(os.environ.get("PEARL_UPDATER_GATE_ROOT", str(DEFAULT_GATE_ROOT)))
    boot_path = Path(os.environ.get("PEARL_UPDATER_GATE_BOOT_ID", str(DEFAULT_BOOT_ID)))
    lock_path = Path(os.environ.get("PEARL_UPDATER_GATE_LOCK", str(DEFAULT_LOCK)))
    if not testing and (
        journal != DEFAULT_JOURNAL
        or gate_root != DEFAULT_GATE_ROOT
        or boot_path != DEFAULT_BOOT_ID
        or lock_path != DEFAULT_LOCK
    ):
        raise GateError("transaction gate path overrides are test-only")
    uid = os.geteuid() if testing else 0
    if path_entry(journal) is None:
        return 0
    trusted_directory(journal.parent, uid)
    journal_payload = trusted_json(journal, uid)
    if journal_payload.get("schema_version") != 1:
        raise GateError("active Pearl transaction journal schema is unsupported")
    transaction_id = journal_payload.get("transaction_id")
    if not isinstance(transaction_id, str) or not re.fullmatch(r"[0-9a-f]{64}", transaction_id):
        raise GateError("active Pearl transaction identifier is invalid")
    boot_id = read_boot_id(boot_path, uid)
    require_active_updater_lock(lock_path, uid)
    consume_permit(argv[0], journal_payload, gate_root, boot_id, uid)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except GateError as exc:
        print(f"macprovider-pearl-update-gate: {exc}", file=sys.stderr)
        raise SystemExit(1)
