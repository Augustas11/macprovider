#!/usr/bin/env python3
"""Send an updater failure through Pearl's existing independent Gmail channel."""

from __future__ import annotations

import argparse
import os
import re
import smtplib
import socket
import ssl
import stat
import sys
from email.message import EmailMessage
from pathlib import Path


DEFAULT_ENV = Path("/etc/macprovider/monitor.env")
REQUIRED_KEYS = ("ALERT_EMAIL", "GMAIL_USER", "GMAIL_APP_PASSWORD")
KEY_RE = re.compile(r"^[A-Z][A-Z0-9_]*$")


class AlertError(RuntimeError):
    pass


def validate_ancestor(path: Path, *, uid: int, gid: int | None, exact_mode: int | None) -> None:
    try:
        entry = path.lstat()
    except OSError as exc:
        raise AlertError(f"cannot inspect independent-alert config ancestor {path}: {exc}") from exc
    if not stat.S_ISDIR(entry.st_mode) or entry.st_uid != uid:
        raise AlertError(f"independent-alert config ancestor is not a trusted directory: {path}")
    if gid is not None and entry.st_gid != gid:
        raise AlertError(f"independent-alert config ancestor has the wrong group: {path}")
    mode = stat.S_IMODE(entry.st_mode)
    if exact_mode is not None and mode != exact_mode:
        raise AlertError(f"independent-alert config ancestor mode must be {exact_mode:04o}: {path}")
    if exact_mode is None and mode & 0o022:
        raise AlertError(f"independent-alert config ancestor is writable by group or other: {path}")


def load_env(path: Path) -> dict[str, str]:
    try:
        before = path.lstat()
    except OSError as exc:
        raise AlertError(f"cannot inspect independent-alert config {path}: {exc}") from exc
    if not stat.S_ISREG(before.st_mode):
        raise AlertError(f"independent-alert config is not a regular file: {path}")
    testing = os.environ.get("MACPROVIDER_UPDATER_ALERT_TESTING") == "1"
    expected_uid = os.geteuid() if testing else 0
    expected_gid = os.getegid()
    if testing:
        validate_ancestor(path.parent, uid=expected_uid, gid=expected_gid, exact_mode=0o750)
    else:
        validate_ancestor(Path("/etc"), uid=0, gid=None, exact_mode=None)
        validate_ancestor(path.parent, uid=0, gid=expected_gid, exact_mode=0o750)
    if before.st_uid != expected_uid or before.st_gid != expected_gid or before.st_nlink != 1:
        raise AlertError("independent-alert config must have the exact trusted owner/group and one link")
    if stat.S_IMODE(before.st_mode) != 0o640:
        raise AlertError("independent-alert config mode must be 0640")
    if not hasattr(os, "O_NOFOLLOW"):
        raise AlertError("this platform cannot safely read independent-alert config")
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
            raise AlertError("independent-alert config changed while opening")
        if (
            not stat.S_ISREG(after.st_mode)
            or after.st_uid != expected_uid
            or after.st_gid != expected_gid
            or after.st_nlink != 1
            or stat.S_IMODE(after.st_mode) != 0o640
        ):
            raise AlertError("independent-alert config changed to an unsafe file")
        with os.fdopen(descriptor, encoding="utf-8", closefd=False) as handle:
            raw = handle.read(64 * 1024 + 1)
    finally:
        os.close(descriptor)
    if len(raw) > 64 * 1024:
        raise AlertError("independent-alert config exceeds 64 KiB")
    values: dict[str, str] = {}
    for number, source in enumerate(raw.splitlines(), 1):
        line = source.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise AlertError(f"{path}:{number}: expected KEY=VALUE")
        key, value = (part.strip() for part in line.split("=", 1))
        if not KEY_RE.fullmatch(key) or key in values:
            raise AlertError(f"{path}:{number}: invalid or duplicate key")
        values[key] = value
    missing = [key for key in REQUIRED_KEYS if not values.get(key)]
    if missing:
        raise AlertError(f"independent Gmail alert is not configured: {missing[0]} is empty")
    return values


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check-config", action="store_true")
    parser.add_argument("--env-file", type=Path, default=DEFAULT_ENV, help=argparse.SUPPRESS)
    parser.add_argument("unit")
    args = parser.parse_args(argv)
    if args.env_file != DEFAULT_ENV and os.environ.get("MACPROVIDER_UPDATER_ALERT_TESTING") != "1":
        raise AlertError("--env-file is test-only")
    if not re.fullmatch(r"[A-Za-z0-9_.@:-]{1,200}", args.unit):
        raise AlertError("failed unit name is invalid")
    return args


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    values = load_env(args.env_file)
    if args.check_config:
        print("independent Gmail alert configuration is present")
        return 0
    message = f"Pearl updater unit {args.unit} failed; automatic reconciliation may be in progress"
    print(f"[CRITICAL] {message}", flush=True)
    email = EmailMessage()
    email["From"] = values["GMAIL_USER"]
    email["To"] = values["ALERT_EMAIL"]
    email["Subject"] = f"[macprovider CRITICAL] {socket.gethostname()}: updater failed"
    email.set_content(
        message
        + "\n\nInspect macprovider-pearl-updater, its reconcile unit, and "
        "/var/lib/macprovider-pearl-updater/active-transaction.json.\n"
    )
    try:
        with smtplib.SMTP("smtp.gmail.com", 587, timeout=10) as smtp:
            smtp.starttls(context=ssl.create_default_context())
            smtp.login(values["GMAIL_USER"], values["GMAIL_APP_PASSWORD"])
            smtp.send_message(email)
    except Exception as exc:
        raise AlertError(f"independent Gmail alert delivery failed: {exc}") from exc
    print(f"emailed updater failure to {values['ALERT_EMAIL']}", flush=True)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except AlertError as exc:
        print(f"macprovider-pearl-updater-alert: {exc}", file=sys.stderr)
        raise SystemExit(1)
