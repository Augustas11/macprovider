[Unit]
Description=Install a verified macprovider coordinator/gateway release on Pearl
Documentation=https://github.com/Augustas11/macprovider/blob/main/ops/runbooks/pearl-release-updater.md
After=network-online.target
Wants=network-online.target
RefuseManualStop=yes
OnFailure=macprovider-pearl-updater-alert@%n.service
OnFailureJobMode=replace-irreversibly

[Service]
Type=oneshot
User=root
Group=root
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/local/sbin/macprovider-pearl-update --apply
ExecStopPost=/usr/local/sbin/macprovider-pearl-update --reconcile
TimeoutStartSec=infinity
TimeoutStopSec=infinity
UMask=0077
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
LockPersonality=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=macprovider-pearl-updater
