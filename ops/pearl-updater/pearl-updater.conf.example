# The service refuses --apply until this is explicitly changed to 1.
PEARL_UPDATER_ENABLED=0

# Policy floor for candidate selection. The installed coordinator/gateway pair
# and durable updater state are inspected independently; this value never
# substitutes for an unknown installed version.
PEARL_UPDATER_MINIMUM_VERSION=1.8.26

# Default fail-closed guard. Change to 1 only after every connected provider is
# known to implement graceful coordinator drain/reconnect. The updater still
# stops the gateway, waits for buyer reservations to reach zero, then stops the
# coordinator gracefully.
PEARL_UPDATER_ALLOW_PROVIDER_DRAIN=0

PEARL_UPDATER_DOWNLOAD_ATTEMPTS=3
PEARL_UPDATER_RETRY_BACKOFF_S=3
PEARL_UPDATER_REQUEST_TIMEOUT_S=30
PEARL_UPDATER_DOWNLOAD_TIMEOUT_S=300
PEARL_UPDATER_GATEWAY_DRAIN_TIMEOUT_S=90
PEARL_UPDATER_GATEWAY_DRAIN_STEADY_S=5
PEARL_UPDATER_PROVIDER_RECOVERY_TIMEOUT_S=240
PEARL_UPDATER_SERVICE_HEALTH_TIMEOUT_S=60
PEARL_UPDATER_CANARY_TIMEOUT_S=720
PEARL_UPDATER_REVOKED_VERSIONS_FILE=/etc/macprovider/pearl-updater.revoked

# Required for plan/apply. This is the Better Stack heartbeat API resource ID,
# not the secret ping URL used by canary-buyer.service.
PEARL_UPDATER_DEADMAN_HEARTBEAT_ID=
# Root-owned 0600 file containing a Better Stack Uptime API bearer token with
# permission to read/update the heartbeat resource above.
PEARL_UPDATER_DEADMAN_API_TOKEN_FILE=/etc/macprovider/pearl-updater.betterstack-token
