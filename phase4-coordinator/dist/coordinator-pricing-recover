def foreign_state(allow_journal: bool = False) -> list[str]:
    problems = []
    if os.path.lexists(os.path.join(ROOT, ".coordinator-deploy-rollback")):
        problems.append("coordinator deploy rollback snapshot present (/opt/macprovider/.coordinator-deploy-rollback)")
    for name in ("active-transaction.json", "tier2-enforcement-transaction.json"):
        if os.path.lexists(os.path.join(UPDATER_STATE, name)):
            problems.append(f"Pearl updater transaction present ({name})")
    if not allow_journal and os.path.lexists(JOURNAL):
        problems.append(f"pricing transaction journal present ({JOURNAL}); run --recover-pricing-txn")
    for name in live_tmp_dirs():
        problems.append(f"pricing journal being built by a live process ({name})")
    return problems


def cmd_begin(args: dict) -> int:
    problems = foreign_state()
    if problems:
        raise Refused("; ".join(problems))
    verdict = json.loads(open(args["--verdict"], "rb").read())
    for field in VERDICT_FIELDS:
        if not isinstance(verdict.get(field), str) or not HEX64.fullmatch(verdict[field]):
            raise Refused(f"verdict {field} must be 64 lowercase hex")
    if not isinstance(verdict.get("prior_billing_snapshot_id"), int):
        raise Refused("verdict prior_billing_snapshot_id must be an integer")
    candidate_yaml = open(args["--candidate-yaml"], "rb").read()
    if sha256(candidate_yaml) != verdict["candidate_config_sha256"]:
        raise Refused("candidate yaml is not the verdict's candidate_config_sha256")
    new_current = args["--new-current"]
    if not RELEASE_REF.fullmatch(new_current):
        raise Refused("malformed --new-current")
    candidate_window = open(args["--candidate-window"], "rb").read()

    root_fd = open_dir(ROOT)
    try:
        yaml = read_at(root_fd, CONFIG_NAME)
        yinfo = stat_at(root_fd, CONFIG_NAME)
    finally:
        os.close(root_fd)
    if yaml is None or sha256(yaml) != verdict["prior_config_sha256"]:
        raise Refused("live coordinator.yaml is not the verdict's prior config")
    state = disk_state()
    if state["overlay"]["sha256"] != verdict.get("overlay_sha256", ""):
        raise Refused("live overlay is not the verdict's overlay")
    at_fd = open_dir(AUTOTUNE)
    try:
        window = read_at(at_fd, ".previous-target", 64 * 1024)
        winfo = stat_at(at_fd, ".previous-target")
    finally:
        os.close(at_fd)
    prior_current = state["current"]
    if prior_current is None or prior_current != args["--prior-current"]:
        raise Refused(f"current is {prior_current!r}, not {args['--prior-current']!r}")
    txn = {
        "schema": SCHEMA,
        "id": secrets.token_hex(16),
        "phase": "prepared",
        "created_at": now_iso(),
        "history": [{"phase": "prepared", "at": now_iso()}],
        "prior": {
            "yaml_sha256": sha256(yaml), "yaml_uid": yinfo.st_uid, "yaml_gid": yinfo.st_gid,
            "yaml_mode": stat.S_IMODE(yinfo.st_mode), "current": prior_current,
            "window": ({"present": True, "sha256": sha256(window), "uid": winfo.st_uid, "gid": winfo.st_gid,
                        "mode": stat.S_IMODE(winfo.st_mode)} if window is not None else {"present": False}),
            "release_digests": release_digests(prior_current),
        },
        "candidate": {
            "yaml_sha256": sha256(candidate_yaml), "current": new_current,
            "window": {"present": True, "sha256": sha256(candidate_window)},
            "release_digests": release_digests(new_current),
        },
        "overlay": state["overlay"],
        "verdict": dict({k: verdict[k] for k in VERDICT_FIELDS + ("prior_billing_snapshot_id",)},
                        overlay_sha256=state["overlay"]["sha256"]),
        "restore": None,
    }
    tmp = TMP_PREFIX + self_tag()
    root_fd = open_dir(ROOT)
    try:
        os.mkdir(tmp, 0o700, dir_fd=root_fd)
        tfd = os.open(tmp, DIR_FLAGS, dir_fd=root_fd)
        try:
            os.fchmod(tfd, 0o700)
            write_new_at(tfd, "prior-coordinator.yaml", yaml)
            write_new_at(tfd, "candidate-coordinator.yaml", candidate_yaml)
            if window is not None:
                write_new_at(tfd, "prior-window", window)
            write_new_at(tfd, "candidate-window", candidate_window)
            write_new_at(tfd, "txn.json", (json.dumps(txn, sort_keys=True, indent=1) + "\n").encode())
            os.fsync(tfd)
        finally:
            os.close(tfd)
        os.rename(tmp, JOURNAL_NAME, src_dir_fd=root_fd, dst_dir_fd=root_fd)
        os.fsync(root_fd)
    finally:
        os.close(root_fd)
    print(json.dumps({"journal": txn["id"], "phase": "prepared"}))
    log(f"journal {txn['id']} committed (prepared)")
    return 0


def need_journal() -> Journal:
    j = load_journal()
    if j is None:
        raise Refused(f"no pricing transaction journal at {JOURNAL}")
    return j


def cmd_install_candidate(j: Journal) -> int:
    prior, cand = j.txn["prior"], j.txn["candidate"]
    got = disk_state()
    if got["overlay"] != j.txn["overlay"]:
        raise Mismatch("overlay moved since the journal was written")
    if got["yaml_sha256"] == cand["yaml_sha256"]:
        return 0
    if got["yaml_sha256"] != prior["yaml_sha256"]:
        raise Mismatch("coordinator.yaml moved since the journal was written; not installing")
    data = j.file("candidate-coordinator.yaml")
    if data is None or sha256(data) != cand["yaml_sha256"]:
        raise Stop("journal candidate-coordinator.yaml is missing or corrupt")
    root_fd = open_dir(ROOT)
    try:
        durable_install_at(root_fd, CONFIG_NAME, data, prior["yaml_uid"], prior["yaml_gid"], prior["yaml_mode"],
                           YAML_TMP_PREFIX)
    finally:
        os.close(root_fd)
    log("installed candidate coordinator.yaml")
    return 0


def terminal_check(j: Journal, verifier: str | None) -> None:
    side = TERMINAL[j.phase]
    check_state(j, side, verifier)


def cmd_recover(args: dict) -> int:
    """Operator recovery: the caller holds the lane lock set."""
    cleanup_tmp()
    j = load_journal()
    if j is None:
        print("no pricing transaction journal")
        return 0
    verifier = args.get("--verifier")
    wait = float(args.get("--wait-seconds", "60"))
    prior_snap = j.txn["verdict"]["prior_billing_snapshot_id"]
    log(f"journal {j.txn['id']} phase {j.phase}")
    if j.phase in TERMINAL:
        terminal_check(j, verifier)
        j.finalize()
        print(f"finalized {TERMINAL[j.txn['phase']]} ({j.txn['phase']})")
        return 0
    if j.phase == "restored-unverified":
        restore_disk(j)
        restore = j.txn.get("restore") or {}
        why = live_matches(j, "prior", float(restore.get("wall", 0)), "boot", prior_snap)
        if why is not None:
            why = hup_and_verify(j, "prior", prior_snap, wait)
        if why is not None:
            raise Stop(f"prior pair restored on disk but not proven live: {why}")
        j.set_phase("rolled-back")
        j.finalize()
        print("finalized prior (restored-unverified)")
        return 0
    j.set_phase("rolling-back")
    restore_disk(j)
    if not coordinator_pid():
        j.txn["restore"] = restore_stamp()
        j.set_phase("restored-unverified")
        raise Stop("prior pair restored on disk; the coordinator is not running, so its boot must prove it "
                   "(macprovider-coordinator-pricing-close.service)")
    why = hup_and_verify(j, "prior", prior_snap, wait)
    if why is not None:
        raise Stop(f"prior pair restored on disk and re-HUPed but not proven live: {why}")
    j.set_phase("rolled-back")
    j.finalize()
    print("rolled back to the prior pair and finalized")
    return 0


def restore_stamp() -> dict:
    boot_id = ""
    try:
        boot_id = open(BOOT_ID_FILE).read().strip()
    except OSError:
        pass
    return {"boot_id": boot_id, "nonce": secrets.token_hex(16),
            "monotonic_us": int(time.clock_gettime(time.CLOCK_MONOTONIC) * 1_000_000),
            "wall": time.time(), "at": now_iso()}


def cmd_pre_start() -> int:
    if not os.path.lexists(JOURNAL):
        return 0
    fds = take_locks(0)
    if fds is None:
        log("the lane lock set is held by a live holder; leaving the pricing journal to it")
        return 0
    try:
        cleanup_tmp()
        j = load_journal()
        if j is None:
            return 0
        log(f"pre-start: journal {j.txn['id']} phase {j.phase}")
        if j.phase in TERMINAL:
            terminal_check(j, None)
            j.finalize()
            return 0
        restore_disk(j)
        j.txn["restore"] = restore_stamp()
        j.set_phase("restored-unverified")
        log("prior pair restored before coordinator start; macprovider-coordinator-pricing-close.service "
            "finalizes it from the boot record")
        return 0
    finally:
        for fd in fds:
            os.close(fd)


def cmd_close_restored(args: dict) -> int:
    j = load_journal()
    if j is None or j.phase != "restored-unverified":
        return 0
    nonce = (j.txn.get("restore") or {}).get("nonce")
    j.close()
    fds = take_locks(float(args.get("--lock-wait-seconds", "300")))
    if fds is None:
        raise Stop("could not take the lane lock set to close the restored pricing journal")
    try:
        j = load_journal()
        if j is None or j.phase != "restored-unverified":
            return 0
        restore = j.txn.get("restore") or {}
        if restore.get("nonce") != nonce:
            raise Stop("the restored pricing journal changed while waiting for the lock set")
        boot_id = ""
        try:
            boot_id = open(BOOT_ID_FILE).read().strip()
        except OSError:
            pass
        if not boot_id or boot_id != restore.get("boot_id"):
            raise Stop("the restore was not made in this boot; run --recover-pricing-txn")
        stamp = int(restore.get("monotonic_us", 0))

        def started_after_restore() -> str | None:
            raw = systemctl_show("ActiveEnterTimestampMonotonic")
            if not raw.isdigit() or int(raw) <= stamp:
                return f"{UNIT} has not started since the restore (ActiveEnterTimestampMonotonic={raw or '?'})"
            return None

        why = wait_live(j, "prior", float(restore.get("wall", 0)), "boot",
                        j.txn["verdict"]["prior_billing_snapshot_id"],
                        float(args.get("--wait-seconds", "120")), started_after_restore)
        if why is not None:
            raise Stop(f"the coordinator boot did not prove the restored prior pair: {why}")
        j.set_phase("rolled-back")
        j.finalize()
        return 0
    finally:
        for fd in fds:
            os.close(fd)


def parse(argv: list[str], flags: tuple[str, ...]) -> dict:
    out: dict = {}
    i = 0
    while i < len(argv):
        if argv[i] not in flags or i + 1 >= len(argv):
            raise Refused(f"unexpected argument {argv[i]!r}")
        out[argv[i]] = argv[i + 1]
        i += 2
    return out


def main(argv: list[str]) -> int:
    if not argv:
        raise Refused("usage: coordinator-pricing-recover <command> ...")
    cmd, rest = argv[0], argv[1:]
    if cmd == "--pre-start":
        return cmd_pre_start()
    if cmd == "--close-restored":
        return cmd_close_restored(parse(rest, ("--wait-seconds", "--lock-wait-seconds")))
    if cmd in ("recover", "--recover"):
        return cmd_recover(parse(rest, ("--verifier", "--wait-seconds")))
    if cmd == "begin":
        a = parse(rest, ("--candidate-yaml", "--new-current", "--prior-current", "--candidate-window", "--verdict"))
        if len(a) != 5:
            raise Refused("begin needs --candidate-yaml --new-current --prior-current --candidate-window --verdict")
        return cmd_begin(a)
    if cmd == "foreign-state":
        problems = foreign_state(allow_journal="--allow-journal" in rest)
        for p in problems:
            print(p)
        return 3 if problems else 0
    if cmd == "cleanup-tmp":
        cleanup_tmp()
        return 0
    if cmd == "status":
        j = load_journal()
        print(json.dumps(None if j is None else {"id": j.txn["id"], "phase": j.phase}))
        return 0
    j = need_journal()
    try:
        if cmd == "phase" and len(rest) == 1:
            j.set_phase(rest[0])
        elif cmd == "install-candidate" and not rest:
            cmd_install_candidate(j)
        elif cmd == "check-state" and rest and rest[0] in ("prior", "candidate"):
            check_state(j, rest[0], parse(rest[1:], ("--verifier",)).get("--verifier"))
        elif cmd == "restore-disk" and not rest:
            restore_disk(j)
        elif cmd == "verify-live" and rest and rest[0] in ("prior", "candidate"):
            a = parse(rest[1:], ("--since", "--source", "--snapshot-after", "--wait-seconds"))
            why = wait_live(j, rest[0], float(a.get("--since", "0")), a.get("--source"),
                            int(a.get("--snapshot-after", j.txn["verdict"]["prior_billing_snapshot_id"])),
                            float(a.get("--wait-seconds", "30")))
            if why is not None:
                raise Mismatch(f"{rest[0]} pair not proven live: {why}")
        elif cmd == "finalize" and len(rest) == 1 and rest[0] in ("prior", "candidate"):
            want = "verified" if rest[0] == "candidate" else "rolled-back"
            if j.phase != want:
                raise Refused(f"finalize {rest[0]} needs phase {want}, journal is {j.phase}")
            check_state(j, rest[0])
            j.finalize()
        else:
            raise Refused(f"unknown command {cmd!r}")
    finally:
        j.close()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as exc:
        log(f"refused: {exc}")
        sys.exit(1)
    except Mismatch as exc:
        log(f"state mismatch: {exc}; journal kept; follow {RUNBOOK}")
        sys.exit(3)
    except Stop as exc:
        log(f"STOP: {exc}; journal kept; follow {RUNBOOK}")
        sys.exit(5)
