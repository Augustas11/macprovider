DIR_FLAGS = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | NOFOLLOW
RELEASE_REF = re.compile(r"releases/[A-Za-z0-9][A-Za-z0-9._-]{0,191}")
HEX64 = re.compile(r"[0-9a-f]{64}")
