                  "expected_rate_table_sha256", "expected_signed_rate_card_sha256",
                  "prior_rate_table_sha256", "prior_signed_rate_card_sha256", "prior_config_sha256")
MAX_FILE = 16 << 20


class Refused(Exception):
    """exit 1: refused before changing anything."""


class Mismatch(Exception):
    """exit 3: on-disk state is neither side the journal expects."""


class Stop(Exception):
    """exit 5: stopped with the journal kept."""


def log(msg: str) -> None:
    print("coordinator-pricing-recover: " + msg, file=sys.stderr, flush=True)


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


# ---------------------------------------------------------------------------
# Safe filesystem primitives (NOFOLLOW directory fds, owner/type checks).
# ---------------------------------------------------------------------------
def open_dir(path: str, *, owner_only: bool = False) -> int:
    fd = os.open(path, DIR_FLAGS)
    info = os.fstat(fd)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != REQUIRED_UID or info.st_mode & 0o022:
        os.close(fd)
        raise Refused(f"unsafe directory ownership or permissions: {path}")
    if owner_only and stat.S_IMODE(info.st_mode) != 0o700:
        os.close(fd)
        raise Refused(f"journal directory must be mode 0700: {path}")
    return fd


def read_at(dir_fd: int, name: str, limit: int = MAX_FILE) -> bytes | None:
    """Regular-file bytes via NOFOLLOW; None when absent."""
    try:
        fd = os.open(name, os.O_RDONLY | NOFOLLOW, dir_fd=dir_fd)
    except FileNotFoundError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Mismatch(f"{name} is not a regular file")
        chunks, total = [], 0
        while True:
            chunk = os.read(fd, 1 << 20)
            if not chunk:
                break
            total += len(chunk)
            if total > limit:
                raise Mismatch(f"{name} exceeds {limit} bytes")
            chunks.append(chunk)
        return b"".join(chunks)
    finally:
        os.close(fd)


def stat_at(dir_fd: int, name: str) -> os.stat_result | None:
    try:
        return os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
    except FileNotFoundError:
        return None


def write_new_at(dir_fd: int, name: str, data: bytes, mode: int = 0o600) -> None:
    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW, mode, dir_fd=dir_fd)
    try:
        os.fchmod(fd, mode)
        view = memoryview(data)
        while view:
            view = view[os.write(fd, view):]
        os.fsync(fd)
    finally:
        os.close(fd)


def durable_install_at(dir_fd: int, name: str, data: bytes, uid: int, gid: int, mode: int, tmp_prefix: str) -> None:
    """Same-dir temp + explicit owner/group/mode + fsync + rename + dir fsync."""
    tmp = f"{tmp_prefix}{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW, 0o600, dir_fd=dir_fd)
    try:
        try:
            os.fchown(fd, uid, gid)
            os.fchmod(fd, mode)
            info = os.fstat(fd)
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != uid or info.st_gid != gid
                    or stat.S_IMODE(info.st_mode) != mode or info.st_nlink != 1):
                raise Refused(f"unsafe temp file for {name}")
            view = memoryview(data)
            while view:
                view = view[os.write(fd, view):]
            os.fsync(fd)
        finally:
            os.close(fd)
        os.rename(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dir_fd)
        except FileNotFoundError:
            pass
        raise
    os.fsync(dir_fd)


def fsync_dir(path: str) -> None:
    fd = os.open(path, DIR_FLAGS)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def read_current(autotune_fd: int) -> str | None:
    info = stat_at(autotune_fd, "current")
    if info is None:
        return None
    if not stat.S_ISLNK(info.st_mode):
        raise Mismatch("autotune current is not a symlink")
    target = os.readlink("current", dir_fd=autotune_fd)
    target = target[2:] if target.startswith("./") else target
    if not RELEASE_REF.fullmatch(target):
        raise Mismatch(f"autotune current target is malformed: {target!r}")
    return target


def swap_current(autotune_fd: int, target: str) -> None:
    tmp = f"{CURRENT_TMP_PREFIX}{os.getpid()}"
    try:
        os.unlink(tmp, dir_fd=autotune_fd)
    except FileNotFoundError:
        pass
    os.symlink(target, tmp, dir_fd=autotune_fd)
    os.rename(tmp, "current", src_dir_fd=autotune_fd, dst_dir_fd=autotune_fd)
    os.fsync(autotune_fd)


def release_digests(target: str) -> dict:
    """sha256 of every regular file in the release directory (flat)."""
    if not RELEASE_REF.fullmatch(target):
        raise Mismatch(f"malformed release reference {target!r}")
    out = {}
    fd = open_dir(os.path.join(AUTOTUNE, target))
    try:
        for name in sorted(os.listdir(fd)):
            data = read_at(fd, name)
            if data is None:
                continue
            out[name] = sha256(data)
    finally:
        os.close(fd)
    return out


def starttime(pid: int) -> str | None:
    """Process start time (clock ticks since boot on Linux); None when gone."""
    if os.path.isdir("/proc/self"):
        try:
            raw = open(f"/proc/{pid}/stat", "rb").read().decode("ascii", "replace")
            return raw[raw.rindex(")") + 2:].split()[19]
        except (OSError, ValueError, IndexError):
            return None
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return None
    except PermissionError:
        pass
    out = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True)
    text = out.stdout.strip()
    return sha256(text.encode())[:16] if text else None


def self_tag() -> str:
    return f"{os.getpid()}.{starttime(os.getpid())}"


def tag_is_live(tag: str) -> bool:
    pid, _, start = tag.partition(".")
    if not pid.isdigit() or not start:
        return False
    return starttime(int(pid)) == start


def remove_tree_at(dir_fd: int, name: str) -> None:
    info = stat_at(dir_fd, name)
    if info is None:
        return
    if stat.S_ISDIR(info.st_mode):
        sub = os.open(name, DIR_FLAGS, dir_fd=dir_fd)
        try:
            for child in os.listdir(sub):
                remove_tree_at(sub, child)
        finally:
            os.close(sub)
        os.rmdir(name, dir_fd=dir_fd)
    else:
        os.unlink(name, dir_fd=dir_fd)


def cleanup_tmp() -> list[str]:
    """Remove journal temp dirs whose (pid, starttime) is not a live process,
    leftover finalize renames, and this helper's own stale temp files."""
    removed = []
    for base, prefixes in ((ROOT, (TMP_PREFIX, DONE_PREFIX, YAML_TMP_PREFIX)),
                           (AUTOTUNE, (CURRENT_TMP_PREFIX, WINDOW_TMP_PREFIX))):
        try:
            fd = open_dir(base)
        except FileNotFoundError:
            continue
        try:
            for name in os.listdir(fd):
                if name.startswith(TMP_PREFIX):
                    if tag_is_live(name[len(TMP_PREFIX):]):
                        continue
                elif name.startswith(DONE_PREFIX):
                    pass
                elif any(name.startswith(p) for p in prefixes):
                    pid = name.rsplit(".", 1)[-1]
                    if pid.isdigit() and starttime(int(pid)) is not None:
                        continue
                else:
                    continue
                remove_tree_at(fd, name)
                removed.append(os.path.join(base, name))
            if removed:
                os.fsync(fd)
        finally:
            os.close(fd)
    for path in removed:
        log(f"removed stale {path}")
    return removed


def live_tmp_dirs() -> list[str]:
    try:
        names = os.listdir(ROOT)
    except FileNotFoundError:
        return []
    return [n for n in names if n.startswith(TMP_PREFIX) and tag_is_live(n[len(TMP_PREFIX):])]


# ---------------------------------------------------------------------------
# Journal.
# ---------------------------------------------------------------------------
class Journal:
    def __init__(self) -> None:
        self.root_fd = open_dir(ROOT)
        try:
            self.fd = os.open(JOURNAL_NAME, DIR_FLAGS, dir_fd=self.root_fd)
        except FileNotFoundError:
            os.close(self.root_fd)
            raise
        info = os.fstat(self.fd)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != REQUIRED_UID or stat.S_IMODE(info.st_mode) != 0o700:
            self.close()
            raise Stop(f"journal {JOURNAL} has unsafe ownership or permissions")
        raw = read_at(self.fd, "txn.json")
        if raw is None:
            self.close()
            raise Stop(f"journal {JOURNAL} has no txn.json")
        try:
            self.txn = json.loads(raw)
        except ValueError as exc:
            self.close()
            raise Stop(f"journal txn.json is malformed: {exc}") from exc
        if self.txn.get("schema") != SCHEMA or self.txn.get("phase") not in PHASES:
            self.close()
            raise Stop("journal txn.json has an unknown schema or phase")

    def close(self) -> None:
        for fd in (getattr(self, "fd", None), getattr(self, "root_fd", None)):
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass

    def file(self, name: str) -> bytes | None:
        return read_at(self.fd, name)

    def write_txn(self) -> None:
        data = (json.dumps(self.txn, sort_keys=True, indent=1) + "\n").encode()
        tmp = f".txn.json.{os.getpid()}"
        try:
            os.unlink(tmp, dir_fd=self.fd)
        except FileNotFoundError:
            pass
        write_new_at(self.fd, tmp, data)
        os.rename(tmp, "txn.json", src_dir_fd=self.fd, dst_dir_fd=self.fd)
        os.fsync(self.fd)

    def set_phase(self, phase: str) -> None:
        if phase not in PHASES:
            raise Refused(f"unknown phase {phase}")
        # Terminal phases are monotonic: out of a durable `verified` or
        # `rolled-back` the only step is finalize (a verified price is never
        # rolled back). Re-setting the same phase is an idempotent no-op.
        if self.phase in TERMINAL:
            if phase == self.phase:
                return
            raise Refused(f"journal is {self.phase} (terminal); only finalize {TERMINAL[self.phase]} is allowed, not phase {phase}")
        self.txn["phase"] = phase
        self.txn.setdefault("history", []).append({"phase": phase, "at": now_iso()})
        self.write_txn()
        log(f"journal phase {phase}")

    @property
    def phase(self) -> str:
        return self.txn["phase"]

    def finalize(self) -> None:
        done = f"{DONE_PREFIX}{int(time.time())}.{os.getpid()}"
        os.close(self.fd)
        self.fd = None
        os.rename(JOURNAL_NAME, done, src_dir_fd=self.root_fd, dst_dir_fd=self.root_fd)
        os.fsync(self.root_fd)
        remove_tree_at(self.root_fd, done)
        os.fsync(self.root_fd)
        log(f"journal {self.txn['id']} finalized ({self.txn['phase']})")


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")


def load_journal() -> Journal | None:
    try:
        return Journal()
    except FileNotFoundError:
        return None


# ---------------------------------------------------------------------------
# State S.
# ---------------------------------------------------------------------------
def disk_state() -> dict:
    root_fd = open_dir(ROOT)
    try:
        yaml = read_at(root_fd, CONFIG_NAME)
    finally:
        os.close(root_fd)
    overlay = None
    try:
        etc_fd = open_dir(ETC_ROOT)
        try:
            overlay = read_at(etc_fd, os.path.basename(OVERLAY))
        finally:
            os.close(etc_fd)
    except FileNotFoundError:
        overlay = None
    at_fd = open_dir(AUTOTUNE)
    try:
        current = read_current(at_fd)
        window = read_at(at_fd, ".previous-target", 64 * 1024)
    finally:
        os.close(at_fd)
    return {
        "yaml_sha256": None if yaml is None else sha256(yaml),
        "overlay": {"present": overlay is not None, "sha256": "" if overlay is None else sha256(overlay)},
        "current": current,
        "window_sha256": None if window is None else sha256(window),
    }


def side_state(j: Journal, side: str) -> dict:
    s = j.txn[side]
    return {"yaml_sha256": s["yaml_sha256"], "overlay": j.txn["overlay"], "current": s["current"],
            "window_sha256": s["window"]["sha256"] if s["window"]["present"] else None}


def check_state(j: Journal, side: str, verifier: str | None = None) -> None:
    want, got = side_state(j, side), disk_state()
    diffs = [k for k in want if want[k] != got[k]]
    if not diffs:
        digests = release_digests(got["current"])
        if digests != j.txn[side]["release_digests"]:
            diffs.append("release digest set of " + got["current"])
    if diffs:
        raise Mismatch(f"state is not the journal's {side} pair: {', '.join(diffs)} differ")
    if verifier:
        rc = subprocess.run([sys.executable, "-I", verifier, "verify-directory", "--allow-expired-tier2",
                             "--directory", os.path.join(AUTOTUNE, got["current"])],
                            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        if rc.returncode != 0:
            raise Mismatch(f"verify-directory of {got['current']} failed: {rc.stderr.strip()[-400:]}")


def restore_disk(j: Journal) -> None:
    """CAS each item back to prior, in order yaml, current, window: candidate
    -> prior, prior -> skip, anything else -> Mismatch (nothing further done)."""
    if j.phase in TERMINAL:
        raise Refused(f"journal is {j.phase} (terminal); not restoring")
    prior, cand = j.txn["prior"], j.txn["candidate"]
    got = disk_state()
    if got["overlay"] != j.txn["overlay"]:
        raise Mismatch("overlay differs from the journal; not restoring")
    if got["yaml_sha256"] == prior["yaml_sha256"]:
        pass
    elif got["yaml_sha256"] == cand["yaml_sha256"]:
        data = j.file("prior-coordinator.yaml")
        if data is None or sha256(data) != prior["yaml_sha256"]:
            raise Stop("journal prior-coordinator.yaml is missing or corrupt")
        root_fd = open_dir(ROOT)
        try:
            durable_install_at(root_fd, CONFIG_NAME, data, prior["yaml_uid"], prior["yaml_gid"],
                               prior["yaml_mode"], YAML_TMP_PREFIX)
        finally:
            os.close(root_fd)
        log("restored prior coordinator.yaml")
    else:
        raise Mismatch("coordinator.yaml is neither the journal's prior nor candidate; not restoring")
    at_fd = open_dir(AUTOTUNE)
    try:
        current = read_current(at_fd)
        if current == prior["current"]:
            pass
        elif current == cand["current"]:
            swap_current(at_fd, prior["current"])
            log(f"restored current -> {prior['current']}")
        else:
            raise Mismatch(f"current is {current!r}, neither prior nor candidate; not restoring")
        window = read_at(at_fd, ".previous-target", 64 * 1024)
        wsha = None if window is None else sha256(window)
        psha = prior["window"]["sha256"] if prior["window"]["present"] else None
        csha = cand["window"]["sha256"] if cand["window"]["present"] else None
        if wsha == psha:
            pass
        elif wsha == csha:
            if prior["window"]["present"]:
                data = j.file("prior-window")
                if data is None or sha256(data) != psha:
                    raise Stop("journal prior-window is missing or corrupt")
                durable_install_at(at_fd, ".previous-target", data, prior["window"]["uid"],
                                   prior["window"]["gid"], prior["window"]["mode"], WINDOW_TMP_PREFIX)
            else:
                os.unlink(".previous-target", dir_fd=at_fd)
                os.fsync(at_fd)
            log("restored prior .previous-target")
        else:
            raise Mismatch(".previous-target is neither the journal's prior nor candidate; not restoring")
    finally:
        os.close(at_fd)
    check_state(j, "prior")


# ---------------------------------------------------------------------------
# Coordinator liveness evidence.
# ---------------------------------------------------------------------------
def systemctl_show(prop: str) -> str:
    out = subprocess.run([SYSTEMCTL, "show", "-p", prop, "--value", UNIT], capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else ""


def coordinator_pid() -> int:
    pid = systemctl_show("MainPID")
    return int(pid) if pid.isdigit() else 0


def parse_loaded_at(value: object) -> float | None:
    m = re.fullmatch(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(\.\d+)?Z", str(value or ""))
    if not m:
        return None
    base = datetime.strptime(m.group(1), "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc).timestamp()
    return base + float(m.group(2) or 0)


def fetch(path: str) -> bytes | None:
    try:
        with urllib.request.urlopen(BUYER_URL + path, timeout=10) as resp:
            return resp.read(MAX_FILE + 1) if resp.status == 200 else None
    except OSError:
        return None


def live_matches(j: Journal, side: str, since: float, source: str | None, snapshot_after: int) -> str | None:
    """None when the applied-config record and the served card prove `side`
    is live; otherwise why not."""
    v = j.txn["verdict"]
    want_rate, want_signed = ((v["prior_rate_table_sha256"], v["prior_signed_rate_card_sha256"]) if side == "prior"
                              else (v["expected_rate_table_sha256"], v["expected_signed_rate_card_sha256"]))
    try:
        rec = json.loads(open(RECORD, "rb").read(65536))
    except (OSError, ValueError):
        return "no parseable applied-config record"
    loaded = parse_loaded_at(rec.get("loaded_at"))
    if rec.get("schema") != APPLIED_SCHEMA or loaded is None or loaded < since:
        return f"no applied-config record since {since:.0f} (loaded_at={rec.get('loaded_at')})"
    if source and rec.get("source") != source:
        return f"record source is {rec.get('source')}, want {source}"
    if rec.get("config_sha256") != j.txn[side]["yaml_sha256"]:
        return f"record config_sha256 {rec.get('config_sha256')} is not the {side} yaml"
    if (rec.get("overlay_sha256") or "") != j.txn["overlay"]["sha256"]:
        return "record overlay_sha256 differs from the journal"
    if rec.get("rate_table_sha256") != want_rate or rec.get("signed_rate_card_sha256") != want_signed:
        return (f"record rate_table/signed card {rec.get('rate_table_sha256')}/{rec.get('signed_rate_card_sha256')} "
                f"are not the {side} digests")
    snap = rec.get("billing_snapshot_id")
    if not isinstance(snap, int) or snap <= snapshot_after:
        return f"record billing_snapshot_id {snap} did not advance past {snapshot_after}"
    rel = os.path.join(AUTOTUNE, j.txn[side]["current"])
    for path, name in (("/v1/rate-card", "rate-card.json"), ("/v1/rate-card.sig", "rate-card.json.sig")):
        served = fetch(path)
        if served is None or served != open(os.path.join(rel, name), "rb").read():
            return f"coordinator-served {path} is not the {side} bytes"
    return None


def wait_live(j: Journal, side: str, since: float, source: str | None, snapshot_after: int, seconds: float,
              extra=None) -> str | None:
    deadline = time.monotonic() + seconds
    while True:
        why = extra() if extra else None
        if why is None:
            why = live_matches(j, side, since, source, snapshot_after)
        if why is None or time.monotonic() >= deadline:
            return why
        time.sleep(1)


def hup_and_verify(j: Journal, side: str, snapshot_after: int, seconds: float) -> str | None:
    pid = coordinator_pid()
    if not pid:
        return "coordinator is not running"
    since = time.time()
    os.kill(pid, signal.SIGHUP)
    log(f"sent SIGHUP to {UNIT} (pid {pid})")
    return wait_live(j, side, since, "sighup", snapshot_after, seconds)


# ---------------------------------------------------------------------------
# Locks.
# ---------------------------------------------------------------------------
def open_lock(path: str) -> int:
    """Open one lock of the set exactly as the shared guard's acquire_lock does
    (scripts/lib/coordinator_config_guard.py; this helper is installed
    standalone, so the checks are replicated and a parity test pins them):
    create 0600 when absent, never follow a symlink, then require a regular
    root-owned (or LOCK_REQUIRED_UID/GID) 0600 file with one link. Refused
    when unsafe."""
    if not NOFOLLOW:
        raise Refused("this platform cannot open locks without following symlinks")
    flags = os.O_RDWR | os.O_CLOEXEC | NOFOLLOW
    try:
        fd = os.open(path, flags | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        try:
            fd = os.open(path, flags)
        except OSError as exc:
            raise Refused(f"unsafe coordinator config lock {path}: cannot open safely: {exc}") from exc
    except OSError as exc:
        raise Refused(f"unsafe coordinator config lock {path}: cannot open safely: {exc}") from exc
    info = os.fstat(fd)
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_uid != LOCK_REQUIRED_UID
        or info.st_gid != LOCK_REQUIRED_GID
        or stat.S_IMODE(info.st_mode) != 0o600
        or info.st_nlink != 1
    ):
        os.close(fd)
        raise Refused(f"unsafe coordinator config lock {path}")
    return fd


def take_locks(wait_seconds: float) -> list[int] | None:
    """The lane lock set (updater lock, then coordinator-deploy lock), in
    lease order. None when a safely validated lock is not acquired within
    wait_seconds (0 = -n); Refused (fail closed) when a lock is unsafe."""
    fds: list[int] = []
    deadline = time.monotonic() + wait_seconds
    for path in (GLOBAL_LOCK, DEPLOY_LOCK):
        try:
            fd = open_lock(path)
        except BaseException:
            for f in fds:
                os.close(f)
            raise
        fds.append(fd)
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError as exc:
                if exc.errno not in (errno.EWOULDBLOCK, errno.EAGAIN) or time.monotonic() >= deadline:
                    for f in fds:
                        os.close(f)
                    return None
                time.sleep(0.5)
    return fds


