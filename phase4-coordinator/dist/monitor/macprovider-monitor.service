[Unit]
Description=Mac Provider observability monitor (Phase 7 P2)
After=network-online.target macprovider-coordinator.service
Documentation=https://github.com/Augustas11/macprovider/blob/main/docs/reports/PHASE7_HARDENING_PLAN.md

[Service]
Type=oneshot
# De-rooted (M3-2 / DEVE-7). Runs as the same unprivileged user the
# coordinator runs as so monitor.py reads OPERATOR_KEY from the shared
# env-file instead of regexing /opt/macprovider/coordinator.yaml as root.
User=macprovider
Group=macprovider
Nice=10
# Sandbox (codex PR #73 HIGH-2). Issue #244 R4+R5 tightened
# /opt/macprovider to `root:macprovider 0750` with files inside as
# `root:macprovider 0640/0750` — the macprovider user no longer has
# write access there. ProtectSystem=strict + ReadOnlyPaths=/opt/macprovider
# remain as defense in depth (catches any future loosening of the
# deploy-script ownership posture). /var/lib/macprovider is still
# macprovider-owned so the daemon can write coordinator.db; the
# monitor's separate state lives under StateDirectory (mode 0700
# under /var/lib/macprovider-monitor, also macprovider-owned).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadOnlyPaths=/opt/macprovider
StateDirectory=macprovider-monitor
ReadWritePaths=/var/lib/macprovider-monitor
# Pulls OPERATOR_KEY (+ GATEWAY_SERVICE_TOKEN if set) from the same
# env-file the coordinator unit uses. "-" tolerates a missing file so
# alerts still land in journald before the operator drops a
# coordinator.env on disk; polling endpoints requiring auth will simply
# return 401 until it does.
EnvironmentFile=-/etc/macprovider/coordinator.env
# Optional monitor-specific overrides (ALERT_EMAIL / GMAIL_*).
EnvironmentFile=-/etc/macprovider/monitor.env
ExecStart=/usr/bin/python3 /opt/macprovider/monitor.py
