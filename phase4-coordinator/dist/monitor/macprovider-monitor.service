[Unit]
Description=Mac Provider observability monitor (Phase 7 P2)
After=network-online.target macprovider-coordinator.service
Documentation=https://github.com/Augustas11/macprovider/blob/main/specs/PHASE7_HARDENING_PLAN.md

[Service]
Type=oneshot
# De-rooted (M3-2 / DEVE-7). Runs as the same unprivileged user the
# coordinator runs as so monitor.py reads OPERATOR_KEY from the shared
# env-file instead of regexing /opt/macprovider/coordinator.yaml as root.
User=macprovider
Group=macprovider
Nice=10
# Sandbox (codex PR #73 HIGH-2). De-rooting alone (User=macprovider)
# does NOT take away write access to /opt/macprovider or
# /var/lib/macprovider (incl. coordinator.db), because the macprovider
# user owns those paths so it can read them. ProtectSystem=strict makes
# the entire filesystem read-only except for what's explicitly listed
# below, and ReadOnlyPaths=/opt/macprovider closes the last vector that
# could let monitor.py overwrite the coordinator binary or dist files
# even by accident. StateDirectory carves out a writable subpath under
# /var/lib that systemd creates (mode 0700, owned by macprovider) so
# the monitor can persist its own state without needing /var/lib/macprovider.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadOnlyPaths=/opt/macprovider
StateDirectory=macprovider-monitor
ReadWritePaths=/var/lib/macprovider-monitor
# Pulls OPERATOR_KEY (+ GATEWAY_SERVICE_TOKEN if set) from the same
# env-file the coordinator unit uses. "-" tolerates a missing file so
# alerts still land in journald before the operator drops a
# coordinator.env on disk; polling endpoints requiring auth will simply
# return 401 until it does.
EnvironmentFile=-/etc/macprovider/coordinator.env
# Optional monitor-specific overrides (ALERT_EMAIL / GMAIL_*).
EnvironmentFile=-/etc/macprovider/monitor.env
ExecStart=/usr/bin/python3 /opt/macprovider/monitor.py
