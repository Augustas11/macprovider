# Operator-owned hardware inventory for stats capacity enrichment.
#
# Copy to /etc/macprovider-stats/stats-hardware-inventory.yaml on Pearl and keep
# provider IDs aligned with /poolz. Values here are trusted capacity constants:
# do not derive them from provider-submitted claims.

chips:
  operator fixture chip:
    display_chip: "Operator Fixture"
    memory_bandwidth_gb_per_s: 120
    network_power_kw: 0.035
    gpu_cores: 10
    cpu_cores: 10

providers:
  mac:
    chip_normalized: operator fixture chip
    chip: "Operator Fixture"
    unified_memory_gb: 32
    macos_version: ""
    app_version: ""
    # The sidecar is allowed to write verified rows, so source must remain
    # operator; provider-reported sources are intentionally rejected.
    source: operator
    verified: true
