# Environment for macprovider-stats-inventory-sync.service.
#
# Use a dedicated Postgres role with ordinary inventory write privileges:
#   SELECT, INSERT, UPDATE, DELETE on chip_hardware_profiles
#   SELECT, INSERT, UPDATE on provider_hardware_profiles
# and read-only demotion proof privileges:
#   SELECT on hardware_verification_jobs
#   SELECT on hardware_verification_trust
#
# If this inventory file includes trusted_hardware, use a separate trust-root
# role with only:
#   SELECT, INSERT, UPDATE, DELETE on hardware_verification_trust
#
# Do not reuse STATS_ROLLUP_DSN, provider_onboarding credentials, or the
# ordinary inventory writer for trust-root writes.
# Install this file as /etc/macprovider-stats/stats-inventory-sync.env with
# root:root 0600. systemd reads EnvironmentFile before dropping to the
# dedicated macprovider-stats service user.
STATS_INVENTORY_DSN=postgres://stats_inventory_writer:REPLACE_ME@127.0.0.1:5432/macprovider?sslmode=disable
# Required only when trusted_hardware is present in the inventory YAML.
STATS_TRUST_INVENTORY_DSN=postgres://stats_trust_inventory_writer:REPLACE_ME@127.0.0.1:5432/macprovider?sslmode=disable
