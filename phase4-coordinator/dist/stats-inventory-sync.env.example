# Environment for macprovider-stats-inventory-sync.service.
#
# Use a dedicated Postgres role with only:
#   SELECT, INSERT, UPDATE, DELETE on chip_hardware_profiles
#   SELECT, INSERT, UPDATE on provider_hardware_profiles
#
# Do not reuse STATS_ROLLUP_DSN or provider_onboarding credentials here.
# Install this file as /etc/macprovider-stats/stats-inventory-sync.env with
# root:root 0600. systemd reads EnvironmentFile before dropping to the
# dedicated macprovider-stats service user.
STATS_INVENTORY_DSN=postgres://stats_inventory_writer:REPLACE_ME@127.0.0.1:5432/macprovider?sslmode=disable
