+			`"usage":{"prompt_tokens":2,"completion_tokens":3,"total_tokens":5},` +
+			`"choices":[{"index":0,"message":{"role":"assistant","content":` + strconv.Quote(large) + `},"finish_reason":"stop"}]}`
