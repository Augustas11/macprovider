+	}
+	if !strings.Contains(second.Body.String(), `"type":"error"`) || !strings.Contains(second.Body.String(), `"code":"duplicate_request_id"`) {
+		t.Fatalf("bodyless fallback did not use Anthropic error shape: %s", second.Body.String())
