{
  "$id": "https://malibu.tech/schemas/acceptance-candidate-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "candidate_ref": {
      "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9._/-]{0,252}[A-Za-z0-9._-]$|^refs/heads/[A-Za-z0-9]$",
      "type": "string"
    },
    "channel": {
      "const": "acceptance"
    },
    "checksums": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "checksums.txt"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256"
      ],
      "type": "object"
    },
    "compatibility_set_id": {
      "minLength": 1,
      "type": "string"
    },
    "control_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "run_attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "run_id": {
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "schema_version": {
      "const": "macprovider.acceptance-candidate.v1"
    },
    "signing": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ecdsa-p256-sha256"
        },
        "key_id": {
          "const": "macprovider-acceptance-p256-v1"
        }
      },
      "required": [
        "algorithm",
        "key_id"
      ],
      "type": "object"
    },
    "tag": {
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "candidate_commit",
    "candidate_ref",
    "channel",
    "checksums",
    "compatibility_set_id",
    "control_commit",
    "expires_at",
    "issued_at",
    "repository",
    "run_attempt",
    "run_id",
    "schema_version",
    "signing",
    "tag"
  ],
  "title": "macprovider private acceptance-candidate envelope",
  "type": "object"
}
