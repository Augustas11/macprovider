{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Augustas11/macprovider/schemas/compatibility-artifact-index-v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "additionalProperties": false,
      "properties": {
        "catalog_candidates": { "$ref": "#/$defs/artifact" },
        "catalog_candidates_signature": { "$ref": "#/$defs/artifact" },
        "catalog_demand": { "$ref": "#/$defs/artifact" },
        "catalog_demand_signature": { "$ref": "#/$defs/artifact" },
        "catalog_manifest": { "$ref": "#/$defs/artifact" },
        "catalog_trusted_keys": { "$ref": "#/$defs/artifact" },
        "compatibility_manifest": { "$ref": "#/$defs/artifact" },
        "coordinator": { "$ref": "#/$defs/artifact" },
        "coordinator_cli": { "$ref": "#/$defs/artifact" },
        "gateway": { "$ref": "#/$defs/artifact" },
        "malibu_app": { "$ref": "#/$defs/artifact" },
        "pearl_metadata": { "$ref": "#/$defs/artifact" },
        "pearl_metadata_signature": { "$ref": "#/$defs/artifact" },
        "provider_cli": { "$ref": "#/$defs/artifact" }
      },
      "required": [
        "catalog_candidates", "catalog_candidates_signature", "catalog_demand",
        "catalog_demand_signature", "catalog_manifest", "catalog_trusted_keys",
        "compatibility_manifest", "coordinator", "coordinator_cli", "gateway",
        "malibu_app", "pearl_metadata", "pearl_metadata_signature", "provider_cli"
      ],
      "type": "object"
    },
    "commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "compatibility_manifest_sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "compatibility_set_id": { "minLength": 1, "type": "string" },
    "repository": { "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "type": "string" },
    "schema_version": { "const": "macprovider.compatibility-artifact-index.v1" },
    "tag": { "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$", "type": "string" }
  },
  "required": [
    "artifacts", "commit", "compatibility_manifest_sha256", "compatibility_set_id",
    "repository", "schema_version", "tag"
  ],
  "type": "object",
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "name": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,255}$", "type": "string" },
        "sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" }
      },
      "required": ["name", "sha256"],
      "type": "object"
    }
  }
}
