{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Augustas11/macprovider/schemas/coordinator-source-export-request-v1.schema.json",
  "title": "MacProvider coordinator source export request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "challenge_nonce", "scopes"],
  "properties": {
    "schema_version": {"const": "macprovider.coordinator-source-export-request.v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "challenge_nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "description": "Private lookup inputs only. Raw buyer payload, model, pool, prompt, message, provenance, key, registry, source, freshness, or signature selectors are not admitted.",
      "items": {"$ref": "#/$defs/scope"}
    }
  },
  "$defs": {
    "private_lookup_id": {"type": "string", "pattern": "^[ -~]{1,128}$"},
    "internal_request_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "external_request_id", "required_internal_request_id", "not_before_unix_ms"],
      "properties": {
        "account_id": {"$ref": "#/$defs/private_lookup_id"},
        "external_request_id": {"$ref": "#/$defs/private_lookup_id"},
        "required_internal_request_id": {"$ref": "#/$defs/internal_request_id"},
        "not_before_unix_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    }
  }
}
