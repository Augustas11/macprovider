{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Augustas11/macprovider/schemas/gateway-source-export-request-v1.schema.json",
  "title": "MacProvider gateway refusal-intent export request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "challenge_nonce", "scopes"],
  "properties": {
    "schema_version": {"const": "macprovider.gateway-source-export-request.v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "challenge_nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "description": "The caller's private request intent. Used only to recompute the stored intent commitment and the signed binding (SPEC-006 §5.4.3.3); never persisted, logged or returned.",
      "items": {"$ref": "#/$defs/scope"}
    }
  },
  "$defs": {
    "private_lookup_id": {"type": "string", "pattern": "^[ -~]{1,128}$"},
    "private_intent": {"type": "string", "pattern": "^[ -~]{0,256}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "external_request_id", "model", "pool_select", "engine_select"],
      "properties": {
        "account_id": {"$ref": "#/$defs/private_lookup_id"},
        "external_request_id": {"$ref": "#/$defs/private_lookup_id"},
        "model": {"$ref": "#/$defs/private_intent"},
        "pool_select": {"$ref": "#/$defs/private_intent"},
        "engine_select": {"$ref": "#/$defs/private_intent"}
      }
    }
  }
}
