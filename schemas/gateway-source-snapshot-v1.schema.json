{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Augustas11/macprovider/schemas/gateway-source-snapshot-v1.schema.json",
  "title": "MacProvider gateway refusal-intent source snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer_contract_version", "registry_bundle_digest", "record_table_schema", "record_schema", "canonicalization", "intent_hmac", "scope_binding"],
  "properties": {
    "schema_version": {"const": "macprovider.gateway-source-snapshot.v1"},
    "producer_contract_version": {"const": "gateway-refusal-intent-v1"},
    "registry_bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "sha256 of the canonical ASCII/JCS-subset source-evidence key registry bytes actually used by the verifier."
    },
    "record_table_schema": {"const": "gateway_refusal_records.v1"},
    "record_schema": {"const": "macprovider.gateway-refusal-record.v1"},
    "canonicalization": {"const": "ascii-jcs-subset-v1"},
    "intent_hmac": {"const": "hmac-sha256-length-prefixed-v1"},
    "scope_binding": {"const": "sha256-run-nonce-length-prefixed-v1"}
  }
}
