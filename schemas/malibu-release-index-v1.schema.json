{
  "$defs": {
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "timestamp": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"}
  },
  "$id": "https://download.malibu.tech/schemas/malibu-release-index-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "malibu-release-index.v1"},
    "signature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "ecdsa-p256-sha256"},
        "key_id": {"pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "type": "string"},
        "signature": {"minLength": 1, "pattern": "^[A-Za-z0-9_-]+$", "type": "string"}
      },
      "required": ["algorithm", "key_id", "signature"],
      "type": "object"
    },
    "signed": {
      "additionalProperties": false,
      "properties": {
        "channel": {"const": "stable"},
        "envelope": {
          "additionalProperties": false,
          "properties": {
            "build": {"minimum": 1, "type": "integer"},
            "generation": {"minimum": 1, "type": "integer"},
            "name": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,255}$", "type": "string"},
            "sha256": {"$ref": "#/$defs/sha256"}
          },
          "required": ["build", "generation", "name", "sha256"],
          "type": "object"
        },
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "index_generation": {"minimum": 1, "type": "integer"},
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "minimum_accepted_envelope_generation": {"minimum": 1, "type": "integer"},
        "trust": {
          "additionalProperties": false,
          "properties": {
            "keyring_generation": {"minimum": 1, "type": "integer"},
            "keyring_sha256": {"$ref": "#/$defs/sha256"},
            "revocations_generation": {"minimum": 1, "type": "integer"},
            "revocations_sha256": {"$ref": "#/$defs/sha256"}
          },
          "required": ["keyring_generation", "keyring_sha256", "revocations_generation", "revocations_sha256"],
          "type": "object"
        }
      },
      "required": ["channel", "envelope", "expires_at", "index_generation", "issued_at", "minimum_accepted_envelope_generation", "trust"],
      "type": "object"
    }
  },
  "required": ["schema_version", "signature", "signed"],
  "type": "object"
}
