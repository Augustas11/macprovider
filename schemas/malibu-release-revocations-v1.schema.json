{
  "$id": "https://download.malibu.tech/schemas/malibu-release-revocations-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generation": {"minimum": 1, "type": "integer"},
    "issued_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
    "keyring_generation": {"minimum": 1, "type": "integer"},
    "revoked_key_ids": {
      "items": {"pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "type": "string"},
      "type": "array",
      "uniqueItems": true
    },
    "revoked_keyring_generations": {
      "items": {"minimum": 1, "type": "integer"},
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {"const": "malibu-release-revocations.v1"}
  },
  "required": ["generation", "issued_at", "keyring_generation", "revoked_key_ids", "revoked_keyring_generations", "schema_version"],
  "type": "object"
}
