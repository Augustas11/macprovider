{
  "$id": "https://download.malibu.tech/schemas/malibu-release-rollback-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "signature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "ecdsa-p256-sha256"},
        "key_id": {"pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "type": "string"},
        "signature": {"minLength": 1, "pattern": "^[A-Za-z0-9_-]+$", "type": "string"}
      },
      "required": ["algorithm", "key_id", "signature"],
      "type": "object"
    },
    "state": {
      "additionalProperties": false,
      "properties": {
        "build": {"minimum": 1, "type": "integer"},
        "envelope_generation": {"minimum": 1, "type": "integer"},
        "envelope_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "index_generation": {"minimum": 1, "type": "integer"}
      },
      "required": ["build", "envelope_generation", "envelope_sha256", "index_generation"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "malibu-release-rollback.v1"},
    "signature": {"$ref": "#/$defs/signature"},
    "signed": {
      "additionalProperties": false,
      "properties": {
        "current": {"$ref": "#/$defs/state"},
        "expires_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
        "incident": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$", "type": "string"},
        "issued_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
        "issuer": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._@:/-]{2,127}$", "type": "string"},
        "nonce": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "target": {"$ref": "#/$defs/state"}
      },
      "required": ["current", "expires_at", "incident", "issued_at", "issuer", "nonce", "target"],
      "type": "object"
    }
  },
  "required": ["schema_version", "signature", "signed"],
  "type": "object"
}
