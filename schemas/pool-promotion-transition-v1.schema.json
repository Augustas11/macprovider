{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Augustas11/macprovider/schemas/pool-promotion-transition-v1.schema.json",
  "title": "SPEC-043 PoolPromotionTransitionV1 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signatures", "signed"],
  "properties": {
    "schema_version": {"const": "macprovider.pool-promotion-transition-envelope.v1"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/signature"}
    },
    "signed": {"$ref": "#/$defs/signed"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature", "signed_sha256", "verified_at", "verifier"],
      "properties": {
        "algorithm": {"const": "ecdsa-p256-sha256"},
        "key_id": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
        "signed_sha256": {"$ref": "#/$defs/sha256"},
        "verified_at": {"$ref": "#/$defs/utc"},
        "verifier": {"type": "string", "minLength": 1}
      }
    },
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "journey_id",
        "run_id",
        "journey_result_digest",
        "candidate_environment_id",
        "live_activation_target",
        "pool_id",
        "environment_id",
        "environment_class",
        "coordinator_build_id",
        "gateway_build_id",
        "provider_build_id",
        "schema_migration_hash",
        "effective_config_digest",
        "feature_flag_digest",
        "governance_file_digest",
        "approval_record_id",
        "approval_record_version",
        "creator_agreement_id",
        "creator_agreement_version",
        "creator_agreement_expires_at",
        "creator_agreement_grace_ends_at",
        "pricing_schedule_id",
        "pricing_schedule_version",
        "reviewed_distribution_artifact_digest",
        "root_issuer_fingerprint",
        "gate_check_id",
        "routeable_snapshot_digest",
        "pool_generation",
        "transition_epoch",
        "authorization_id",
        "verifier_challenge",
        "authorized_actor",
        "credential_id",
        "rbac_role",
        "authorized_at",
        "expiry",
        "target_lifecycle_transition"
      ],
      "properties": {
        "schema_version": {"const": "spec-043-promotion-auth-v1"},
        "journey_id": {"const": "JOURNEY-TRUSTED-POOL-CREATOR-MVP"},
        "run_id": {"type": "integer", "minimum": 1},
        "journey_result_digest": {"$ref": "#/$defs/sha256"},
        "candidate_environment_id": {"type": "string", "minLength": 1},
        "live_activation_target": {"type": "string", "minLength": 1},
        "pool_id": {"type": "string", "minLength": 1},
        "environment_id": {"type": "string", "minLength": 1},
        "environment_class": {"const": "production"},
        "coordinator_build_id": {"type": "string", "minLength": 1},
        "gateway_build_id": {"type": "string", "minLength": 1},
        "provider_build_id": {"type": "string", "minLength": 1},
        "schema_migration_hash": {"$ref": "#/$defs/sha256"},
        "effective_config_digest": {"$ref": "#/$defs/sha256"},
        "feature_flag_digest": {"$ref": "#/$defs/sha256"},
        "governance_file_digest": {"$ref": "#/$defs/sha256"},
        "approval_record_id": {"type": "string", "minLength": 1},
        "approval_record_version": {"type": "integer", "minimum": 1},
        "creator_agreement_id": {"type": "string", "minLength": 1},
        "creator_agreement_version": {"type": "integer", "minimum": 1},
        "creator_agreement_expires_at": {"$ref": "#/$defs/utc"},
        "creator_agreement_grace_ends_at": {"$ref": "#/$defs/utc"},
        "pricing_schedule_id": {"type": "string", "minLength": 1},
        "pricing_schedule_version": {"type": "integer", "minimum": 1},
        "reviewed_distribution_artifact_digest": {"$ref": "#/$defs/sha256"},
        "root_issuer_fingerprint": {"$ref": "#/$defs/sha256"},
        "gate_check_id": {"type": "string", "minLength": 1},
        "routeable_snapshot_digest": {"$ref": "#/$defs/sha256"},
        "pool_generation": {"type": "integer", "minimum": 1},
        "transition_epoch": {"type": "integer", "minimum": 1},
        "authorization_id": {"type": "string", "minLength": 1},
        "verifier_challenge": {"type": "string", "minLength": 1},
        "authorized_actor": {"type": "string", "minLength": 1},
        "credential_id": {"type": "string", "minLength": 1},
        "rbac_role": {"const": "production-release-approver"},
        "authorized_at": {"$ref": "#/$defs/utc"},
        "expiry": {"$ref": "#/$defs/utc"},
        "target_lifecycle_transition": {"const": "active"}
      }
    }
  }
}
