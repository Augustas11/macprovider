{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Augustas11/macprovider/schemas/provider-pool-delegation-v1.schema.json",
  "title": "SPEC-043 ProviderPoolDelegationV1 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signatures", "signed"],
  "properties": {
    "schema_version": {"const": "macprovider.provider-pool-delegation-envelope.v1"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/signature"}
    },
    "signed": {
      "oneOf": [
        {"$ref": "#/$defs/delegation_signed"},
        {"$ref": "#/$defs/revocation_signed"}
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature", "signed_sha256"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
        "signed_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "delegation_signed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "creator_account_id",
        "pool_id",
        "provider_identity",
        "delegation_id",
        "operation_id",
        "manifest_core_digest",
        "environment_network_id",
        "coordinator_audience",
        "provider_owner_key_id",
        "provider_owner_key_version",
        "provider_owner_public_key",
        "issued_at",
        "expires_at",
        "revocation_semantics"
      ],
      "properties": {
        "schema_version": {"const": "provider-pool-delegation-v1"},
        "creator_account_id": {"type": "string", "minLength": 1},
        "pool_id": {"type": "string", "minLength": 1},
        "provider_identity": {"type": "string", "minLength": 1},
        "delegation_id": {"type": "string", "minLength": 1},
        "operation_id": {"type": "string", "minLength": 1},
        "manifest_core_digest": {"$ref": "#/$defs/sha256"},
        "environment_network_id": {"type": "string", "minLength": 1},
        "coordinator_audience": {"type": "string", "minLength": 1},
        "provider_owner_key_id": {"type": "string", "minLength": 1},
        "provider_owner_key_version": {"type": "string", "minLength": 1},
        "provider_owner_public_key": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
        "issued_at": {"$ref": "#/$defs/utc"},
        "expires_at": {"$ref": "#/$defs/utc"},
        "revocation_semantics": {"const": "owner_revocable"}
      }
    },
    "revocation_signed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "creator_account_id",
        "pool_id",
        "provider_identity",
        "delegation_id",
        "operation_id",
        "manifest_core_digest",
        "environment_network_id",
        "coordinator_audience",
        "provider_owner_key_id",
        "provider_owner_key_version",
        "revoked_at",
        "revocation_semantics"
      ],
      "properties": {
        "schema_version": {"const": "provider-pool-delegation-revocation-v1"},
        "creator_account_id": {"type": "string", "minLength": 1},
        "pool_id": {"type": "string", "minLength": 1},
        "provider_identity": {"type": "string", "minLength": 1},
        "delegation_id": {"type": "string", "minLength": 1},
        "operation_id": {"type": "string", "minLength": 1},
        "manifest_core_digest": {"$ref": "#/$defs/sha256"},
        "environment_network_id": {"type": "string", "minLength": 1},
        "coordinator_audience": {"type": "string", "minLength": 1},
        "provider_owner_key_id": {"type": "string", "minLength": 1},
        "provider_owner_key_version": {"type": "string", "minLength": 1},
        "revoked_at": {"$ref": "#/$defs/utc"},
        "revocation_semantics": {"const": "owner_revocable"}
      }
    }
  }
}
