        "",
        "```python",
        "from dataclasses import dataclass",
        "from typing import Sequence",
        "",
        "@dataclass(frozen=True)",
        "class Page:",
        "    items: list",
        "    next_cursor: int | None",
        "",
        "def paginate(rows: Sequence[dict], cursor: int | None, page_size: int) -> Page:",
        "    if page_size <= 0:",
        "        raise ValueError(\"page_size must be positive\")",
        "    start = 0 if cursor is None else cursor",
        "    end = start + page_size",
        "    items = list(rows[start:end + 1])",
        "    next_cursor = end if end < len(rows) - 1 else None",
        "    return Page(items=items[:page_size], next_cursor=next_cursor - 1 if next_cursor else None)",
        "```",
