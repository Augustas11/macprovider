      "case_id": "write-tests-token-bucket-limiter",
      "category": "tests",
      "language": "python",
      "max_tokens": 1536,
      "min_completion_tokens": 768,
      "user_lines": [
        "Write a complete pytest suite for this rate limiter. Cover refill math, burst capacity, fractional",
        "refill, clock going backwards, zero and negative cost, concurrent acquire from threads, and the",
        "retry_after value. Use an injected fake clock; no sleeps. Output one runnable test file.",
        "",
        "```python",
        "import threading",
        "import time",
        "from typing import Callable",
        "",
        "",
        "class TokenBucket:",
        "    def __init__(self, rate_per_sec: float, capacity: float, clock: Callable[[], float] = time.monotonic):",
        "        if rate_per_sec <= 0 or capacity <= 0:",
        "            raise ValueError(\"rate and capacity must be positive\")",
        "        self._rate = rate_per_sec",
        "        self._capacity = capacity",
        "        self._tokens = capacity",
        "        self._clock = clock",
        "        self._last = clock()",
        "        self._lock = threading.Lock()",
        "",
        "    def _refill(self) -> None:",
        "        now = self._clock()",
        "        elapsed = max(0.0, now - self._last)",
        "        self._last = max(self._last, now)",
        "        self._tokens = min(self._capacity, self._tokens + elapsed * self._rate)",
        "",
        "    def try_acquire(self, cost: float = 1.0) -> tuple[bool, float]:",
        "        \"\"\"Return (allowed, retry_after_seconds).\"\"\"",
        "        if cost <= 0:",
        "            raise ValueError(\"cost must be positive\")",
        "        if cost > self._capacity:",
        "            return False, float(\"inf\")",
        "        with self._lock:",
        "            self._refill()",
        "            if self._tokens >= cost:",
        "                self._tokens -= cost",
        "                return True, 0.0",
        "            return False, (cost - self._tokens) / self._rate",
        "",
        "    @property",
        "    def available(self) -> float:",
        "        with self._lock:",
        "            self._refill()",
        "            return self._tokens",
        "```"
      ],
