# #1690 e2e fake provider %i (test scaffolding, never production). Native
# catalog provider with SPEC-015 v0.4 settlement receipts; response shape from
# /root/e2e/fakeprov-%i.env (FAKEPROV_ARGS).
[Unit]
Description=E2E fake provider %i
After=network-online.target

[Service]
Type=simple
Environment=FAKEPROV_ARGS=
EnvironmentFile=-/root/e2e/fakeprov-%i.env
ExecStart=/bin/sh -c 'exec /opt/macprovider/e2e-fakeprov -coord-ws ws://127.0.0.1:8444/ws/provider -provider-id e2e-prov-%i -token-file /root/e2e/token-e2e-prov-%i -http-listen 127.0.0.1:1910%i -catalog-from-coordinator http://127.0.0.1:8443 -settlement $FAKEPROV_ARGS'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
