#!/usr/bin/env bash
# #1690 e2e DNS shim: the fake Pearl answers for the production API names.
# deploy-pearl-vps.sh only runs `dig +short $DOMAIN | grep -q $VPS_HOST`.
for a in "$@"; do
  case "$a" in
    api.malibu.tech|coordinator.malibu.tech|stats.malibu.tech) echo 127.0.0.1; exit 0 ;;
  esac
done
echo "dig shim: refusing lookup outside the e2e world: $*" >&2
exit 9
