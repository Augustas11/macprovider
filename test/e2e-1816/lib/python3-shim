#!/bin/bash
# e2e-1816: python3 as the Pearl updater sees it (first on its PATH). Only a
# `catalog-release.py verify-directory` call whose exact inputs the harness
# already verified with the real verifier is answered from that record
# (tools/verify-cache.py explains why); everything else is the real python3.
REAL=/usr/bin/python3
case " $* " in
  *catalog-release.py*verify-directory*)
    k="$($REAL /root/e2e/h16/tools/verify-cache.py key "$@" 2>/dev/null)" || exec $REAL "$@"
    c=/root/e2e/verify-cache/$k
    if [ -n "$k" ] && [ -f "$c.out" ]; then cat "$c.out"; cat "$c.err" >&2; echo "e2e-verify-cache hit $k" >>/root/e2e/logs/verify-cache.log; exit 0; fi
    echo "e2e-verify-cache miss $k" >>/root/e2e/logs/verify-cache.log ;;
esac
exec $REAL "$@"
