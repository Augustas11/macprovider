# env.harness.example — template for network-harness runs.
#
# Copy to test/network-harness/.env.harness (gitignored) and fill in real
# values. The wrapper test/network-harness/run-scenario.sh sources it for
# buyer-fleet scenarios only, builds the harness binary, and runs.

# Live buyer bearer token. When unset, run-scenario.sh reads
# ~/.config/macprovider/buyer-api-key.
BUYER_TOKEN=
